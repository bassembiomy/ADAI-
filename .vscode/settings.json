{
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss",
    "*.c": "cpp",
    "*.h": "cpp",
    "*.m": "matlab"
  },
  "files.watcherExclude": {
    "**/out/**": true,
    "**/*.asar": true,
    "**/dist-package/**": true
  },
  "search.exclude": {
    "**/out/**": true,
    "**/*.asar": true,
    "**/dist-package/**": true
  }
}

  {
    "content": "#ifndef SM_MAPPING_H
#define SM_MAPPING_H

#include "sm_config.h"

extern SM_ROM SM_Rom_Index_t SM_State_Parent_Layer_Map[SM_NUM_STATES + 1U];
extern SM_ROM SM_Rom_Index_t SM_State_Active_Slot_Map[SM_NUM_STATES + 1U];
extern SM_ROM SM_Rom_Index_t SM_Layer_Parent_State_Map[SM_NUM_LAYERS];
extern SM_ROM SM_Rom_Index_t SM_Layer_Active_Slot_Map[SM_NUM_LAYERS];

SM_Error_t SM_Validate_Mapping_Configuration(void);

#endif /* SM_MAPPING_H */
",
    "name": "sm_mapping.h",
  },
  {
    "content": "#include "sm_mapping.h"

/*
 * Active State Mapping
 *
 * Layer | Slot
 * ------------------------------
 * root | 0
 *
 * Parallel child states are tracked using state_active[].
 * Layer IDs, active-slot IDs, and state IDs are distinct.
 */
SM_ROM SM_Rom_Index_t SM_State_Parent_Layer_Map[SM_NUM_STATES + 1U] = {
    [0] = 0U,
    [SM_ST_S1_IDX] = SM_LYR_ROOT_IDX,
    [SM_ST_S2_IDX] = SM_LYR_ROOT_IDX,
};

SM_ROM SM_Rom_Index_t SM_State_Active_Slot_Map[SM_NUM_STATES + 1U] = {
    [0] = SM_ROM_INDEX_NONE,
    [SM_ST_S1_IDX] = 0U,
    [SM_ST_S2_IDX] = 0U,
};

SM_ROM SM_Rom_Index_t SM_Layer_Parent_State_Map[SM_NUM_LAYERS] = {
    [SM_LYR_ROOT_IDX] = 0U,
};

SM_ROM SM_Rom_Index_t SM_Layer_Active_Slot_Map[SM_NUM_LAYERS] = {
    [SM_LYR_ROOT_IDX] = 0U,
};

SM_Error_t SM_Validate_Mapping_Configuration(void)
{
    uint32_t layer_index;
    uint32_t state_index;
    uint32_t slot;
    for (layer_index = 0U; layer_index < SM_NUM_LAYERS; ++layer_index) {
        uint32_t parent_state;
        slot = (uint32_t)SM_ROM_READ_INDEX(SM_Layer_Active_Slot_Map[layer_index]);
        if ((slot != SM_ROM_INDEX_NONE) && (slot >= SM_NUM_ACTIVE_SLOTS)) {
            return SM_ERR_CONFIGURATION;
        }
        parent_state = (uint32_t)SM_ROM_READ_INDEX(SM_Layer_Parent_State_Map[layer_index]);
        if (parent_state > SM_NUM_STATES) {
            return SM_ERR_CONFIGURATION;
        }
    }
    for (state_index = 1U; state_index <= SM_NUM_STATES; ++state_index) {
        uint32_t parent_layer;
        uint32_t layer_slot;
        parent_layer = (uint32_t)SM_ROM_READ_INDEX(SM_State_Parent_Layer_Map[state_index]);
        if (parent_layer >= SM_NUM_LAYERS) {
            return SM_ERR_CONFIGURATION;
        }
        slot = (uint32_t)SM_ROM_READ_INDEX(SM_State_Active_Slot_Map[state_index]);
        if ((slot != SM_ROM_INDEX_NONE) && (slot >= SM_NUM_ACTIVE_SLOTS)) {
            return SM_ERR_CONFIGURATION;
        }
        layer_slot = (uint32_t)SM_ROM_READ_INDEX(SM_Layer_Active_Slot_Map[parent_layer]);
        if (slot != layer_slot) {
            return SM_ERR_CONFIGURATION;
        }
    }
    return SM_ERR_NONE;
}
",
    "name": "sm_mapping.c",
  },
  {
    "content": "#ifndef SM_CORE_H
#define SM_CORE_H

#include "sm_config.h"

#include <float.h>
#include <math.h>

#if defined(__STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)
#define SM_ARITH_INLINE static inline
#elif defined(__GNUC__)
#define SM_ARITH_INLINE static __inline__
#else
#define SM_ARITH_INLINE static
#endif

/* Latches the arithmetic error; the first error of the tick wins. */
SM_ARITH_INLINE void SM_ArithLatch(ADIA_Instance_t *instance)
{
    if (instance->error_status == SM_ERR_NONE) {
        instance->error_status = SM_ERR_ARITHMETIC;
    }
}

SM_ARITH_INLINE void SM_ArithFault(ADIA_Instance_t *instance)
{
    SM_ArithLatch(instance);
    instance->arith_pending = true;
}

/* Returns true when no arithmetic error occurred since the last consumption. */
SM_ARITH_INLINE bool SM_ArithTake(ADIA_Instance_t *instance)
{
    const bool clean = !instance->arith_pending;
    instance->arith_pending = false;
    return clean;
}

SM_ARITH_INLINE bool SM_GuardOk(ADIA_Instance_t *instance, bool value)
{
    const bool clean = SM_ArithTake(instance);
    return clean && value;
}

SM_ARITH_INLINE double SM_ChkD(ADIA_Instance_t *instance, double value)
{
    if ((value - value) != 0.0) {
        SM_ArithFault(instance);
        return 0.0;
    }
    return value;
}

SM_ARITH_INLINE double SM_DivD(ADIA_Instance_t *instance, double a, double b)
{
    if (b == 0.0) {
        SM_ArithFault(instance);
        return 0.0;
    }
    return SM_ChkD(instance, a / b);
}

SM_ARITH_INLINE double SM_RemD(ADIA_Instance_t *instance, double a, double b)
{
    if (b == 0.0) {
        SM_ArithFault(instance);
        return 0.0;
    }
    return SM_ChkD(instance, fmod(a, b));
}

SM_ARITH_INLINE bool SM_StoreBool(ADIA_Instance_t *instance, bool value, bool *out)
{
    if (!SM_ArithTake(instance)) {
        return false;
    }
    *out = value;
    return true;
}

SM_ARITH_INLINE bool SM_StoreDouble(ADIA_Instance_t *instance, double value, double *out)
{
    if (!SM_ArithTake(instance)) {
        return false;
    }
    if ((value - value) != 0.0) {
        SM_ArithLatch(instance);
        return false;
    }
    *out = value;
    return true;
}

/* float/single saturate to +-FLT_MAX (or fail under overflow policy error). */
SM_ARITH_INLINE bool SM_StoreFloat(ADIA_Instance_t *instance, double value, bool error_on_overflow, float *out)
{
    double stored = value;
    if (!SM_ArithTake(instance)) {
        return false;
    }
    if ((value - value) != 0.0) {
        SM_ArithLatch(instance);
        return false;
    }
    if ((value > (double)FLT_MAX) || (value < -(double)FLT_MAX)) {
        if (error_on_overflow) {
            SM_ArithLatch(instance);
            return false;
        }
        stored = (value < 0.0) ? -(double)FLT_MAX : (double)FLT_MAX;
    }
    *out = (float)stored;
    return true;
}

/* INT64_MIN spelled without a constant that MISRA 7.2/10.4 tools misread. */
#define SM_I64_MIN ((int64_t)(-INT64_MAX - (int64_t)1))

/* Integer expressions: signed 64-bit intermediates that saturate and never wrap. */
SM_ARITH_INLINE int64_t SM_AddI64(int64_t a, int64_t b)
{
    if ((b > 0) && (a > (INT64_MAX - b))) {
        return INT64_MAX;
    }
    if ((b < 0) && (a < (SM_I64_MIN - b))) {
        return SM_I64_MIN;
    }
    return a + b;
}

SM_ARITH_INLINE int64_t SM_SubI64(int64_t a, int64_t b)
{
    if ((b < 0) && (a > (INT64_MAX + b))) {
        return INT64_MAX;
    }
    if ((b > 0) && (a < (SM_I64_MIN + b))) {
        return SM_I64_MIN;
    }
    return a - b;
}

SM_ARITH_INLINE int64_t SM_MulI64(int64_t a, int64_t b)
{
    bool overflow_high = false;
    bool overflow_low = false;
    if ((a == 0) || (b == 0)) {
        /* The product is zero. */
    } else if (a > 0) {
        if (b > 0) {
            overflow_high = (a > (INT64_MAX / b));
        } else {
            overflow_low = (b < (SM_I64_MIN / a));
        }
    } else if (b > 0) {
        overflow_low = (a < (SM_I64_MIN / b));
    } else {
        overflow_high = (a < (INT64_MAX / b));
    }
    if (overflow_high) {
        return INT64_MAX;
    }
    if (overflow_low) {
        return SM_I64_MIN;
    }
    return a * b;
}

SM_ARITH_INLINE int64_t SM_NegI64(int64_t a)
{
    return SM_SubI64(0, a);
}

SM_ARITH_INLINE int64_t SM_AbsI64(int64_t a)
{
    return (a < 0) ? SM_NegI64(a) : a;
}

SM_ARITH_INLINE int64_t SM_DivI64(ADIA_Instance_t *instance, int64_t a, int64_t b)
{
    if (b == 0) {
        SM_ArithFault(instance);
        return 0;
    }
    if ((a == SM_I64_MIN) && (b == -1)) {
        return INT64_MAX;
    }
    return a / b;
}

SM_ARITH_INLINE int64_t SM_RemI64(ADIA_Instance_t *instance, int64_t a, int64_t b)
{
    if (b == 0) {
        SM_ArithFault(instance);
        return 0;
    }
    if (b == -1) {
        return 0;
    }
    return a % b;
}

/* An unsigned 64-bit variable read as an int64 operand saturates at INT64_MAX. */
SM_ARITH_INLINE int64_t SM_U64ToI64(uint64_t value)
{
    return (value > (uint64_t)INT64_MAX) ? INT64_MAX : (int64_t)value;
}

/* Converts to the target range: saturates, or fails under overflow policy error. */
SM_ARITH_INLINE bool SM_StoreI64(ADIA_Instance_t *instance, int64_t value, int64_t lo, int64_t hi, bool error_on_overflow, int64_t *out)
{
    int64_t stored = value;
    if (!SM_ArithTake(instance)) {
        return false;
    }
    if ((value < lo) || (value > hi)) {
        if (error_on_overflow) {
            SM_ArithLatch(instance);
            return false;
        }
        stored = (value < lo) ? lo : hi;
    }
    *out = stored;
    return true;
}

/* Floating to integer: truncates toward zero, then as SM_StoreI64. */
SM_ARITH_INLINE bool SM_StoreDoubleToI64(ADIA_Instance_t *instance, double value, int64_t lo, int64_t hi, bool error_on_overflow, int64_t *out)
{
    int64_t wide;
    bool beyond = false;
    if (!SM_ArithTake(instance)) {
        return false;
    }
    if ((value - value) != 0.0) {
        SM_ArithLatch(instance);
        return false;
    }
    if (value >= 9223372036854775808.0) {
        wide = INT64_MAX;
        beyond = true;
    } else if (value < -9223372036854775808.0) {
        wide = SM_I64_MIN;
        beyond = true;
    } else {
        wide = (int64_t)value;
    }
    if (beyond || (wide < lo) || (wide > hi)) {
        if (error_on_overflow) {
            SM_ArithLatch(instance);
            return false;
        }
        wide = (wide < lo) ? lo : ((wide > hi) ? hi : wide);
    }
    *out = wide;
    return true;
}


SM_Error_t SM_Init(ADIA_Instance_t *instance);
SM_Error_t SM_Reset(ADIA_Instance_t *instance);
SM_Error_t SM_ReadInputs(ADIA_Instance_t *instance);
SM_Error_t SM_Step(ADIA_Instance_t *instance, uint32_t delta_ms);
SM_Error_t SM_WriteOutputs(ADIA_Instance_t *instance);

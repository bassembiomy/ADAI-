/**
 * @brief Returns the active state node of the specified region group.
 * @param instance Pointer to state machine context
 * @param g        Region group index
 * @return SM_Node_t The currently active state
 */
SM_Node_t SM_GetActive(const ADIA_Instance_t* instance, SM_Group_t g) {
    SM_Node_t active = SM_NODE_INVALID;
    if (instance == NULL) {
        return active;
    }
    switch (g) {
        case SM_GRP_MAIN:
            active = instance->active_states[0U];
            break;
        default:
            break;
    }
    return active;
}

/**
 * @brief Queries the error status of the state machine.
 * @param instance Pointer to state machine context
 * @return SM_Error_t Current error status
 */
SM_Error_t SM_GetError(const ADIA_Instance_t* instance) {
    if (instance == NULL) {
        return SM_ERR_NONE;
    }
    return instance->error_status;
}

/**
 * @brief Initializes the state machine context and registers default/initial values.
 * @param instance Pointer to state machine context
 */
void SM_Init(ADIA_Instance_t* instance) {
    uint32_t sm_iter;  /* MISRA 8.7: declared at top of function */
    if (instance == NULL) {
        return;
    }
    for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
        instance->active_states[sm_iter]  = SM_NODE_INVALID;
        instance->history_states[sm_iter] = SM_NODE_INVALID;
    }
    for (sm_iter = 0U; sm_iter <= SM_NUM_STATES; sm_iter++) {
        instance->state_timers[sm_iter] = 0U;
        instance->state_active[sm_iter] = false;
    }
    instance->data.log = 0U;
    instance->data.t1 = false;
    instance->data.t2 = false;
    instance->state_timer = 0U;
    instance->error_status = SM_ERR_NONE;
    SM_Reset(instance);
}

/**
 * @brief Resets the state machine, fully reinitializing all runtime arrays.
 * @param instance Pointer to state machine context
 */
void SM_Reset(ADIA_Instance_t* instance) {
    uint32_t sm_iter;  /* MISRA 8.7: declared at top of function */
    if (instance == NULL) {
        return;
    }
    for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
        instance->active_states[sm_iter] = SM_NODE_INVALID;
        instance->history_states[sm_iter] = SM_NODE_INVALID;
    }
    for (sm_iter = 0U; sm_iter <= SM_NUM_STATES; sm_iter++) {
        instance->state_timers[sm_iter] = 0U;
        instance->state_active[sm_iter] = false;
    }
    instance->error_status = SM_ERR_NONE;
    SM_Enter_Layer_0(instance, false);
}

/**
 * @brief Steps the state machine: runs safety checks (if SM_SAFETY_ENABLED is defined), increments timers, and processes transitions.
 * @param instance Pointer to state machine context
 * @param delta_ms Execution tick period in milliseconds
 */
void SM_Step(ADIA_Instance_t* instance, uint32_t delta_ms) {
    uint32_t sm_iter;  /* MISRA 8.7: All loop variables declared at top of function */
    if (instance == NULL) {
        return;
    }

    /* If the state machine has already transitioned to a safe or error state, halt execution immediately */
#ifdef SM_SAFETY_ENABLED
    if ((instance->active_states[0U] == SM_NODE_SAFE) || (instance->active_states[0U] == SM_NODE_ERROR)) {
        return;
    }
#else
    if (instance->active_states[0U] == SM_NODE_ERROR) {
        return;
    }
#endif

    /* If an error was injected/detected but we haven't entered the safe/error state yet, trigger immediate halt/transition */
    if (instance->error_status != SM_ERR_NONE) {
#ifdef SM_SAFETY_ENABLED
        /* Exit all currently active states (runs exit actions, clears timers) */
        for (sm_iter = 1U; sm_iter <= SM_NUM_STATES; sm_iter++) {
            if (instance->state_active[sm_iter]) {
                SM_Exit_State(instance, (SM_Node_t)sm_iter);
            }
        }
        for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
            if ((instance->error_status == SM_ERR_SAFETY_VIOLATION) ||
                (instance->error_status == SM_ERR_RAM_INTEGRITY)    ||
                (instance->error_status == SM_ERR_ROM_INTEGRITY))   {
                instance->active_states[sm_iter] = SM_NODE_SAFE;
            } else {
                instance->active_states[sm_iter] = SM_NODE_ERROR;
            }
        }
        if ((instance->error_status == SM_ERR_SAFETY_VIOLATION) ||
            (instance->error_status == SM_ERR_RAM_INTEGRITY)    ||
            (instance->error_status == SM_ERR_ROM_INTEGRITY))   {
            /* Enter designated safe state */
            SM_Enter_State(instance, SM_NODE_SAFE, false);
        }
#else
        for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
            instance->active_states[sm_iter] = SM_NODE_ERROR;
        }
#endif
        return;
    }

    /* Validate execution time delta against timing contract (SM_TICK_MS) with overflow-safe tolerance check */
    bool tick_out_of_tolerance = false;
    if ((delta_ms > SM_TICK_MS) && ((delta_ms - SM_TICK_MS) > SM_TICK_TOLERANCE)) {
        tick_out_of_tolerance = true;
    } else if ((delta_ms < SM_TICK_MS) && ((SM_TICK_MS - delta_ms) > SM_TICK_TOLERANCE)) {
        tick_out_of_tolerance = true;
    }

    if (tick_out_of_tolerance) {
        instance->error_status = SM_ERR_SAFETY_VIOLATION;
#ifdef SM_SAFETY_ENABLED
        /* Exit all currently active states */
        for (sm_iter = 1U; sm_iter <= SM_NUM_STATES; sm_iter++) {
            if (instance->state_active[sm_iter]) {
                SM_Exit_State(instance, (SM_Node_t)sm_iter);
            }
        }
        for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
            instance->active_states[sm_iter] = SM_NODE_SAFE;
        }
        /* Enter designated safe state */
        SM_Enter_State(instance, SM_NODE_SAFE, false);
#else
        for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
            instance->active_states[sm_iter] = SM_NODE_ERROR;
        }
#endif
        return;
    }

#ifdef SM_SAFETY_ENABLED
    SM_Watchdog_Kick(instance);
    SM_Safety_Check(instance);
    if (instance->error_status == SM_ERR_NONE) {
        instance->error_status = SM_Validate_State_Consistency(instance);
    }
    if (instance->error_status != SM_ERR_NONE) {
        /* Exit all currently active states (runs exit actions, clears timers) */
        for (sm_iter = 1U; sm_iter <= SM_NUM_STATES; sm_iter++) {
            if (instance->state_active[sm_iter]) {
                SM_Exit_State(instance, (SM_Node_t)sm_iter);
            }
        }
        for (sm_iter = 0U; sm_iter < SM_NUM_LAYERS; sm_iter++) {
            if ((instance->error_status == SM_ERR_SAFETY_VIOLATION) ||
                (instance->error_status == SM_ERR_RAM_INTEGRITY)    ||
                (instance->error_status == SM_ERR_ROM_INTEGRITY))   {
                instance->active_states[sm_iter] = SM_NODE_SAFE;
            } else {
                instance->active_states[sm_iter] = SM_NODE_ERROR;
            }
        }
        if ((instance->error_status == SM_ERR_SAFETY_VIOLATION) ||
            (instance->error_status == SM_ERR_RAM_INTEGRITY)    ||
            (instance->error_status == SM_ERR_ROM_INTEGRITY))   {
            /* Enter designated safe state */
            SM_Enter_State(instance, SM_NODE_SAFE, false);
        }
        return;
    }
#endif

    /* MISRA 12.4/15.6: overflow check without wrap-around, braced if body */
    if (delta_ms > (UINT32_MAX - instance->state_timer)) {
        instance->state_timer = UINT32_MAX;
    } else {
        instance->state_timer += delta_ms;
    }

    /* Increment state timers */
    if (instance->state_active[1U]) {
        if (delta_ms > (UINT32_MAX - instance->state_timers[1U])) {
            instance->state_timers[1U] = UINT32_MAX;
        } else {
            instance->state_timers[1U] += delta_ms;
        }
    }
    if (instance->state_active[2U]) {
        if (delta_ms > (UINT32_MAX - instance->state_timers[2U])) {
            instance->state_timers[2U] = UINT32_MAX;
        } else {
            instance->state_timers[2U] += delta_ms;
        }
    }

    /* Step root layer */
    SM_Step_Layer_0(instance, delta_ms);
}

/**
 * @brief Synchronizes state machine variables with MCAL hardware channels.
 * @param instance Pointer to state machine context
 * @return SM_Error_t Sync result error status
 */
static void SM_ReadInputs(ADIA_Instance_t* instance) {
    /* No input variables detected: map physical channels to instance->data here, or tag/name variables as inputs to auto-generate this code. */
    (void)instance;
    (void)&MCAL_Dio_ReadChannel;
}

static void SM_WriteOutputs(ADIA_Instance_t* instance) {
    /* No output variables detected: map instance->data to physical channels here, or tag/name variables as outputs to auto-generate this code. */
    (void)instance;
    (void)&MCAL_Dio_WriteChannel;
}

SM_Error_t SM_Sync_IO(ADIA_Instance_t* instance) {
    if (instance == NULL) {
        return SM_ERR_NONE;
    }
    SM_ReadInputs(instance);
    SM_WriteOutputs(instance);
    return SM_ERR_NONE;
}

/* Helper Functions Implementation */
/**
 * @brief Exits the specified state and recursively exits active sub-states.
 * @req REQ-HSM-040 Hierarchical State Exit
 * @param instance Pointer to state machine context
 * @param state State node to exit
 */
static void SM_Exit_State(ADIA_Instance_t* instance, SM_Node_t state) {
    switch (state) {
        case SM_ST_A:
            SM_ST_A_Exit(instance);
            instance->state_active[1U] = false;
            instance->state_timers[1U] = 0U;
            instance->active_states[0U] = SM_NODE_INVALID;
            break;
        case SM_ST_B:
            instance->state_active[2U] = false;
            instance->state_timers[2U] = 0U;
            instance->active_states[0U] = SM_NODE_INVALID;
            break;
        default:
            break;
    }
}


/**
 * @brief Enters a single state without descending into its child layers.
 * @param instance Pointer to state machine context
 * @param state State node to enter
 */
static void SM_Enter_State_Shallow(ADIA_Instance_t* instance, SM_Node_t state) {
    switch (state) {
        case SM_ST_A:
            instance->active_states[0U] = state;
            instance->state_active[1U] = true;
            instance->state_timers[1U] = 0U;
            SM_ST_A_Entry(instance);
            break;
        case SM_ST_B:
            instance->active_states[0U] = state;
            instance->state_active[2U] = true;
            instance->state_timers[2U] = 0U;
            SM_ST_B_Entry(instance);
            break;
        default:
            break;
    }
}


/**
 * @brief Enters the specified state, sets its active flag, and recursively enters child layers.
 * @req REQ-HSM-030 Hierarchical State Entry
 * @param instance Pointer to state machine context
 * @param state State node to enter
 * @param use_history True to restore sub-state history
 */
static void SM_Enter_State(ADIA_Instance_t* instance, SM_Node_t state, bool use_history) {
    (void)use_history;
    SM_Enter_State_Shallow(instance, state);
    switch (state) {
        default:
            break;
    }
}


/**
 * @brief Enters layer 0 and initializes default states or junctions.
 * @param instance Pointer to state machine context
 * @param use_history True to restore history states
 */
static void SM_Enter_Layer_0(ADIA_Instance_t* instance, bool use_history) {
    if (use_history && (instance->history_states[0U] != SM_NODE_INVALID)) {
        SM_Enter_State(instance, instance->history_states[0U], false);
    } else {
        SM_Enter_State(instance, SM_ST_A, false);
    }
}


/**
 * @brief Evaluates transitions and executes during actions for layer 0.
 * @param instance Pointer to state machine context
 * @param delta_ms Execution tick period in milliseconds
 */
static void SM_Step_Layer_0(ADIA_Instance_t* instance, uint32_t delta_ms) {
    (void)delta_ms;
    switch (instance->active_states[0U]) {
        case SM_ST_A:
            bool transitioned_1 = false;
            /* Evaluate Outgoing Transitions */
            if ((instance->state_timers[1U] >= SM_TMR_TR_T1_MS)) {
                SM_Exit_State(instance, SM_ST_A);
                SM_Enter_State(instance, SM_ST_B, false);
                transitioned_1 = true;
            }
            else { /* MISRA 15.7 */ }
            if (!transitioned_1) {
                /* Run During Actions */
                SM_ST_A_During(instance, delta_ms);
            }
            break;
        case SM_ST_B:
            /* Run During Actions */
            SM_ST_B_During(instance, delta_ms);
            break;
        default:
            break;
    }
}


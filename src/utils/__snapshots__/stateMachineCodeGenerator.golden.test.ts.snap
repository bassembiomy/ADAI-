#include "sm_config.h"

/* State: A | Model ID: s1 | C enum: SM_ST_S1 */
void SM_ST_S1_Entry(ADIA_Instance_t *instance);
void SM_ST_S1_During(ADIA_Instance_t *instance);
void SM_ST_S1_Exit(ADIA_Instance_t *instance);
/* State: B | Model ID: s2 | C enum: SM_ST_S2 */
void SM_ST_S2_Entry(ADIA_Instance_t *instance);
void SM_ST_S2_During(ADIA_Instance_t *instance);
void SM_ST_S2_Exit(ADIA_Instance_t *instance);

#endif /* SM_USER_LOGIC_H */
",
    "name": "sm_user_logic.h",
  },
  {
    "content": "#include <math.h>
#include "sm_core.h"
#include "sm_user_logic.h"

/* State: A | Model ID: s1 | C enum: SM_ST_S1 */
void SM_ST_S1_Entry(ADIA_Instance_t *instance)
{
    {
        int64_t sm_tmp;
        if (SM_StoreI64(instance, ((int64_t)100), 0, 4294967295LL, false, &sm_tmp)) {
            instance->data.log = (uint32_t)sm_tmp;
        }
    }
    SM_TraceAction(instance, "entry:S1");
}

void SM_ST_S1_During(ADIA_Instance_t *instance)
{
    {
        int64_t sm_tmp;
        if (SM_StoreI64(instance, SM_AddI64(((int64_t)instance->data.log), ((int64_t)1)), 0, 4294967295LL, false, &sm_tmp)) {
            instance->data.log = (uint32_t)sm_tmp;
        }
    }
    SM_TraceAction(instance, "during:S1");
}

void SM_ST_S1_Exit(ADIA_Instance_t *instance)
{
    {
        int64_t sm_tmp;
        if (SM_StoreI64(instance, SM_AddI64(((int64_t)instance->data.log), ((int64_t)5)), 0, 4294967295LL, false, &sm_tmp)) {

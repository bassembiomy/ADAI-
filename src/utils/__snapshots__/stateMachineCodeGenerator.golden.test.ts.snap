    "content": "#include "sm_core.h"
#include "sm_user_logic.h"

void SM_ST_S1_Entry(ADIA_Instance_t *instance)
{
    instance->data.log = (uint32_t)(100U);
    SM_TraceAction(instance, "entry:S1");
}

void SM_ST_S1_During(ADIA_Instance_t *instance)
{
    instance->data.log = (uint32_t)((instance->data.log + 1U));
    SM_TraceAction(instance, "during:S1");
}

void SM_ST_S1_Exit(ADIA_Instance_t *instance)
{
    instance->data.log = (uint32_t)((instance->data.log + 5U));
    SM_TraceAction(instance, "exit:S1");
}

void SM_ST_S2_Entry(ADIA_Instance_t *instance)
{
    instance->data.log = (uint32_t)(200U);
    SM_TraceAction(instance, "entry:S2");
}

void SM_ST_S2_During(ADIA_Instance_t *instance)
{
    instance->data.log = (uint32_t)((instance->data.log + 2U));
    SM_TraceAction(instance, "during:S2");
}

void SM_ST_S2_Exit(ADIA_Instance_t *instance)
{
    (void)instance;
}


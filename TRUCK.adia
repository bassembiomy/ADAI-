etId\":\"req-req-ebs-03\"},\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-com-01\":{\"id\":\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-com-01\",\"kind\":\"satisfy\",\"sourceId\":\"bf30ba36-c8f4-4406-8078-70b3dabaaa69\",\"targetId\":\"req-req-com-01\"},\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-cpc-01\":{\"id\":\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-cpc-01\",\"kind\":\"satisfy\",\"sourceId\":\"bf30ba36-c8f4-4406-8078-70b3dabaaa69\",\"targetId\":\"req-req-cpc-01\"},\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-cpc-02\":{\"id\":\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-cpc-02\",\"kind\":\"satisfy\",\"sourceId\":\"bf30ba36-c8f4-4406-8078-70b3dabaaa69\",\"targetId\":\"req-req-cpc-02\"},\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-net-01\":{\"id\":\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-net-01\",\"kind\":\"satisfy\",\"sourceId\":\"bf30ba36-c8f4-4406-8078-70b3dabaaa69\",\"targetId\":\"req-req-net-01\"},\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-net-03\":{\"id\":\"satisfy-bf30ba36-c8f4-4406-8078-70b3dabaaa69-req-req-net-03\",\"kind\":\"satisfy\",\"sourceId\":\"bf30ba36-c8f4-4406-8078-70b3dabaaa69\",\"targetId\":\"req-req-net-03\"},\"satisfy-blk-5c43d9fb-req-req-pt-01\":{\"id\":\"satisfy-blk-5c43d9fb-req-req-pt-01\",\"kind\":\"satisfy\",\"sourceId\":\"blk-5c43d9fb\",\"targetId\":\"req-req-pt-01\"},\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-asam-01\":{\"id\":\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-asam-01\",\"kind\":\"satisfy\",\"sourceId\":\"dd409999-f68b-4743-a110-be02a3edadcb\",\"targetId\":\"req-req-asam-01\"},\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-com-01\":{\"id\":\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-com-01\",\"kind\":\"satisfy\",\"sourceId\":\"dd409999-f68b-4743-a110-be02a3edadcb\",\"targetId\":\"req-req-com-01\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-com-01\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-com-01\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-com-01\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-01\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-01\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-tcm-01\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-02\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-02\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-tcm-02\"}},\"requirements\":{\"req-req-asam-01\":{\"id\":\"req-req-asam-01\",\"kind\":\"requirement\",\"name\":\"Sensor acquisition and actuation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ASAM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ASAM shall read the sensors and switches wired to it, drive the actuators wired to it and exchange their states on the cabin CAN.\",\"version\":\"1.0\"},\"req-req-com-01\":{\"id\":\"req-req-com-01\",\"kind\":\"requirement\",\"name\":\"Communication loss handling\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-COM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Every controller shall detect the loss of communication with a partner it depends on, store a fault and continue with a defined substitute behaviour.\",\"version\":\"1.0\"},\"req-req-cpc-01\":{\"id\":\"req-req-cpc-01\",\"kind\":\"requirement\",\"name\":\"Driver demand acquisition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall read the accelerator pedal position and convert it into the driver torque demand.\",\"version\":\"1.0\"},\"req-req-cpc-02\":{\"id\":\"req-req-cpc-02\",\"kind\":\"requirement\",\"name\":\"Torque coordination\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall arbitrate the torque demands of the driver, the TCM and the EBS and send one resulting torque demand to the MCM.\",\"version\":\"1.0\"},\"req-req-ebs-01\":{\"id\":\"req-req-ebs-01\",\"kind\":\"requirement\",\"name\":\"Electronic service braking\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall control the brake pressure electronically according to the brake demand of the driver.\",\"version\":\"1.0\"},\"req-req-ebs-02\":{\"id\":\"req-req-ebs-02\",\"kind\":\"requirement\",\"name\":\"Wheel slip control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall prevent wheel lock under braking (ABS) and drive wheel spin under traction (ASR).\",\"version\":\"1.0\"},\"req-req-ebs-03\":{\"id\":\"req-req-ebs-03\",\"kind\":\"requirement\",\"name\":\"Brake torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-EBS-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall request the engine torque limitation and the engine brake it needs from the CPC over the frame CAN.\",\"version\":\"1.0\"},\"req-req-icuc-01\":{\"id\":\"req-req-icuc-01\",\"kind\":\"requirement\",\"name\":\"Driver information\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ICUC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall display the vehicle speed, the engine speed, the engaged gear and the operating data it receives over the cabin CAN.\",\"version\":\"1.0\"},\"req-req-icuc-02\":{\"id\":\"req-req-icuc-02\",\"kind\":\"requirement\",\"name\":\"Warning indication\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ICUC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall indicate the warnings and faults reported by the other controllers to the driver.\",\"version\":\"1.0\"},\"req-req-mcm-01\":{\"id\":\"req-req-mcm-01\",\"kind\":\"requirement\",\"name\":\"Engine torque control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-MCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall control the engine so that it delivers the torque demanded by the CPC.\",\"version\":\"1.0\"},\"req-req-mcm-02\":{\"id\":\"req-req-mcm-02\",\"kind\":\"requirement\",\"name\":\"Engine status reporting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-MCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall report the engine speed, the actual engine torque and the engine status on the drivetrain CAN.\",\"version\":\"1.0\"},\"req-req-net-01\":{\"id\":\"req-req-net-01\",\"kind\":\"requirement\",\"name\":\"Network segmentation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The controllers shall communicate over three separated CAN segments: the drivetrain CAN (MCM, CPC, TCM), the frame CAN (CPC, EBS, CGW) and the cabin CAN (CGW, ASAM, ICUC, SRS).\",\"version\":\"1.0\"},\"req-req-net-02\":{\"id\":\"req-req-net-02\",\"kind\":\"requirement\",\"name\":\"Central gateway routing\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall route the messages needed by controllers of another segment between the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-net-03\":{\"id\":\"req-req-net-03\",\"kind\":\"requirement\",\"name\":\"Drivetrain gateway\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall be the only link between the drivetrain CAN and the frame CAN and shall route powertrain data between them.\",\"version\":\"1.0\"},\"req-req-net-04\":{\"id\":\"req-req-net-04\",\"kind\":\"requirement\",\"name\":\"Diagnostic access\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall give a diagnostic tester access to the fault memory of every controller on the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-pt-01\":{\"id\":\"req-req-pt-01\",\"kind\":\"requirement\",\"name\":\"Power train composition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-PT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The power train shall consist of the engine control (MCM), the powertrain coordination (CPC) and the transmission control (TCM).\",\"version\":\"1.0\"},\"req-req-srs-01\":{\"id\":\"req-req-srs-01\",\"kind\":\"requirement\",\"name\":\"Restraint deployment\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-SRS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall detect a crash and deploy the air bag.\",\"version\":\"1.0\"},\"req-req-srs-02\":{\"id\":\"req-req-srs-02\",\"kind\":\"requirement\",\"name\":\"Restraint system monitoring\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-SRS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall monitor its firing circuits and sensors and report a fault on the cabin CAN for indication by the ICUC.\",\"version\":\"1.0\"},\"req-req-tcm-01\":{\"id\":\"req-req-tcm-01\",\"kind\":\"requirement\",\"name\":\"Automated gear shifting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-TCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall select the gear and execute the gear changes of the automated (PowerShift) transmission.\",\"version\":\"1.0\"},\"req-req-tcm-02\":{\"id\":\"req-req-tcm-02\",\"kind\":\"requirement\",\"name\":\"Shift torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-TCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall request the engine torque and engine speed it needs during a gear change from the CPC.\",\"version\":\"1.0\"},\"req-req-trk-00\":{\"id\":\"req-req-trk-00\",\"kind\":\"requirement\",\"name\":\"Truck controller specification\",\"namespace\":[],\"ownerId\":\"pkg-truck-requirements\",\"priority\":\"high\",\"requirementId\":\"REQ-TRK-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Specification of the main controllers of the truck: power train (MCM, CPC, TCM), EBS, CGW, ASAM, ICUC and SRS.\",\"version\":\"1.0\"}},\"revision\":171,\"schemaVersion\":5,\"subjects\":{},\"usages\":{},\"useCases\":{},\"verificationCases\":{}},\"schemaVersion\":5}","sysmlCoordinates":{},"diagramPresentations":{"adia-default-bdd":{"elementIds":["pkg-8dcd5e03"],"presentations":{"pkg-8dcd5e03":{"id":"presentation:adia-default-bdd:pkg-8dcd5e03","diagramId":"adia-default-bdd","semanticElementId":"pkg-8dcd5e03","bounds":{"x":283,"y":251,"width":220,"height":140}}}},"diag-61206b63":{"elementIds":["blk-5c43d9fb","2a74537e-740c-4dfb-9f54-8e348ff99e57","bf30ba36-c8f4-4406-8078-70b3dabaaa69","f54c5f14-0dcb-431e-8809-d52242bb3dc2","b33cde8d-ad81-40b9-8c41-ab153137a596","7b68b9bf-63c4-4981-8972-6f975fcbf7d7","dd409999-f68b-4743-a110-be02a3edadcb","9705f04e-6e9d-4cb5-b946-97868f143fbb","0df9b80e-a972-4b43-943e-c747eb6ef4d2","09f4d19a-521f-4bcd-9592-9348b306f6d0","99f648a6-b67c-464e-9a52-6cba3c522d68","13c2aca2-a30b-4e0c-86d6-32e23594b22a"],"presentations":{"blk-5c43d9fb":{"id":"presentation:diag-61206b63:blk-5c43d9fb","diagramId":"diag-61206b63","semanticElementId":"blk-5c43d9fb","bounds":{"x":211.44021017139985,"y":117.62690805981657,"width":150,"height":100}},"2a74537e-740c-4dfb-9f54-8e348ff99e57":{"id":"presentation:diag-61206b63:2a74537e-740c-4dfb-9f54-8e348ff99e57","diagramId":"diag-61206b63","semanticElementId":"2a74537e-740c-4dfb-9f54-8e348ff99e57
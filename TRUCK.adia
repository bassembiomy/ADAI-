"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-01\"},\"satisfy-blk-entertainment-screen-req-req-ent-02\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-02\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-02\"},\"satisfy-blk-entertainment-screen-req-req-ent-03\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-03\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-03\"},\"satisfy-blk-entertainment-screen-req-req-ent-04\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-04\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-04\"},\"satisfy-blk-entertainment-screen-req-req-ent-05\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-05\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-05\"},\"satisfy-blk-entertainment-screen-req-req-ent-06\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-06\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-06\"},\"satisfy-blk-entertainment-screen-req-req-ent-07\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-ent-07\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-ent-07\"},\"satisfy-blk-entertainment-screen-req-req-spc-02\":{\"id\":\"satisfy-blk-entertainment-screen-req-req-spc-02\",\"kind\":\"satisfy\",\"sourceId\":\"blk-entertainment-screen\",\"targetId\":\"req-req-spc-02\"},\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-asam-01\":{\"id\":\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-asam-01\",\"kind\":\"satisfy\",\"sourceId\":\"dd409999-f68b-4743-a110-be02a3edadcb\",\"targetId\":\"req-req-asam-01\"},\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-com-01\":{\"id\":\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-com-01\",\"kind\":\"satisfy\",\"sourceId\":\"dd409999-f68b-4743-a110-be02a3edadcb\",\"targetId\":\"req-req-com-01\"},\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-con-07\":{\"id\":\"satisfy-dd409999-f68b-4743-a110-be02a3edadcb-req-req-con-07\",\"kind\":\"satisfy\",\"sourceId\":\"dd409999-f68b-4743-a110-be02a3edadcb\",\"targetId\":\"req-req-con-07\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-com-01\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-com-01\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-com-01\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-con-03\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-con-03\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-con-03\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-01\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-01\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-tcm-01\"},\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-02\":{\"id\":\"satisfy-f54c5f14-0dcb-431e-8809-d52242bb3dc2-req-req-tcm-02\",\"kind\":\"satisfy\",\"sourceId\":\"f54c5f14-0dcb-431e-8809-d52242bb3dc2\",\"targetId\":\"req-req-tcm-02\"}},\"requirements\":{\"req-req-ac-01\":{\"id\":\"req-req-ac-01\",\"kind\":\"requirement\",\"name\":\"Climate request execution\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-AC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The air conditioner shall execute the climate requests of the display system within 100 ms and report its climate status on the cabin CAN.\",\"version\":\"1.0\"},\"req-req-asam-01\":{\"id\":\"req-req-asam-01\",\"kind\":\"requirement\",\"name\":\"Sensor acquisition and actuation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ASAM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ASAM shall read the sensors and switches wired to it, drive the actuators wired to it and exchange their states on the cabin CAN.\",\"version\":\"1.0\"},\"req-req-cnt-01\":{\"id\":\"req-req-cnt-01\",\"kind\":\"requirement\",\"name\":\"Speed and engine speed\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the vehicle speed (km/h) and the engine speed (rpm), updated at least 10 times per second.\",\"version\":\"1.0\"},\"req-req-cnt-02\":{\"id\":\"req-req-cnt-02\",\"kind\":\"requirement\",\"name\":\"Gear and cruise control\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the engaged gear, the shift mode (automatic / manual) and the cruise control state and set speed.\",\"version\":\"1.0\"},\"req-req-cnt-03\":{\"id\":\"req-req-cnt-03\",\"kind\":\"requirement\",\"name\":\"Engine operating data\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the coolant temperature and the engine oil pressure.\",\"version\":\"1.0\"},\"req-req-cnt-04\":{\"id\":\"req-req-cnt-04\",\"kind\":\"requirement\",\"name\":\"Odometer and trip\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the total distance, two trip distances and the service interval received from the ICUC.\",\"version\":\"1.0\"},\"req-req-cnt-05\":{\"id\":\"req-req-cnt-05\",\"kind\":\"requirement\",\"name\":\"Telltales and warnings\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-CNT-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the brake / ABS / ASR, airbag, engine and transmission telltales and warnings within 200 ms of their reception, in front of any other content.\",\"version\":\"1.0\"},\"req-req-cnt-06\":{\"id\":\"req-req-cnt-06\",\"kind\":\"requirement\",\"name\":\"Telltale start-up and lamp check\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the telltales within 2 s of KL15 on and run a lamp check of all telltales.\",\"version\":\"1.0\"},\"req-req-cnt-07\":{\"id\":\"req-req-cnt-07\",\"kind\":\"requirement\",\"name\":\"Missing data indication\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"When a displayed value is not received for 1 s, the counters screen shall show it as invalid (---) and indicate a communication fault.\",\"version\":\"1.0\"},\"req-req-com-01\":{\"id\":\"req-req-com-01\",\"kind\":\"requirement\",\"name\":\"Communication loss handling\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-COM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Every controller shall detect the loss of communication with a partner it depends on, store a fault and continue with a defined substitute behaviour.\",\"version\":\"1.0\"},\"req-req-con-00\":{\"id\":\"req-req-con-00\",\"kind\":\"requirement\",\"name\":\"Display connection specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall be connected to the cabin CAN and shall receive the data of every controller listed below, directly on the cabin CAN or routed by the CPC and the CGW.\",\"version\":\"1.0\"},\"req-req-con-01\":{\"id\":\"req-req-con-01\",\"kind\":\"requirement\",\"name\":\"MCM to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall send EngineData (engine speed, coolant temperature, oil pressure, engine warnings) at 10 Hz; CPC routes it from the drivetrain CAN to the frame CAN and CGW to the cabin CAN, to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-02\":{\"id\":\"req-req-con-02\",\"kind\":\"requirement\",\"name\":\"CPC to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall send CruiseControlStatus (state, set speed, accelerator pedal position) at 10 Hz on the frame CAN; CGW routes it to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-03\":{\"id\":\"req-req-con-03\",\"kind\":\"requirement\",\"name\":\"TCM to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall send GearData (engaged gear, target gear, shift mode, transmission warnings) on change and at 10 Hz; CPC and CGW route it to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-04\":{\"id\":\"req-req-con-04\",\"kind\":\"requirement\",\"name\":\"EBS to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall send VehicleSpeed (from the wheel speeds) at 10 Hz and BrakeStatus (ABS / ASR active, brake fault, lining wear) on the frame CAN; CGW routes them to both screens.\",\"version\":\"1.0\"},\"req-req-con-05\":{\"id\":\"req-req-con-05\",\"kind\":\"requirement\",\"name\":\"ICUC to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall send ClusterData (odometer, trips, service interval, telltale and warning list) on the cabin CAN to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-06\":{\"id\":\"req-req-con-06\",\"kind\":\"requirement\",\"name\":\"SRS to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall send AirbagStatus (ready / fault) on the cabin CAN at 1 Hz and on change, to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-07\":{\"id\":\"req-req-con-07\",\"kind\":\"requirement\",\"name\":\"ASAM to entertainment screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ASAM shall send BodyStatus (lights, doors, switches) on the cabin CAN to the entertainment screen and execute the BodyRequest messages it receives from it.\",\"version\":\"1.0\"},\"req-req-con-08\":{\"id\":\"req-req-con-08\",\"kind\":\"requirement\",\"name\":\"CGW to entertainment screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-08\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall route the frame CAN data the screens need to the cabin CAN and provide the FaultList of every controller to the entertainment screen.\",\"version\":\"1.0\"},\"req-req-con-09\":{\"id\":\"req-req-con-09\",\"kind\":\"requirement\",\"name\":\"Entertainment screen to air conditioner\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-09\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall send ClimateRequest on the cabin CAN on every change; the air conditioner shall answer with ClimateStatus at 1 Hz and on change.\",\"version\":\"1.0\"},\"req-req-cpc-01\":{\"id\":\"req-req-cpc-01\",\"kind\":\"requirement\",\"name\":\"Driver demand acquisition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall read the accelerator pedal position and convert it into the driver torque demand.\",\"version\":\"1.0\"},\"req-req-cpc-02\":{\"id\":\"req-req-cpc-02\",\"kind\":\"requirement\",\"name\":\"Torque coordination\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall arbitrate the torque demands of the driver, the TCM and the EBS and send one resulting torque demand to the MCM.\",\"version\":\"1.0\"},\"req-req-dsp-00\":{\"id\":\"req-req-dsp-00\",\"kind\":\"requirement\",\"name\":\"Display system specification\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-DSP-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall present every vehicle feature to the driver on two screens: a counters screen for the driving information and an entertainment screen for media, communication, climate and all other vehicle features.\",\"version\":\"1.0\"},\"req-req-dsp-01\":{\"id\":\"req-req-dsp-01\",\"kind\":\"requirement\",\"name\":\"Two-screen display system\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall consist of a counters screen in front of the driver and an entertainment screen in the centre of the dashboard.\",\"version\":\"1.0\"},\"req-req-dsp-02\":{\"id\":\"req-req-dsp-02\",\"kind\":\"requirement\",\"name\":\"Single access to vehicle features\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Every vehicle feature the driver can see or set shall be reachable from the display system: driving information on the counters screen, all other features from the vehicle menu of the entertainment screen.\",\"version\":\"1.0\"},\"req-req-dsp-03\":{\"id\":\"req-req-dsp-03\",\"kind\":\"requirement\",\"name\":\"Power and wake-up\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall operate from the 24 V supply between 16 V and 32 V and shall wake up on KL15 on or on cabin CAN activity.\",\"version\":\"1.0\"},\"req-req-dsp-04\":{\"id\":\"req-req-dsp-04\",\"kind\":\"requirement\",\"name\":\"Day and night mode\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Both screens shall adapt their brightness to the ambient light and switch to a night colour scheme when the vehicle lights are on.\",\"version\":\"1.0\"},\"req-req-ebs-01\":{\"id\":\"req-req-ebs-01\",\"kind\":\"requirement\",\"name\":\"Electronic service braking\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall control the brake pressure electronically according to the brake demand of the driver.\",\"version\":\"1.0\"},\"req-req-ebs-02\":{\"id\":\"req-req-ebs-02\",\"kind\":\"requirement\",\"name\":\"Wheel slip control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall prevent wheel lock under braking (ABS) and drive wheel spin under traction (ASR).\",\"version\":\"1.0\"},\"req-req-ebs-03\":{\"id\":\"req-req-ebs-03\",\"kind\":\"requirement\",\"name\":\"Brake torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-EBS-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall request the engine torque limitation and the engine brake it needs from the CPC over the frame CAN.\",\"version\":\"1.0\"},\"req-req-ent-01\":{\"id\":\"req-req-ent-01\",\"kind\":\"requirement\",\"name\":\"Media\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall play radio (FM / DAB), USB and Bluetooth audio.\",\"version\":\"1.0\"},\"req-req-ent-02\":{\"id\":\"req-req-ent-02\",\"kind\":\"requirement\",\"name\":\"Hands-free telephone\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall provide Bluetooth hands-free calls and show incoming calls also on the counters screen.\",\"version\":\"1.0\"},\"req-req-ent-03\":{\"id\":\"req-req-ent-03\",\"kind\":\"requirement\",\"name\":\"Navigation\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall provide truck navigation and send the turn guidance to the counters screen.\",\"version\":\"1.0\"},\"req-req-ent-04\":{\"id\":\"req-req-ent-04\",\"kind\":\"requirement\",\"name\":\"Climate control\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ENT-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall control the air conditioner: AC on/off, auto mode, set temperature 16 to 28 °C in 0.5 °C steps, fan level 1 to 7, recirculation, defrost and air distribution, and shall show the climate status.\",\"version\":\"1.0\"},\"req-req-ent-05\":{\"id\":\"req-req-ent-05\",\"kind\":\"requirement\",\"name\":\"Vehicle settings\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall show and set the body functions (lights, doors, switches) handled by the ASAM.\",\"version\":\"1.0\"},\"req-req-ent-06\":{\"id\":\"req-req-ent-06\",\"kind\":\"requirement\",\"name\":\"Fault list\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall show the active faults of every controller, read through the CGW.\",\"version\":\"1.0\"},\"req-req-ent-07\":{\"id\":\"req-req-ent-07\",\"kind\":\"requirement\",\"name\":\"Driver distraction lockout\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ENT-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Above 5 km/h the entertainment screen shall block video playback and text entry.\",\"version\":\"1.0\"},\"req-req-icuc-01\":{\"id\":\"req-req-icuc-01\",\"kind\":\"requirement\",\"name\":\"Driver information\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ICUC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall display the vehicle speed, the engine speed, the engaged gear and the operating data it receives over the cabin CAN.\",\"version\":\"1.0\"},\"req-req-icuc-02\":{\"id\":\"req-req-icuc-02\",\"kind\":\"requirement\",\"name\":\"Warning indication\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ICUC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall indicate the warnings and faults reported by the other controllers to the driver.\",\"version\":\"1.0\"},\"req-req-mcm-01\":{\"id\":\"req-req-mcm-01\",\"kind\":\"requirement\",\"name\":\"Engine torque control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-MCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall control the engine so that it delivers the torque demanded by the CPC.\",\"version\":\"1.0\"},\"req-req-mcm-02\":{\"id\":\"req-req-mcm-02\",\"kind\":\"requirement\",\"name\":\"Engine status reporting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-MCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall report the engine speed, the actual engine torque and the engine status on the drivetrain CAN.\",\"version\":\"1.0\"},\"req-req-net-01\":{\"id\":\"req-req-net-01\",\"kind\":\"requirement\",\"name\":\"Network segmentation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The controllers shall communicate over three separated CAN segments: the drivetrain CAN (MCM, CPC, TCM), the frame CAN (CPC, EBS, CGW) and the cabin CAN (CGW, ASAM, ICUC, SRS).\",\"version\":\"1.0\"},\"req-req-net-02\":{\"id\":\"req-req-net-02\",\"kind\":\"requirement\",\"name\":\"Central gateway routing\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall route the messages needed by controllers of another segment between the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-net-03\":{\"id\":\"req-req-net-03\",\"kind\":\"requirement\",\"name\":\"Drivetrain gateway\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall be the only link between the drivetrain CAN and the frame CAN and shall route powertrain data between them.\",\"version\":\"1.0\"},\"req-req-net-04\":{\"id\":\"req-req-net-04\",\"kind\":\"requirement\",\"name\":\"Diagnostic access\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall give a diagnostic tester access to the fault memory of every controller on the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-pt-01\":{\"id\":\"req-req-pt-01\",\"kind\":\"requirement\",\"name\":\"Power train composition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-PT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The power train shall consist of the engine control (MCM), the powertrain coordination (CPC) and the transmission control (TCM).\",\"version\":\"1.0\"},\"req-req-spc-01\":{\"id\":\"req-req-spc-01\",\"kind\":\"requirement\",\"name\":\"Counters screen specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Counters screen: 12.3 in, 1920 x 720 px, at least 1000 cd/m², contrast 1000:1, 60 Hz, -40 to +85 °C, telltales ASIL B (ISO 26262).\",\"version\":\"1.0\"},\"req-req-spc-02\":{\"id\":\"req-req-spc-02\",\"kind\":\"requirement\",\"name\":\"Entertainment screen specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Entertainment screen: 10.25 in, 1920 x 720 px, projected-capacitive multi-touch usable with gloves, at least 800 cd/m², touch response at most 100 ms, -30 to +85 °C, Bluetooth 5, Wi-Fi, 2 x USB-C, 4 x 25 W audio.\",\"version\":\"1.0\"},\"req-req-spc-03\":{\"id\":\"req-req-spc-03\",\"kind\":\"requirement\",\"name\":\"Display network interface\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall be connected to the cabin CAN at 500 kbit/s; the two screens shall be joined by a display link for shared content.\",\"version\":\"1.0\"},\"req-req-srs-01\":{\"id\":\"req-req-srs-01\",\"kind\":\"requirement\",\"name\":\"Restraint deployment\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-SRS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall detect a crash and deploy the air bag.\",\"version\":\"1.0\"},\"req-req-srs-02\":{\"id\":\"req-req-srs-02\",\"kind\":\"requirement\",\"name\":\"Restraint system monitoring\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-SRS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall monitor its firing circuits and sensors and report a fault on the cabin CAN for indication by the ICUC.\",\"version\":\"1.0\"},\"req-req-tcm-01\":{\"id\":\"req-req-tcm-01\",\"kind\":\"requirement\",\"name\":\"Automated gear shifting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-TCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall select the gear and execute the gear changes of the automated (PowerShift) transmission.\",\"version\":\"1.0\"},\"req-req-tcm-02\":{\"id\":\"req-req-tcm-02\",\"kind\":\"requirement\",\"name\":\"Shift torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-TCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall request the engine torque and engine speed it needs during a gear change from the CPC.\",\"version\":\"1.0\"},\"req-req-trk-00\":{\"id\":\"req-req-trk-00\",\"kind\":\"requirement\",\"name\":\"Truck controller specification\",\"namespace\":[],\"ownerId\":\"pkg-truck-requirements\",\"priority\":\"high\",\"requirementId\":\"REQ-TRK-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Specification of the main controllers of the truck: power train (MCM, CPC, TCM), EBS, CGW, ASAM, ICUC, SRS, the display system and the air conditioner.\",\"version\":\"1.0\"}},\"revision\":416,\"schemaVersion\":5,\"subjects\":{},\"usages\":{},\"useCases\":{},\"verificationCases\":{}},\"schemaVersion\":5}","sysmlCoordinates":{},"diagramPresentations":{"adia-default-bdd":{"elementIds":["pkg-8dcd5e03"],"presentations":{"pkg-8dcd5e03":{"id":"presentation:adia-default-bdd:pkg-8dcd5e03","diagramId":"adia-default-bdd","semanticElementId":"pkg-8dcd5e03","bounds":{"x":283,"y":251,"width":220,"height":140}}}},"diag-61206b63":{"elementIds":["blk-5c43d9fb","2a74537e-740c-4dfb-9f54-8e348ff99e57","bf30ba36-c8f4-4406-8078-70b3dabaaa69","f54c5f14-0dcb-431e-8809-d52242bb3dc2","b33cde8d-ad81-40b9-8c41-ab153137a596","7b68b9bf-63c4-4981-8972-6f975fcbf7d7","dd409999-f68b-4743-a110-be02a3edadcb","9705f04e-6e9d-4cb5-b946-97868f143fbb","0df9b80e-a972-4b43-943e-c747eb6ef4d2","09f4d19a-521f-4bcd-9592-9348b306f6d0","99f648a6-b67c-464e-9a52-6cba3c522d68","13c2aca2-a30b-4e0c-86d6-32e23594b22a","blk-display-system","blk-air-conditioner","blk-counters-screen","blk-entertainment-screen","comp-displaysystem-countersscreen","comp-displaysystem-entertainmentscreen"],"presentations":{"blk-5c43d9fb":{"id":"presentation:diag-61206b63:blk-5c43d9fb","diagramId":"diag-61206b63","semanticElementId":"blk-5c43d9fb","bounds":{"x":211.44021017139985,"y":117.62690805981657,"width":150,"height":100}},"2a74537e-740c-4dfb-9f54-8e348ff99e57":{"id":"presentation:diag-61206b63:2a74537e-740c-4dfb-9f54-8e348ff99e57","diagramId":"diag-61206b63","semanticElementId":"2a74537e-740c-4dfb-9f54-8e348ff99e57","bounds":{"x":12.256438498371047,"y":308.7072768340848,"width":160,"height":100}},"bf30ba36-c8f4-4406-8078-70b3dabaaa69":{"id":"presentation:diag-61206b63:bf30ba36-c8f4-4406-8078-70b3dabaaa69","diagramId":"diag-61206b63","semanticElementId":"bf30ba36-c8f4-4406-8078-70b3dabaaa69","bounds":{"x":266.71209653352037,"y":432.4201521148496,"width":160,"height":100}},"f54c5f14-0dcb-431e-8809-d52242bb3dc2":{"id":"presentation:diag-61206b63:f54c5f14-0dcb-431e-8809-d52242bb3dc2","diagramId":"diag-61206b63","semanticElementId":"f54c5f14-0dcb-431e-8809-d52242bb3dc2","bounds":{"x":496.2099145285722,"y":289.3465291515801,"width":160,"height":100}},"b33cde8d-ad81-40b9-8c41-ab153137a596":{"id":"presentation:diag-61206b63:b33cde8d-ad81-40b9-8c41-ab153137a596","diagramId":"diag-61206b63","semanticElementId":"b33cde8d-ad81-40b9-8c41-ab153137a596","bounds":{"x":1050.7494576093163,"y":306.9423280537001,"width":160,"height":100}},"7b68b9bf-63c4-4981-8972-6f975fcbf7d7":{"id":"presentation:diag-61206b63:7b68b9bf-63c4-4981-8972-6f975fcbf7d7","diagramId":"diag-61206b63","semanticElementId":"7b68b9bf-63c4-4981-8972-6f975fcbf7d7","bounds":{"x":791.4221017852084,"y":70.2851573213533,"width":160,"height":100}},"dd409999-f68b-4743-a110-be02a3edadcb":{"id":"presentation:diag-61206b63:dd409999-f68b-4743-a110-be02a3edadcb","diagramId":"diag-61206b63","semanticElementId":"dd409999-f68b-4743-a110-be02a3edadcb","bounds":{"x":717.9288797003869,"y":306.40479960851417,"width":160,"height":100}},"9705f04e-6e9d-4cb5-b946-97868f143fbb":{"id":"presentation:diag-61206b63:9705f04e-6e9d-4cb5-b946-97868f143fbb","diagramId":"diag-61206b63","semanticElementId":"9705f04e-6e9d-4cb5-b946-97868f143fbb","bounds":{"x":1282.4409421950538,"y":294.5079266302144,"width":160,"height":100}},"0df9b80e-a972-4b43-943e-c747eb6ef4d2":{"id":"presentation:diag-61206b63:0df9b80e-a972-4b43-943e-c747eb6ef4d2","diagramId":"diag-61206b63","semanticElementId":"0df9b80e-a972-4b43-943e-c747eb6ef4d2","bounds":{"x":1514.0434406087136,"y":286.7913334549638,"width":160,"height":100}},"09f4d19a-521f-4bcd-9592-9348b306f6d0":{"id":"presentation:diag-61206b63:09f4d19a-521f-4bcd-9592-9348b306f6d0","diagramId":"diag-61206b63","semanticElementId":"09f4d19a-521f-4bcd-9592-9348b306f6d0","bounds":{"x":80,"y":80,"width":160,"height":100}},"99f648a6-b67c-464e-9a52-6cba3c522d68":{"id":"presentation:diag-61206b63:99f648a6-b67c-464e-9a52-6cba3c522d68","diagramId":"diag-61206b63","semanticElementId":"99f648a6-b67c-464e-9a52-6cba3c522d68","bound
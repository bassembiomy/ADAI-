{
  "name": "adia",
  "private": true,
  "version": "1.0.0",
  "description": "ADIA Stateflow Application",
  "author": "ADIA Team",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "audit:security": "npm audit --audit-level=high",
    "test:vlab": "vitest run src/engine/vlab/vlab_validation.test.ts src/engine/vlab/vlab.test.ts src/engine/vlab/labs_sim.test.ts src/engine/vlab/check_missing_math.test.ts",
    "test:vlab:connected": "vitest run src/engine/vlab/vlab_connected_models.test.ts --reporter=verbose",
    "test:vlab:all-blocks": "vitest run src/engine/vlab/test_all_blocks_scope.test.ts --reporter=dot",
    "test:doe": "vitest run src/engine/doe/ src/components/doe/",
    "test:doe:integration": "vitest run src/engine/doe/ src/components/doe/ src/engine/vlab/vlab_connected_models.test.ts src/utils/jsonImportValidator.test.ts",
    "zero-g": "tsx scripts/zero_g_ci.ts",
    "prebuild": "npm audit --audit-level=critical || echo \"[WARNING] Unfixable audit vulnerabilities detected: tar, tmp, xlsx have no upstream fix. Review before production release.\""
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "electron-squirrel-startup": "^1.0.1",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mathjs": "^15.2.0",
    "plotly.js": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^2.0.19",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.4",
    "serialport": "^12.0.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/jszip": "^3.4.0",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^30.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}

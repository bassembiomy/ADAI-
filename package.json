{
  "name": "adia",
  "productName": "ADIA",
  "private": true,
  "version": "1.0.0",
  "description": "ADIA Engineering Suite",
  "author": "ADIA Team",
  "type": "module",
  "main": "dist-electron/index.cjs",
  "scripts": {
    "dev": "vite",
    "build:sm-runtime": "tsx scripts/build_state_machine_runtime.ts",
    "build:electron": "npx electron scripts/build_protected_electron.cjs",
    "build": "tsc && vite build && npm run build:electron",
    "build:offline": "npm run build:sm-runtime && tsc && vite build && npm run build:electron",
    "preview": "vite preview",
    "start": "npm run build:offline && electron-forge start",
    "start:prebuilt": "electron-forge start",
    "provision:hil": "node scripts/provision_hil_toolchains.cjs",
    "package": "npm run test:hil:bundle && npm run build && electron-forge package",
    "make": "npm run test:hil:bundle && npm run build && electron-forge make",
    "audit:security": "npm audit --audit-level=high",
    "audit:security:full": "npm audit",
    "lint:theme": "node scripts/check_theme_literals.cjs",
    "scan:sast": "node scripts/security_sast_scan.cjs",
    "test:security": "node src/security/inputValidator.test.cjs && node src/security/roleSecurity.test.cjs && node src/security/generatedCodeVerifier.test.cjs && node src/security/hilBuildPolicy.test.cjs && node src/security/hilFlashPolicy.test.cjs && node src/security/hilBuildRecipes.test.cjs && node src/security/hilBuildService.test.cjs && node src/security/elfInspector.test.cjs && node src/security/hilProbeService.test.cjs && node src/security/hilFlashRecipes.test.cjs && node src/security/hilFlashService.test.cjs && node src/security/toolchainHashVerifier.test.cjs && node src/security/offlineToolchainPolicy.test.cjs",
    "test:hil:env": "node scripts/hil_env_doctor.cjs --strict",
    "test:hil:bundle": "node scripts/verify_bundled_hil_toolchains.cjs",
    "test:hil:build-matrix": "node scripts/hil_build_matrix.cjs",
    "test:hil:opt": "node scripts/hil_opt_golden.cjs",
    "test:hil:flash-suite": "node scripts/run_hil_flash_suite.cjs",
    "test:hil:vector-suite": "node scripts/run_hil_vector_suite.cjs",
    "test:hil:all": "npm run test:hil:env && npm run test:security && npm run test:hil:build-matrix && npm run test:hil:opt && npm run test:hil:flash-suite && npm run test:hil:vector-suite",
    "test:project-files": "node src/projectFiles/projectFileService.test.cjs && node src/projectFiles/windowsFileAssociation.test.cjs && node src/projectFiles/squirrelLifecycle.test.cjs && node src/projectFiles/projectFileController.test.cjs",
    "register-associations": "node scripts/register_file_association.cjs",
    "test:vlab": "vitest run src/engine/vlab/vlab_validation.test.ts src/engine/vlab/vlab.test.ts src/engine/vlab/labs_sim.test.ts src/engine/vlab/check_missing_math.test.ts",
    "test:vlab:full": "vitest run src/engine/vlab/vlab_full_certification.test.ts --reporter=verbose",
    "test:vlab:connected": "vitest run src/engine/vlab/vlab_connected_models.test.ts --reporter=verbose",
    "test:vlab:all-blocks": "vitest run src/engine/vlab/test_all_blocks_scope.test.ts --reporter=dot",
    "test:vlab:professional": "tsx scripts/run_vlab_math_test.ts",
    "test:doe": "vitest run src/engine/doe/ src/components/doe/",
    "test:doe:integration": "vitest run src/engine/doe/ src/components/doe/ src/engine/vlab/vlab_connected_models.test.ts src/utils/jsonImportValidator.test.ts",
    "zero-g": "tsx scripts/zero_g_ci.ts",
    "test:opm": "vitest run src/engine/opm src/components/entropy/__tests__ --reporter=verbose",
    "test:opm:codegen": "vitest run src/engine/opm/__tests__/hostCompilation.test.ts src/engine/opm/__tests__/goldenExecution.test.ts src/engine/opm/__tests__/mutationResistance.test.ts --reporter=verbose",
    "test:opm:qualification": "vitest run src/engine/opm/__tests__/runtimeConformance.test.ts src/engine/opm/__tests__/generatorBoundary.test.ts src/engine/opm/__tests__/cGenerator.test.ts --reporter=verbose",
    "test:opm:release": "npm run test:opm && npm run test:opm:codegen && node src/security/opmCodeVerifier.test.cjs && tsc --noEmit",
    "test:sysml:architecture": "tsx scripts/verify_sysml_architecture.ts",
    "test:sysml": "vitest run src/engine/sysml src/components/sysml src/services/sysmlCommandGateway.test.ts src/services/sysmlTransactionAdapter.test.ts src/services/sysmlCreationRules.test.ts src/services/sysmlIntegrityService.test.ts src/services/reportModelConsistency.test.ts --no-file-parallelism",
    "test:sysml:release": "npm run test:sysml && vitest run src/features/reporting --reporter=verbose && tsc --noEmit",
    "test:e2e:sysml": "playwright test tests/e2e",
    "test:sysml:full-release": "tsx scripts/verify_sysml_release.ts",
    "test:sysml:release-gate": "vitest run src/engine/sysml/largeModelBenchmarkGate.test.ts src/engine/sysml/conformanceManifest.test.ts src/engine/sysml/semanticIdentityReleaseGate.test.ts src/engine/sysml/repositoryFirstTreeReleaseGate.test.ts src/engine/sysml/repositoryPresentationReleaseGate.test.ts --reporter=verbose",
    "test:sm:verification": "vitest run src/utils/stateMachine/smTestManifest.test.ts src/utils/stateMachine/smTestPlanBuilder.test.ts src/utils/stateMachine/smCTestRuntimeRenderer.test.ts src/utils/stateMachine/smCTestSuiteRenderer.test.ts src/utils/stateMachine/smCHarness.test.ts src/utils/stateMachine/smCoverageRunner.test.ts src/utils/stateMachine/smDifferential.test.ts src/utils/stateMachine/smAnalysisRunner.test.ts src/utils/stateMachine/smTargetCompileRunner.test.ts src/utils/stateMachine/smPipelineOrchestrator.test.ts src/utils/stateMachine/smReports.test.ts",
    "verify:sm:codegen": "tsx scripts/verify_sm_codegen.ts",
    "verify:repository-codegen-isolation": "vitest run src/utils/stateMachineCodeGenerator.repositoryIsolation.test.ts src/utils/stateMachineCodeGenerator.golden.test.ts && npm run verify:sm:codegen",
    "test:workers": "vitest run src/services/backgroundWorkerClient.test.ts src/services/vlabWorkerClient.test.ts src/services/xbridgesWorkerClient.test.ts src/engine/xbridges/xbridgesWorker.test.ts src/engine/sysml/reportWorker.test.ts src/services/doeWorkerClient.test.ts src/engine/doe/doeWorker.test.ts src/services/hilTelemetryBuffer.test.ts",
    "test:freeze-gate": "playwright test tests/performance/no-renderer-blocking.spec.ts",
    "audit:prebuild": "npm audit --omit=dev --audit-level=high",
    "prebuild": "npm run build:sm-runtime && npm run audit:prebuild"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "external-editor": {
      "tmp": "^0.2.7"
    },
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
    "tar": ">=6.2.1",
    "brace-expansion": ">=1.1.18",
    "jspdf": {
      "dompurify": "^3.4.14"
    }
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dompurify": "^3.0.5",
    "@types/three": "^0.185.4",
    "@xyflow/react": "^12.11.6",
    "bytenode": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "electron-squirrel-startup": "^1.0.1",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mathjs": "^15.2.0",
    "plotly.js": "npm:plotly.js-cartesian-dist-min@3.7.0",
    "plotly.js-gl3d-dist-min": "3.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^2.0.19",
    "recharts": "^2.15.4",
    "serialport": "^12.0.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/jszip": "^3.4.0",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}

{
  "name": "adia",
  "productName": "ADIA",
  "private": true,
  "version": "1.0.0",
  "description": "ADIA Engineering Suite",
  "author": "ADIA Team",
  "type": "module",
  "main": "dist-electron/index.cjs",
  "scripts": {
    "dev": "vite",
    "build:sm-runtime": "tsx scripts/build_state_machine_runtime.ts",
    "build:electron": "npx electron scripts/build_protected_electron.cjs",
    "build": "tsc && vite build && npm run build:electron",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "audit:security": "npm audit --audit-level=high",
    "audit:security:full": "npm audit",
    "scan:sast": "node scripts/security_sast_scan.cjs",
    "test:security": "node src/security/inputValidator.test.cjs && node src/security/roleSecurity.test.cjs && node src/security/generatedCodeVerifier.test.cjs && node src/security/hilBuildPolicy.test.cjs && node src/security/hilFlashPolicy.test.cjs && node src/security/hilBuildRecipes.test.cjs && node src/security/hilBuildService.test.cjs && node src/security/elfInspector.test.cjs && node src/security/hilProbeService.test.cjs && node src/security/hilFlashRecipes.test.cjs && node src/security/hilFlashService.test.cjs && node src/security/toolchainHashVerifier.test.cjs",
    "test:hil:env": "node scripts/hil_env_doctor.cjs",
    "test:hil:build-matrix": "node scripts/hil_build_matrix.cjs",
    "test:hil:opt": "node scripts/hil_opt_golden.cjs",
    "test:hil:flash-suite": "node scripts/run_hil_flash_suite.cjs",
    "test:hil:vector-suite": "node scripts/run_hil_vector_suite.cjs",
    "test:hil:all": "npm run test:hil:env && npm run test:security && npm run test:hil:build-matrix && npm run test:hil:opt && npm run test:hil:flash-suite && npm run test:hil:vector-suite",
    "test:project-files": "node src/projectFiles/projectFileService.test.cjs && node src/projectFiles/windowsFileAssociation.test.cjs && node src/projectFiles/squirrelLifecycle.test.cjs && node src/projectFiles/projectFileController.test.cjs",
    "register-associations": "node scripts/register_file_association.cjs",
    "test:vlab": "vitest run src/engine/vlab/vlab_validation.test.ts src/engine/vlab/vlab.test.ts src/engine/vlab/labs_sim.test.ts src/engine/vlab/check_missing_math.test.ts",
    "test:vlab:full": "vitest run src/engine/vlab/vlab_full_certification.test.ts --reporter=verbose",
    "test:vlab:connected": "vitest run src/engine/vlab/vlab_connected_models.test.ts --reporter=verbose",
    "test:vlab:all-blocks": "vitest run src/engine/vlab/test_all_blocks_scope.test.ts --reporter=dot",
    "test:vlab:professional": "tsx scripts/run_vlab_math_test.ts",
    "test:doe": "vitest run src/engine/doe/ src/components/doe/",
    "test:doe:integration": "vitest run src/engine/doe/ src/components/doe/ src/engine/vlab/vlab_connected_models.test.ts src/utils/jsonImportValidator.test.ts",
    "zero-g": "tsx scripts/zero_g_ci.ts",
    "audit:prebuild": "npm audit --audit-level=critical || echo [WARNING] Unfixable audit vulnerabilities detected (tar, tmp have no upstream fix). Review before production release.",
    "prebuild": "npm run build:sm-runtime && npm run audit:prebuild"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": ">=6.2.1",
    "brace-expansion": ">=1.1.18",
    "jspdf": {
      "dompurify": "^3.4.14"
    }
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dompurify": "^3.0.5",
    "@types/three": "^0.185.4",
    "@xyflow/react": "^12.11.6",
    "bytenode": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "electron-squirrel-startup": "^1.0.1",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mathjs": "^15.2.0",
    "plotly.js": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^2.0.19",
    "recharts": "^2.15.4",
    "serialport": "^12.0.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/jszip": "^3.4.0",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^25.2.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}

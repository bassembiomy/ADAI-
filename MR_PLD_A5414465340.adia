K_13\"},\"verify_int_SD_Immobilizer_Rejected_req_REQ_SEC_06\":{\"id\":\"verify_int_SD_Immobilizer_Rejected_req_REQ_SEC_06\",\"kind\":\"verify\",\"sourceId\":\"int_SD_Immobilizer_Rejected\",\"targetId\":\"req_REQ_SEC_06\"},\"verify_int_SD_Overtemp_Derate_req_REQ_THM_08\":{\"id\":\"verify_int_SD_Overtemp_Derate_req_REQ_THM_08\",\"kind\":\"verify\",\"sourceId\":\"int_SD_Overtemp_Derate\",\"targetId\":\"req_REQ_THM_08\"},\"verify_int_SD_Stop_Afterrun_req_REQ_AFT_18\":{\"id\":\"verify_int_SD_Stop_Afterrun_req_REQ_AFT_18\",\"kind\":\"verify\",\"sourceId\":\"int_SD_Stop_Afterrun\",\"targetId\":\"req_REQ_AFT_18\"},\"verify_vc_PeakHoldCurrentAnalysis_req_REQ_INJ_03\":{\"id\":\"verify_vc_PeakHoldCurrentAnalysis_req_REQ_INJ_03\",\"kind\":\"verify\",\"sourceId\":\"vc_PeakHoldCurrentAnalysis\",\"targetId\":\"req_REQ_INJ_03\"},\"verify_vc_PeakHoldCurrentAnalysis_req_REQ_INJ_04\":{\"id\":\"verify_vc_PeakHoldCurrentAnalysis_req_REQ_INJ_04\",\"kind\":\"verify\",\"sourceId\":\"vc_PeakHoldCurrentAnalysis\",\"targetId\":\"req_REQ_INJ_04\"},\"verify_vc_SensorCalibrationAnalysis_req_REQ_ADC_12\":{\"id\":\"verify_vc_SensorCalibrationAnalysis_req_REQ_ADC_12\",\"kind\":\"verify\",\"sourceId\":\"vc_SensorCalibrationAnalysis\",\"targetId\":\"req_REQ_ADC_12\"},\"verify_vc_SensorCalibrationAnalysis_req_REQ_DIAG_07\":{\"id\":\"verify_vc_SensorCalibrationAnalysis_req_REQ_DIAG_07\",\"kind\":\"verify\",\"sourceId\":\"vc_SensorCalibrationAnalysis\",\"targetId\":\"req_REQ_DIAG_07\"},\"verify_vc_SensorCalibrationAnalysis_req_REQ_PWR_01\":{\"id\":\"verify_vc_SensorCalibrationAnalysis_req_REQ_PWR_01\",\"kind\":\"verify\",\"sourceId\":\"vc_SensorCalibrationAnalysis\",\"targetId\":\"req_REQ_PWR_01\"},\"verify_vc_VC_DualSync_req_REQ_LIMP_09\":{\"id\":\"verify_vc_VC_DualSync_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_DualSync\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_VC_DualSync_req_REQ_SYNC_02\":{\"id\":\"verify_vc_VC_DualSync_req_REQ_SYNC_02\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_DualSync\",\"targetId\":\"req_REQ_SYNC_02\"},\"verify_vc_VC_Immobilizer_req_REQ_SEC_06\":{\"id\":\"verify_vc_VC_Immobilizer_req_REQ_SEC_06\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_Immobilizer\",\"targetId\":\"req_REQ_SEC_06\"},\"verify_vc_VC_PeakHold_req_REQ_INJ_03\":{\"id\":\"verify_vc_VC_PeakHold_req_REQ_INJ_03\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_PeakHold\",\"targetId\":\"req_REQ_INJ_03\"},\"verify_vc_VC_SensorDiag_req_REQ_DIAG_07\":{\"id\":\"verify_vc_VC_SensorDiag_req_REQ_DIAG_07\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_SensorDiag\",\"targetId\":\"req_REQ_DIAG_07\"},\"verify_vc_VC_Smoke_req_REQ_SAF_05\":{\"id\":\"verify_vc_VC_Smoke_req_REQ_SAF_05\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_Smoke\",\"targetId\":\"req_REQ_SAF_05\"},\"verify_vc_VC_Thermal_req_REQ_THM_08\":{\"id\":\"verify_vc_VC_Thermal_req_REQ_THM_08\",\"kind\":\"verify\",\"sourceId\":\"vc_VC_Thermal\",\"targetId\":\"req_REQ_THM_08\"},\"verify_vc_scn01_KeyOff_req_REQ_PWR_01\":{\"id\":\"verify_vc_scn01_KeyOff_req_REQ_PWR_01\",\"kind\":\"verify\",\"sourceId\":\"vc_scn01_KeyOff\",\"targetId\":\"req_REQ_PWR_01\"},\"verify_vc_scn02_IgnitionOn_req_REQ_SEC_06\":{\"id\":\"verify_vc_scn02_IgnitionOn_req_REQ_SEC_06\",\"kind\":\"verify\",\"sourceId\":\"vc_scn02_IgnitionOn\",\"targetId\":\"req_REQ_SEC_06\"},\"verify_vc_scn03_ColdCrank_req_REQ_SEC_06\":{\"id\":\"verify_vc_scn03_ColdCrank_req_REQ_SEC_06\",\"kind\":\"verify\",\"sourceId\":\"vc_scn03_ColdCrank\",\"targetId\":\"req_REQ_SEC_06\"},\"verify_vc_scn03_ColdCrank_req_REQ_SYNC_02\":{\"id\":\"verify_vc_scn03_ColdCrank_req_REQ_SYNC_02\",\"kind\":\"verify\",\"sourceId\":\"vc_scn03_ColdCrank\",\"targetId\":\"req_REQ_SYNC_02\"},\"verify_vc_scn04_NormalRun_req_REQ_FIRE_10\":{\"id\":\"verify_vc_scn04_NormalRun_req_REQ_FIRE_10\",\"kind\":\"verify\",\"sourceId\":\"vc_scn04_NormalRun\",\"targetId\":\"req_REQ_FIRE_10\"},\"verify_vc_scn04_NormalRun_req_REQ_SAF_05\":{\"id\":\"verify_vc_scn04_NormalRun_req_REQ_SAF_05\",\"kind\":\"verify\",\"sourceId\":\"vc_scn04_NormalRun\",\"targetId\":\"req_REQ_SAF_05\"},\"verify_vc_scn05_FullLoad_req_REQ_FIRE_10\":{\"id\":\"verify_vc_scn05_FullLoad_req_REQ_FIRE_10\",\"kind\":\"verify\",\"sourceId\":\"vc_scn05_FullLoad\",\"targetId\":\"req_REQ_FIRE_10\"},\"verify_vc_scn05_FullLoad_req_REQ_SAF_05\":{\"id\":\"verify_vc_scn05_FullLoad_req_REQ_SAF_05\",\"kind\":\"verify\",\"sourceId\":\"vc_scn05_FullLoad\",\"targetId\":\"req_REQ_SAF_05\"},\"verify_vc_scn06_EngineBrake_req_REQ_BRK_13\":{\"id\":\"verify_vc_scn06_EngineBrake_req_REQ_BRK_13\",\"kind\":\"verify\",\"sourceId\":\"vc_scn06_EngineBrake\",\"targetId\":\"req_REQ_BRK_13\"},\"verify_vc_scn07_ImmoMismatch_req_REQ_SEC_06\":{\"id\":\"verify_vc_scn07_ImmoMismatch_req_REQ_SEC_06\",\"kind\":\"verify\",\"sourceId\":\"vc_scn07_ImmoMismatch\",\"targetId\":\"req_REQ_SEC_06\"},\"verify_vc_scn08_CkpLossLimp_req_REQ_LIMP_09\":{\"id\":\"verify_vc_scn08_CkpLossLimp_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_scn08_CkpLossLimp\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_scn09_CmpLossRun_req_REQ_LIMP_09\":{\"id\":\"verify_vc_scn09_CmpLossRun_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_scn09_CmpLossRun\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_scn09_CmpLossRun_req_REQ_SYNC_02\":{\"id\":\"verify_vc_scn09_CmpLossRun_req_REQ_SYNC_02\",\"kind\":\"verify\",\"sourceId\":\"vc_scn09_CmpLossRun\",\"targetId\":\"req_REQ_SYNC_02\"},\"verify_vc_scn10_TotalSyncLoss_req_REQ_SYNC_02\":{\"id\":\"verify_vc_scn10_TotalSyncLoss_req_REQ_SYNC_02\",\"kind\":\"verify\",\"sourceId\":\"vc_scn10_TotalSyncLoss\",\"targetId\":\"req_REQ_SYNC_02\"},\"verify_vc_scn11_Overheat_req_REQ_LIMP_09\":{\"id\":\"verify_vc_scn11_Overheat_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_scn11_Overheat\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_scn11_Overheat_req_REQ_THM_08\":{\"id\":\"verify_vc_scn11_Overheat_req_REQ_THM_08\",\"kind\":\"verify\",\"sourceId\":\"vc_scn11_Overheat\",\"targetId\":\"req_REQ_THM_08\"},\"verify_vc_scn12_Bank1Short_req_REQ_INJ_04\":{\"id\":\"verify_vc_scn12_Bank1Short_req_REQ_INJ_04\",\"kind\":\"verify\",\"sourceId\":\"vc_scn12_Bank1Short\",\"targetId\":\"req_REQ_INJ_04\"},\"verify_vc_scn12_Bank1Short_req_REQ_LIMP_09\":{\"id\":\"verify_vc_scn12_Bank1Short_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_scn12_Bank1Short\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_scn13_CanTimeout_req_REQ_COM_11\":{\"id\":\"verify_vc_scn13_CanTimeout_req_REQ_COM_11\",\"kind\":\"verify\",\"sourceId\":\"vc_scn13_CanTimeout\",\"targetId\":\"req_REQ_COM_11\"},\"verify_vc_scn13_CanTimeout_req_REQ_LIMP_09\":{\"id\":\"verify_vc_scn13_CanTimeout_req_REQ_LIMP_09\",\"kind\":\"verify\",\"sourceId\":\"vc_scn13_CanTimeout\",\"targetId\":\"req_REQ_LIMP_09\"},\"verify_vc_scn14_LowBoostSmoke_req_REQ_FIRE_10\":{\"id\":\"verify_vc_scn14_LowBoostSmoke_req_REQ_FIRE_10\",\"kind\":\"verify\",\"sourceId\":\"vc_scn14_LowBoostSmoke\",\"targetId\":\"req_REQ_FIRE_10\"},\"verify_vc_scn14_LowBoostSmoke_req_REQ_SAF_05\":{\"id\":\"verify_vc_scn14_LowBoostSmoke_req_REQ_SAF_05\",\"kind\":\"verify\",\"sourceId\":\"vc_scn14_LowBoostSmoke\",\"targetId\":\"req_REQ_SAF_05\"}},\"requirements\":{\"req_REQ_ADC_12\":{\"id\":\"req_REQ_ADC_12\",\"kind\":\"requirement\",\"name\":\"AdcResolution\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-ADC-12\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"10-bit ADC on the 5 V reference: code = round(V / 5 x 1023). [require: adcBits == 10]\",\"version\":\"1.0\"},\"req_REQ_ADC_12_1\":{\"id\":\"req_REQ_ADC_12_1\",\"kind\":\"requirement\",\"name\":\"AdcChannels\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-ADC-12.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The SAK-C167CS-LM (U1, MQFP-144) shall convert 24 analogue inputs with 10 bits on the 5 V reference: AN0 boost, AN1 IAT, AN2 ECT, AN3 fuel, AN4 oil P, AN5 oil T, AN6 oil level; battery via 1.8 / 11.8 divider (24 V -> 749).\",\"version\":\"1.0\"},\"req_REQ_ADC_12_2\":{\"id\":\"req_REQ_ADC_12_2\",\"kind\":\"requirement\",\"name\":\"SensorChainBinding\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-ADC-12.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The sensor chain shall bind V_ref = 5.00 V, R_pull-up = 2490 Ohm and R_shunt = 0.033 Ohm to the NTC divider, boost transfer function and shunt-sense constraints.\",\"version\":\"1.0\"},\"req_REQ_AFT_18\":{\"id\":\"req_REQ_AFT_18\",\"kind\":\"requirement\",\"name\":\"AfterRunAndPowerLatch\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-AFT-18\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"After KL.15 off or the engine-block stop button the ECU shall keep its power latch, store DTCs and adaptation values in the EEPROM and only then release the latch and return to standby (ST_AFTERRUN).\",\"version\":\"1.0\"},\"req_REQ_AFT_18_1\":{\"id\":\"req_REQ_AFT_18_1\",\"kind\":\"requirement\",\"name\":\"AfterRunStorage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-AFT-18.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"In after-run the ECU shall write the fault memory and adaptation values to the 93C86 before it releases the power latch.\",\"version\":\"1.0\"},\"req_REQ_BOM_17\":{\"id\":\"req_REQ_BOM_17\",\"kind\":\"requirement\",\"name\":\"ComponentIdentification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-BOM-17\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"Every electronic component shall be identified by reference designator, part number and package type (43 BOM groups, TEMIC PCB 287699.01 B).\",\"version\":\"1.0\"},\"req_REQ_BOM_17_1\":{\"id\":\"req_REQ_BOM_17_1\",\"kind\":\"requirement\",\"name\":\"SubsystemDrivers\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-BOM-17.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The valve and starter drivers shall provide one starter relay output and four proportional-valve outputs through Q_HS3..Q_HS5.\",\"version\":\"1.0\"},\"req_REQ_BRK_13\":{\"id\":\"req_REQ_BRK_13\",\"kind\":\"requirement\",\"name\":\"EngineBrake\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-BRK-13\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"With pedal 0 % and an engine-brake request from FR the ECU shall energise PV1 (constant throttle, X2-51) and PV2 (exhaust-brake flap, X2-50) and cut injection; on release it shall de-energise both and resume injection (ST_ENGINE_BRAKE).\",\"version\":\"1.0\"},\"req_REQ_BRK_13_1\":{\"id\":\"req_REQ_BRK_13_1\",\"kind\":\"requirement\",\"name\":\"EngineBrakeValves\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-BRK-13.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV1 decompression and PV2 exhaust-brake flap shall be energised together while ST_ENGINE_BRAKE is active.\",\"version\":\"1.0\"},\"req_REQ_COM_11\":{\"id\":\"req_REQ_COM_11\",\"kind\":\"requirement\",\"name\":\"CanCommunication\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-COM-11\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"IES-CAN at 250 kbit/s to FR; loss of torque request -> limp torque. [require: bitRate == 250000.0]\",\"version\":\"1.0\"},\"req_REQ_COM_11_1\":{\"id\":\"req_REQ_COM_11_1\",\"kind\":\"requirement\",\"name\":\"CanPhysicalLayer\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The CAN transceivers (PCA82C250 / B10011S class) shall run IES-CAN at 250 kbit/s on X1-1 / X1-2 with 120 Ohm termination per node end (about 60 Ohm on the complete harness).\",\"version\":\"1.0\"},\"req_REQ_COM_11_2\":{\"id\":\"req_REQ_COM_11_2\",\"kind\":\"requirement\",\"name\":\"KLineTransceiver\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The L9637D (U15) shall connect the C167 ASC0 to the K-line X1-13 for ISO 14230 diagnostics and BSL flashing.\",\"version\":\"1.0\"},\"req_REQ_COM_11_3\":{\"id\":\"req_REQ_COM_11_3\",\"kind\":\"requirement\",\"name\":\"CabTorqueRequest\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"FR shall send TorqueRequestFrame (pedal %) and engine-brake requests and receive EngineDataFrame (rpm, coolant, oil pressure) and fault records over IES-CAN.\",\"version\":\"1.0\"},\"req_REQ_COM_11_4\":{\"id\":\"req_REQ_COM_11_4\",\"kind\":\"requirement\",\"name\":\"WorkshopTester\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The diagnostic tester (Star Diagnosis) shall reach the ECU over the K-line X1-13 using ISO 14230 (KWP2000).\",\"version\":\"1.0\"},\"req_REQ_CON_15\":{\"id\":\"req_REQ_CON_15\",\"kind\":\"requirement\",\"name\":\"ConnectorPinout\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-15\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"The ECU shall interface the vehicle through X1 (16-pin cab connector, 2 x 8) and the engine through X2 (55-pin engine connector, 18 + 19 + 18) with the pin functions and test values of the X1_CabConnector16 / X2_EngineConnector55 port definitions.\",\"version\":\"1.0\"},\"req_REQ_CON_15_1\":{\"id\":\"req_REQ_CON_15_1\",\"kind\":\"requirement\",\"name\":\"SystemHarness\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-15.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The OM 501 LA engine harness shall wire 9 sensors, 6 unit pumps, 4 proportional valves and the starter relay to X2, and battery, FR and tester to X1, as in the system IBD.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07\":{\"id\":\"req_REQ_DIAG_07\",\"kind\":\"requirement\",\"name\":\"SensorDiagnosticWindow\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-DIAG-07\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Ratiometric sensors valid 0.25 .. 4.75 V, NTC inputs valid 0.18 .. 4.82 V; outside the window a DTC is stored and the substitute value is used. [require: (vPin < 0.25 or vPin > 4.75) implies faultStored]\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_1\":{\"id\":\"req_REQ_DIAG_07_1\",\"kind\":\"requirement\",\"name\":\"RatiometricBuffer\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2904D op-amps shall buffer the ratiometric inputs into the ADC; valid window 0.25..4.75 V.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_2\":{\"id\":\"req_REQ_DIAG_07_2\",\"kind\":\"requirement\",\"name\":\"NtcDividerNetwork\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each NTC input shall use a 2.49 kOhm 0.1 % pull-up to VAREF with RC low-pass: 2.50 V at 20 C, 0.57 V at 80 C; valid window 0.18..4.82 V.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_3\":{\"id\":\"req_REQ_DIAG_07_3\",\"kind\":\"requirement\",\"name\":\"NtcSensors\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B65 coolant (X2-34), B10 fuel (X2-36), B11 oil (X2-39) and B111-T charge-air (X2-48) temperature sensors shall be NTC 2.5 kOhm at 20 C, 322 Ohm at 80 C.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_4\":{\"id\":\"req_REQ_DIAG_07_4\",\"kind\":\"requirement\",\"name\":\"OilLevelSensor\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B14 thermal oil-level sensor (X2-33 / X2-49) shall be a 18..26 Ohm hot-wire element pulsed at initialisation; DTC 2515 / 2516.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_5\":{\"id\":\"req_REQ_DIAG_07_5\",\"kind\":\"requirement\",\"name\":\"FaultRecord\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Every stored fault shall carry its MR code, J1939 SPN / FMI and severity (CRITICAL, DERATE, WARNING, DRIFT) and be readable over the K-line (X1-13, ISO 14230 / KWP2000).\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_6\":{\"id\":\"req_REQ_DIAG_07_6\",\"kind\":\"requirement\",\"name\":\"SensorIdentification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.6\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Every engine sensor shall carry its reference designator (B15, B16, B65, B10, B11, B14, B110, B111-P, B111-T) and sensing principle.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_7\":{\"id\":\"req_REQ_DIAG_07_7\",\"kind\":\"requirement\",\"name\":\"FaultModeClassification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.7\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each sensor channel shall be classified NORMAL, OPEN, SCG, SCB or DRIFT and switch to its substitute value outside NORMAL (SensorFaultMode).\",\"version\":\"1.0\"},\"req_REQ_FIRE_10\":{\"id\":\"req_REQ_FIRE_10\",\"kind\":\"requirement\",\"name\":\"FiringSequence\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-FIRE-10\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Firing order 1-4-2-5-3-6, 120 deg crank interval. [require: firingIntervalDeg == 120.0]\",\"version\":\"1.0\"},\"req_REQ_FIRE_10_1\":{\"id\":\"req_REQ_FIRE_10_1\",\"kind\":\"requirement\",\"name\":\"CylinderOrder\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-FIRE-10.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Injection shall follow firing order 1-4-2-5-3-6 at 120 deg crank intervals: cylinders 1-3 on bank 1 (X2-16), 4-6 on bank 2 (X2-9).\",\"version\":\"1.0\"},\"req_REQ_FIRE_10_2\":{\"id\":\"req_REQ_FIRE_10_2\",\"kind\":\"requirement\",\"name\":\"ClockReference\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-FIRE-10.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Two 4 MHz crystals shall clock the MCU and the co-processor for the CAPCOM crank-angle timing.\",\"version\":\"1.0\"},\"req_REQ_INJ_03\":{\"id\":\"req_REQ_INJ_03\",\"kind\":\"requirement\",\"name\":\"PeakHoldCurrent\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-INJ-03\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Unit-pump coil current: pull-in 16 A (+-2 A), hold 8 A (+-0.5 A), measured on DALE R033F 0.033 Ohm shunts -> 528 mV / 264 mV. [require: iPeak >= 14.0 and iPeak <= 18.0 and iHold >= 7.5 and iHold <= 8.5]\",\"version\":\"1.0\"},\"req_REQ_INJ_03_1\":{\"id\":\"req_REQ_INJ_03_1\",\"kind\":\"requirement\",\"name\":\"GateSequencing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The PLD_C1.1 CPLD (U3) shall sequence bank high-side and cylinder low-side gates from the CAPCOM start-of-injection trigger and run the peak / BIP / hold / spill micro-cycle.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_2\":{\"id\":\"req_REQ_INJ_03_2\",\"kind\":\"requirement\",\"name\":\"BankHighSide\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The BUZ102SL high-side MOSFETs (D2PAK) shall switch the bank commons X2-16 (cyl 1-3, Q_HS1) and X2-9 (cyl 4-6, Q_HS2), the valve supply (Q_HS3), starter (Q_HS4) and aux (Q_HS5).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_3\":{\"id\":\"req_REQ_INJ_03_3\",\"kind\":\"requirement\",\"name\":\"CylinderLowSide\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Eight SUD25N06-45L low-side MOSFETs shall switch the unit-pump coils: Q_LS1..3 cyl 1-3 (X2-54 / 53 / 47), Q_LS5..7 cyl 4-6 (X2-45 / 44 / 38), Q_LS4 / Q_LS8 cyl 7 / 8 (V8 only).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_4\":{\"id\":\"req_REQ_INJ_03_4\",\"kind\":\"requirement\",\"name\":\"CurrentShunt\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each bank shall measure coil current on a Vishay DALE R033F 0.033 Ohm 1 % shunt: 16 A -> 528 mV, 8 A -> 264 mV, 25 A -> 825 mV.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_5\":{\"id\":\"req_REQ_INJ_03_5\",\"kind\":\"requirement\",\"name\":\"FastDeEnergise\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"At end of injection the freewheel / zener network (SMB + 0805) shall de-energise the coil fast so the valve opens and spills.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_6\":{\"id\":\"req_REQ_INJ_03_6\",\"kind\":\"requirement\",\"name\":\"UnitPumpCoil\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.6\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each PLD unit pump shall have a 0.6 Ohm solenoid (0.4..0.9 Ohm to its bank common through the harness) and 0.30..0.45 mH inductance (TBV).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_7\":{\"id\":\"req_REQ_INJ_03_7\",\"kind\":\"requirement\",\"name\":\"InjectionPowerStageUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.7\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The injection power stage shall group gate CPLD U3, 2 bank high-sides, 8 low-sides, 2 shunts, 3 LM2901D comparators and 8 freewheel networks.\",\"version\":\"1.0\"},\"req_REQ_INJ_04\":{\"id\":\"req_REQ_INJ_04\",\"kind\":\"requirement\",\"name\":\"SolenoidCircuitProtection\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-INJ-04\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Hardware cut-off above 24 A; open coil declared when peak current < 4 A. [require: iCoil > 24.0 implies not driverEnabled]\",\"version\":\"1.0\"},\"req_REQ_INJ_04_1\":{\"id\":\"req_REQ_INJ_04_1\",\"kind\":\"requirement\",\"name\":\"CurrentThresholds\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-04.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2901D comparators shall signal peak (16 A / 528 mV), hold (8 A / 264 mV), overcurrent (24 A / 792 mV) and open coil (< 4 A / 132 mV) to the CPLD.\",\"version\":\"1.0\"},\"req_REQ_INJ_04_2\":{\"id\":\"req_REQ_INJ_04_2\",\"kind\":\"requirement\",\"name\":\"CylinderCutOff\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-04.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On an overcurrent trip or open coil the CPLD shall disable the cylinder driver (CYL_CUTOFF) and a DTC 5Nxx shall be stored (bank 1 51xx..53xx, bank 2 54xx..56xx).\",\"version\":\"1.0\"},\"req_REQ_LIMP_09\":{\"id\":\"req_REQ_LIMP_09\",\"kind\":\"requirement\",\"name\":\"CkpLossLimpHome\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-LIMP-09\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"On CKP loss the engine runs on CMP with engine speed limited to 1800 rpm. [require: (not ckpValid) implies rpm <= 1800.0]\",\"version\":\"1.0\"},\"req_REQ_LIMP_09_1\":{\"id\":\"req_REQ_LIMP_09_1\",\"kind\":\"requirement\",\"name\":\"CmpOnlyTiming\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-LIMP-09.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On CKP loss the MCU shall time injection from the CMP 12 + 1 pattern, limit speed to 1800 rpm and torque to 65 %, report the DTC 0110 / 0111 / 0112 over CAN.\",\"version\":\"1.0\"},\"req_REQ_MEM_14\":{\"id\":\"req_REQ_MEM_14\",\"kind\":\"requirement\",\"name\":\"ProgramAndDataMemory\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"Program and calibration shall reside in a 512 KB bottom-boot flash mapped 0x00000-0x03FFF boot, 0x04000-0x5FFFF code, 0x60000-0x7FEFF data set, 0x7FF00-0x7FFFF checksums; pairing and adaptation data in a 2 KB Microwire EEPROM.\",\"version\":\"1.0\"},\"req_REQ_MEM_14_1\":{\"id\":\"req_REQ_MEM_14_1\",\"kind\":\"requirement\",\"name\":\"FlashMemory\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The AM29F400BB (U2, PSOP-44) shall provide 4 Mbit (512 KB) bottom-boot flash; BSL entry by DQ4 (pin 24) to GND via 1 kOhm at reset (TBV).\",\"version\":\"1.0\"},\"req_REQ_MEM_14_2\":{\"id\":\"req_REQ_MEM_14_2\",\"kind\":\"requirement\",\"name\":\"ComputeCoreUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The compute core shall group MCU U1, co-processor U4, flash U2, EEPROM U5 and two 4 MHz crystals on the external bus and Microwire.\",\"version\":\"1.0\"},\"req_REQ_PWR_01\":{\"id\":\"req_REQ_PWR_01\",\"kind\":\"requirement\",\"name\":\"SupplyRegulation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-PWR-01\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"With KL.30 between 18 V and 32 V the 5 V reference (TLE4275) shall stay within 4.90 .. 5.10 V (TLE4275 datasheet tolerance +-2 %). [assume: vKl30 >= 18.0 and vKl30 <= 32.0; require: vRef >= 4.90 and vRef <= 5.10]\",\"version\":\"1.0\"},\"req_REQ_PWR_01_1\":{\"id\":\"req_REQ_PWR_01_1\",\"kind\":\"requirement\",\"name\":\"BatterySupplyKL30\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The vehicle battery shall supply KL.30 +24 V (24..28 V) on X1-5 (fuse F1) and X1-6 (fuse F2) and KL.31 ground on X1-9 and X1-11.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_2\":{\"id\":\"req_REQ_PWR_01_2\",\"kind\":\"requirement\",\"name\":\"ReferenceRegulator\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The TLE4275 LDO shall deliver 5.00 V +-2 % (4.90..5.10 V), up to 450 mA, with reset output, enabled by the KL.15 wake-up.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_3\":{\"id\":\"req_REQ_PWR_01_3\",\"kind\":\"requirement\",\"name\":\"SupplyFiltering\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The KL.30 input shall be filtered by the S+M 882590 EMI choke (L_FILT1) before the regulator.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_4\":{\"id\":\"req_REQ_PWR_01_4\",\"kind\":\"requirement\",\"name\":\"SensorSupply5V\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The ECU shall supply the ratiometric sensors B110 (X2-6) and B111-P (X2-7) with 5.00 V +-2 % from the reference rail.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_5\":{\"id\":\"req_REQ_PWR_01_5\",\"kind\":\"requirement\",\"name\":\"PowerSupplyAndCommsUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The power-supply and communication subsystem shall group regulator U16, choke L_FILT1, two CAN transceivers and the K-line transceiver U15.\",\"version\":\"1.0\"},\"req_REQ_SAF_05\":{\"id\":\"req_REQ_SAF_05\",\"kind\":\"requirement\",\"name\":\"SmokeLimitation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SAF-05\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Injected quantity limited by boost (and baro / air temperature) map, absolute ceiling 185 mg/stroke. [require: qFuel <= qSmokeMax and qFuel <= 185.0]\",\"version\":\"1.0\"},\"req_REQ_SAF_05_1\":{\"id\":\"req_REQ_SAF_05_1\",\"kind\":\"requirement\",\"name\":\"QuantityComputation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The MCU shall compute q = min(22 + 1.6 pedal %, 55 + 65 (P_boost - 1)) x torqueLimit / 100 mg/stroke and SOI = 11.5 + 0.05 pedal % + cold advance deg BTDC (calibration TBV).\",\"version\":\"1.0\"},\"req_REQ_SAF_05_2\":{\"id\":\"req_REQ_SAF_05_2\",\"kind\":\"requirement\",\"name\":\"BoostPressureSensing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B111-P shall measure charge-air pressure 0.60..3.40 bar abs as 0.50..4.50 V on X2-29 (1.07 V at 1.0 bar, 4.21 V at 3.2 bar); B110 oil pressure 0..5 bar as 0.50..4.50 V on X2-32.\",\"version\":\"1.0\"},\"req_REQ_SAF_05_3\":{\"id\":\"req_REQ_SAF_05_3\",\"kind\":\"requirement\",\"name\":\"BarometricSensing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.3\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The on-board MEMS baro sensor shall measure 0.50..1.15 bar abs as 0.5..4.5 V (3.66 V at 1.013 bar) for the altitude correction (TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06\":{\"id\":\"req_REQ_SEC_06\",\"kind\":\"requirement\",\"name\":\"ImmobilizerInterlock\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SEC-06\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Starter output (X2-18 / X1-12) and injection only after a valid drive-authorisation code from FR matches the 93C86 pairing data. [require: starterOut implies (immoValid and rpm < 300.0)]\",\"version\":\"1.0\"},\"req_REQ_SEC_06_1\":{\"id\":\"req_REQ_SEC_06_1\",\"kind\":\"requirement\",\"name\":\"PairingDataStorage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The 93C86 EEPROM (U5, 16 kbit) shall hold the immobiliser pairing data, the engine number 541.922-00-063818 and device codes 1061 1047 1034 1026 (storage format TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06_2\":{\"id\":\"req_REQ_SEC_06_2\",\"kind\":\"requirement\",\"name\":\"DriveAuthorisation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"FR shall read the transponder on the cab side and send the drive-authorisation code to the MR in an ImmoReleaseFrame over IES-CAN; KL.15 / KL.50 shall reach X1-15 / X1-8.\",\"version\":\"1.0\"},\"req_REQ_SEC_06_3\":{\"id\":\"req_REQ_SEC_06_3\",\"kind\":\"requirement\",\"name\":\"StarterOutput\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The starter relay output (X2-18, parallel X1-12, max 4 A) shall be energised only in ST_CRANK_SYNC, i.e. after authorisation and below 300 rpm.\",\"version\":\"1.0\"},\"req_REQ_SEC_06_4\":{\"id\":\"req_REQ_SEC_06_4\",\"kind\":\"requirement\",\"name\":\"InputSupervision\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.4\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The TEMIC 845AW co-processor (U4, PLCC-68) shall supervise six digital inputs (KL.15, KL.50, block start / stop) and act as watchdog of the MCU (function TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06_5\":{\"id\":\"req_REQ_SEC_06_5\",\"kind\":\"requirement\",\"name\":\"EngineBlockButtons\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The engine-block start (X2-25) and stop (X2-35) buttons, bridged to X2-30, shall start only from ST_READY below 300 rpm and stop the running engine.\",\"version\":\"1.0\"},\"req_REQ_SPEC_00\":{\"id\":\"req_REQ_SPEC_00\",\"kind\":\"requirement\",\"name\":\"mrPldSpecification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"high\",\"requirementId\":\"REQ-SPEC-00\",\"risk\":\"low\",\"status\":\"approved\",\"text\":\"Top-level specification grouping all ECU requirements (subject: MR_PLD_ECU).\",\"version\":\"1.0\"},\"req_REQ_SYNC_02\":{\"id\":\"req_REQ_SYNC_02\",\"kind\":\"requirement\",\"name\":\"DualSyncRedundancy\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SYNC-02\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Injection shall continue on CKP (36 slots + ref) or on CMP (12+1) alone; injection is inhibited only when both are lost. [require: injectionEnabled == (ckpValid or cmpValid)]\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_1\":{\"id\":\"req_REQ_SYNC_02_1\",\"kind\":\"requirement\",\"name\":\"VrZeroCrossing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2903D comparators shall square the VR signals: CKP valid from 1.2 Vpp at cranking up to ~25 Vpp, CMP from 0.9 Vpp.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_2\":{\"id\":\"req_REQ_SYNC_02_2\",\"kind\":\"requirement\",\"name\":\"CrankCamPattern\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B15 (crank, 36 slots + reference, X2-19 / X2-2) and B16 (cam, 12 + 1 teeth, X2-20 / X2-1) shall be inductive VR sensors of 1050..1350 Ohm; f_CKP = 0.6 n, f_CMP = 0.1 n.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_3\":{\"id\":\"req_REQ_SYNC_02_3\",\"kind\":\"requirement\",\"name\":\"CapcomSynchronisation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The C167 CAPCOM (CC0 / CC1) shall synchronise on the CKP reference slot and the CMP sync tooth and keep injecting on either one alone (SyncMode BOTH / CMP_ONLY / CKP_ONLY / NONE).\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_4\":{\"id\":\"req_REQ_SYNC_02_4\",\"kind\":\"requirement\",\"name\":\"SensorFrontEnd\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The analogue front-end shall contain 2 VR comparators, 2 ratiometric buffers, 4 NTC pull-up networks and the on-board baro sensor.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_5\":{\"id\":\"req_REQ_SYNC_02_5\",\"kind\":\"requirement\",\"name\":\"ScenarioCoverage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each simulation scenario shall state key state, pedal, coolant, boost, immobiliser, CKP, CMP, bank-1 short and CAN validity and the expected final operating state.\",\"version\":\"1.0\"},\"req_REQ_THM_08\":{\"id\":\"req_REQ_THM_08\",\"kind\":\"requirement\",\"name\":\"ThermalProtection\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-THM-08\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Fan clutch PV3 PWM from 92 C, 100 % at 100 C; warning and derate from 103 C; hard derate 35 % from 110 C. [require: coolantC >= 110.0 implies torqueLimitPct <= 65.0]\",\"version\":\"1.0\"},\"req_REQ_THM_08_1\":{\"id\":\"req_REQ_THM_08_1\",\"kind\":\"requirement\",\"name\":\"FanClutchControl\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-THM-08.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV3 fan-clutch valve (X2-41 / X1-14) shall be driven by PWM from 92 C, reaching 100 % at 100 C; warning from 103 C.\",\"version\":\"1.0\"},\"req_REQ_THM_08_2\":{\"id\":\"req_REQ_THM_08_2\",\"kind\":\"requirement\",\"name\":\"ProportionalValveCoil\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-THM-08.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV1 (X2-51), PV2 (X2-50), PV3 (X2-41) and PV4 (X2-43) proportional valves shall have 30..50 Ohm coils supplied from X2-12 / X2-52.\",\"version\":\"1.0\"},\"req_REQ_VAR_16\":{\"id\":\"req_REQ_VAR_16\",\"kind\":\"requirement\",\"name\":\"EngineVariants\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-VAR-16\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"The same ECU hardware shall serve OM 501 LA V6 and OM 502 LA V8: 8 low-side drivers populated, cylinder 7 / 8 outputs (X2-46 / X2-37) wired on V8 only.\",\"version\":\"1.0\"},\"req_REQ_VAR_16_1\":{\"id\":\"req_REQ_VAR_16_1\",\"kind\":\"requirement\",\"name\":\"V8Outputs\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-VAR-16.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On OM 502 V8 the harness shall add unit pumps G (cyl 7, X2-46) and H (cyl 8, X2-37); on V6 these pins stay unused.\",\"version\":\"1.0\"}},\"revision\":1357,\"schemaVersion\":5,\"subjects\":{\"subject_MR_PLD_ECU\":{\"id\":\"subject_MR_PLD_ECU\",\"kind\":\"subject\",\"name\":\"MR_PLD_ECU\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"realizedByBlockId\":\"blk_MR_PLD_ECU\",\"representedBlockId\":\"blk_MR_PLD_ECU\"}},\"usages\":{},\"useCases\":{\"uc01\":{\"behaviorArtifactIds\":[],\"description\":\"KL.15 on: power latch, 5 V on, flash / EEPROM checksum, ADC plausibility, B14 oil-level pulse.\",\"extensionPointIds\":[],\"id\":\"uc01\",\"kind\":\"useCase\",\"name\":\"Power up and self-test\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc02\":{\"behaviorArtifactIds\":[\"int_SD_Immobilizer_Rejected\"],\"description\":\"FR sends the drive-authorisation code over IES-CAN; the MR compares it with the 93C86 pairing data.\",\"extensionPointIds\":[],\"id\":\"uc02\",\"kind\":\"useCase\",\"name\":\"Authorise drive (immobiliser)\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc03\":{\"behaviorArtifactIds\":[\"act_EngineStartProcedure\",\"int_SD_Crank_Auth_PeakHold_Injection\"],\"description\":\"KL.50 crank request: starter X2-18 on, synchronisation, start fuel, ramp to idle.\",\"extensionPointIds\":[],\"id\":\"uc03\",\"kind\":\"useCase\",\"name\":\"Crank and start engine\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc04\":{\"behaviorArtifactIds\":[],\"description\":\"Engine-block start (X2-25) and stop (X2-35) buttons bridged to X2-30.\",\"extensionPointIds\":[],\"id\":\"uc04\",\"kind\":\"useCase\",\"name\":\"Start / stop from engine block\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc05\":{\"behaviorArtifactIds\":[],\"description\":\"CAPCOM locks on the CKP reference slot (36 + 1) and the CMP sync tooth (12 + 1).\",\"extensionPointIds\":[],\"id\":\"uc05\",\"kind\":\"useCase\",\"name\":\"Synchronise crank and cam position\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc06\":{\"behaviorArtifactIds\":[\"act_InjectionEvent\"],\"description\":\"Per cylinder in firing order 1-4-2-5-3-6: pull-in 16 A, BIP, hold 8 A, spill.\",\"extensionPointIds\":[\"ep-4b57099e\",\"ep-0b94ad98\",\"ep-e2e4e1d3\",\"ep-dd50e94b\"],\"id\":\"uc06\",\"kind\":\"useCase\",\"name\":\"Inject fuel (peak & hold)\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc07\":{\"behaviorArtifactIds\":[],\"description\":\"Injected quantity limited by the boost map, ceiling 185 mg/stroke.\",\"extensionPointIds\":[],\"id\":\"uc07\",\"kind\":\"useCase\",\"name\":\"Limit smoke\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc08\":{\"behaviorArtifactIds\":[\"int_SD_EngineBrake\"],\"description\":\"Pedal 0 % and request from FR: PV1 + PV2 on, injection cut.\",\"extensionPointIds\":[],\"id\":\"uc08\",\"kind\":\"useCase\",\"name\":\"Apply engine brake\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc09\":{\"behaviorArtifactIds\":[\"int_SD_Overtemp_Derate\"],\"description\":\"PV3 fan clutch from 92 C, warning and derate from 103 C, hard derate from 110 C.\",\"extensionPointIds\":[],\"id\":\"uc09\",\"kind\":\"useCase\",\"name\":\"Protect engine thermally\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc10\":{\"behaviorArtifactIds\":[\"int_SD_CkpLoss_LimpHome\"],\"description\":\"CKP or CMP lost, bank short, CAN timeout or coolant >= 103 C: torque limited, <= 1800 rpm on CMP only.\",\"extensionPointIds\":[\"ep-f52264f9\"],\"id\":\"uc10\",\"kind\":\"useCase\",\"name\":\"Run limp-home\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc11\":{\"behaviorArtifactIds\":[],\"description\":\"CKP and CMP lost: MOSFET matrix tristated, injection stopped.\",\"extensionPointIds\":[],\"id\":\"uc11\",\"kind\":\"useCase\",\"name\":\"Shut down on total sync loss\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc12\":{\"behaviorArtifactIds\":[],\"description\":\"Overcurrent > 24 A or open coil < 4 A: cylinder disabled, DTC 5Nxx.\",\"extensionPointIds\":[],\"id\":\"uc12\",\"kind\":\"useCase\",\"name\":\"Protect solenoid circuits\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc13\":{\"behaviorArtifactIds\":[],\"description\":\"Sensor windows 0.25..4.75 V / 0.18..4.82 V, substitute values, MR code + J1939 SPN / FMI.\",\"extensionPointIds\":[],\"id\":\"uc13\",\"kind\":\"useCase\",\"name\":\"Diagnose sensors and store faults\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc14\":{\"behaviorArtifactIds\":[],\"description\":\"Workshop tester on X1-13, ISO 14230 (KWP2000), BSL flashing.\",\"extensionPointIds\":[],\"id\":\"uc14\",\"kind\":\"useCase\",\"name\":\"Read faults and flash over K-line\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\"uc15\":{\"behaviorArtifactIds\":[],\"description\":\"Torque request and engine data frames with FR at 250 kbit/s.\",\"extensionPointIds\":[],\"id\":\"uc15\",\"kind\":\"useCase\",\"name\":\"Exchange data over IES-CAN\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"14_UseCases\"],\"ownerId\":\"pkg_UseCases\",\"subjectId\":\"subject_MR_PLD_ECU\"},\
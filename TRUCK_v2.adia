dStarterDrivers_req_REQ_BOM_17_1\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_BOM_17_1\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_BOM_17_1\"},\"satisfy_blk_ValveAndStarterDrivers_req_REQ_BRK_13\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_BRK_13\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_BRK_13\"},\"satisfy_blk_ValveAndStarterDrivers_req_REQ_BRK_13_1\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_BRK_13_1\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_BRK_13_1\"},\"satisfy_blk_ValveAndStarterDrivers_req_REQ_SEC_06_3\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_SEC_06_3\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_SEC_06_3\"},\"satisfy_blk_ValveAndStarterDrivers_req_REQ_THM_08\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_THM_08\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_THM_08\"},\"satisfy_blk_ValveAndStarterDrivers_req_REQ_THM_08_1\":{\"id\":\"satisfy_blk_ValveAndStarterDrivers_req_REQ_THM_08_1\",\"kind\":\"satisfy\",\"sourceId\":\"blk_ValveAndStarterDrivers\",\"targetId\":\"req_REQ_THM_08_1\"}},\"requirements\":{\"req-req-ac-01\":{\"id\":\"req-req-ac-01\",\"kind\":\"requirement\",\"name\":\"Climate request execution\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-AC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The air conditioner shall execute the climate requests of the display system within 100 ms and report its climate status on the cabin CAN.\",\"version\":\"1.0\"},\"req-req-asam-01\":{\"id\":\"req-req-asam-01\",\"kind\":\"requirement\",\"name\":\"Sensor acquisition and actuation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ASAM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ASAM shall read the sensors and switches wired to it, drive the actuators wired to it and exchange their states on the cabin CAN.\",\"version\":\"1.0\"},\"req-req-cnt-01\":{\"id\":\"req-req-cnt-01\",\"kind\":\"requirement\",\"name\":\"Speed and engine speed\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the vehicle speed (km/h) and the engine speed (rpm), updated at least 10 times per second.\",\"version\":\"1.0\"},\"req-req-cnt-02\":{\"id\":\"req-req-cnt-02\",\"kind\":\"requirement\",\"name\":\"Gear and cruise control\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the engaged gear, the shift mode (automatic / manual) and the cruise control state and set speed.\",\"version\":\"1.0\"},\"req-req-cnt-03\":{\"id\":\"req-req-cnt-03\",\"kind\":\"requirement\",\"name\":\"Engine operating data\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the coolant temperature and the engine oil pressure.\",\"version\":\"1.0\"},\"req-req-cnt-04\":{\"id\":\"req-req-cnt-04\",\"kind\":\"requirement\",\"name\":\"Odometer and trip\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CNT-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the total distance, two trip distances and the service interval received from the ICUC.\",\"version\":\"1.0\"},\"req-req-cnt-05\":{\"id\":\"req-req-cnt-05\",\"kind\":\"requirement\",\"name\":\"Telltales and warnings\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-CNT-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the brake / ABS / ASR, airbag, engine and transmission telltales and warnings within 200 ms of their reception, in front of any other content.\",\"version\":\"1.0\"},\"req-req-cnt-06\":{\"id\":\"req-req-cnt-06\",\"kind\":\"requirement\",\"name\":\"Telltale start-up and lamp check\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The counters screen shall show the telltales within 2 s of KL15 on and run a lamp check of all telltales.\",\"version\":\"1.0\"},\"req-req-cnt-07\":{\"id\":\"req-req-cnt-07\",\"kind\":\"requirement\",\"name\":\"Missing data indication\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CNT-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"When a displayed value is not received for 1 s, the counters screen shall show it as invalid (---) and indicate a communication fault.\",\"version\":\"1.0\"},\"req-req-com-01\":{\"id\":\"req-req-com-01\",\"kind\":\"requirement\",\"name\":\"Communication loss handling\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-COM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Every controller shall detect the loss of communication with a partner it depends on, store a fault and continue with a defined substitute behaviour.\",\"version\":\"1.0\"},\"req-req-con-00\":{\"id\":\"req-req-con-00\",\"kind\":\"requirement\",\"name\":\"Display connection specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall be connected to the cabin CAN and shall receive the data of every controller listed below, directly on the cabin CAN or routed by the CPC and the CGW.\",\"version\":\"1.0\"},\"req-req-con-01\":{\"id\":\"req-req-con-01\",\"kind\":\"requirement\",\"name\":\"MCM to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall send EngineData (engine speed, coolant temperature, oil pressure, engine warnings) at 10 Hz; CPC routes it from the drivetrain CAN to the frame CAN and CGW to the cabin CAN, to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-02\":{\"id\":\"req-req-con-02\",\"kind\":\"requirement\",\"name\":\"CPC to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall send CruiseControlStatus (state, set speed, accelerator pedal position) at 10 Hz on the frame CAN; CGW routes it to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-03\":{\"id\":\"req-req-con-03\",\"kind\":\"requirement\",\"name\":\"TCM to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall send GearData (engaged gear, target gear, shift mode, transmission warnings) on change and at 10 Hz; CPC and CGW route it to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-04\":{\"id\":\"req-req-con-04\",\"kind\":\"requirement\",\"name\":\"EBS to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall send VehicleSpeed (from the wheel speeds) at 10 Hz and BrakeStatus (ABS / ASR active, brake fault, lining wear) on the frame CAN; CGW routes them to both screens.\",\"version\":\"1.0\"},\"req-req-con-05\":{\"id\":\"req-req-con-05\",\"kind\":\"requirement\",\"name\":\"ICUC to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall send ClusterData (odometer, trips, service interval, telltale and warning list) on the cabin CAN to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-06\":{\"id\":\"req-req-con-06\",\"kind\":\"requirement\",\"name\":\"SRS to counters screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall send AirbagStatus (ready / fault) on the cabin CAN at 1 Hz and on change, to the counters screen.\",\"version\":\"1.0\"},\"req-req-con-07\":{\"id\":\"req-req-con-07\",\"kind\":\"requirement\",\"name\":\"ASAM to entertainment screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ASAM shall send BodyStatus (lights, doors, switches) on the cabin CAN to the entertainment screen and execute the BodyRequest messages it receives from it.\",\"version\":\"1.0\"},\"req-req-con-08\":{\"id\":\"req-req-con-08\",\"kind\":\"requirement\",\"name\":\"CGW to entertainment screen\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-08\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall route the frame CAN data the screens need to the cabin CAN and provide the FaultList of every controller to the entertainment screen.\",\"version\":\"1.0\"},\"req-req-con-09\":{\"id\":\"req-req-con-09\",\"kind\":\"requirement\",\"name\":\"Entertainment screen to air conditioner\",\"namespace\":[],\"ownerId\":\"req-req-con-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-09\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall send ClimateRequest on the cabin CAN on every change; the air conditioner shall answer with ClimateStatus at 1 Hz and on change.\",\"version\":\"1.0\"},\"req-req-cpc-01\":{\"id\":\"req-req-cpc-01\",\"kind\":\"requirement\",\"name\":\"Driver demand acquisition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall read the accelerator pedal position and convert it into the driver torque demand.\",\"version\":\"1.0\"},\"req-req-cpc-02\":{\"id\":\"req-req-cpc-02\",\"kind\":\"requirement\",\"name\":\"Torque coordination\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-CPC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall arbitrate the torque demands of the driver, the TCM and the EBS and send one resulting torque demand to the MCM.\",\"version\":\"1.0\"},\"req-req-dsp-00\":{\"id\":\"req-req-dsp-00\",\"kind\":\"requirement\",\"name\":\"Display system specification\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-DSP-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall present every vehicle feature to the driver on two screens: a counters screen for the driving information and an entertainment screen for media, communication, climate and all other vehicle features.\",\"version\":\"1.0\"},\"req-req-dsp-01\":{\"id\":\"req-req-dsp-01\",\"kind\":\"requirement\",\"name\":\"Two-screen display system\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall consist of a counters screen in front of the driver and an entertainment screen in the centre of the dashboard.\",\"version\":\"1.0\"},\"req-req-dsp-02\":{\"id\":\"req-req-dsp-02\",\"kind\":\"requirement\",\"name\":\"Single access to vehicle features\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Every vehicle feature the driver can see or set shall be reachable from the display system: driving information on the counters screen, all other features from the vehicle menu of the entertainment screen.\",\"version\":\"1.0\"},\"req-req-dsp-03\":{\"id\":\"req-req-dsp-03\",\"kind\":\"requirement\",\"name\":\"Power and wake-up\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall operate from the 24 V supply between 16 V and 32 V and shall wake up on KL15 on or on cabin CAN activity.\",\"version\":\"1.0\"},\"req-req-dsp-04\":{\"id\":\"req-req-dsp-04\",\"kind\":\"requirement\",\"name\":\"Day and night mode\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-DSP-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Both screens shall adapt their brightness to the ambient light and switch to a night colour scheme when the vehicle lights are on.\",\"version\":\"1.0\"},\"req-req-ebs-01\":{\"id\":\"req-req-ebs-01\",\"kind\":\"requirement\",\"name\":\"Electronic service braking\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall control the brake pressure electronically according to the brake demand of the driver.\",\"version\":\"1.0\"},\"req-req-ebs-02\":{\"id\":\"req-req-ebs-02\",\"kind\":\"requirement\",\"name\":\"Wheel slip control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-EBS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall prevent wheel lock under braking (ABS) and drive wheel spin under traction (ASR).\",\"version\":\"1.0\"},\"req-req-ebs-03\":{\"id\":\"req-req-ebs-03\",\"kind\":\"requirement\",\"name\":\"Brake torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-EBS-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The EBS shall request the engine torque limitation and the engine brake it needs from the CPC over the frame CAN.\",\"version\":\"1.0\"},\"req-req-ent-01\":{\"id\":\"req-req-ent-01\",\"kind\":\"requirement\",\"name\":\"Media\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall play radio (FM / DAB), USB and Bluetooth audio.\",\"version\":\"1.0\"},\"req-req-ent-02\":{\"id\":\"req-req-ent-02\",\"kind\":\"requirement\",\"name\":\"Hands-free telephone\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall provide Bluetooth hands-free calls and show incoming calls also on the counters screen.\",\"version\":\"1.0\"},\"req-req-ent-03\":{\"id\":\"req-req-ent-03\",\"kind\":\"requirement\",\"name\":\"Navigation\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall provide truck navigation and send the turn guidance to the counters screen.\",\"version\":\"1.0\"},\"req-req-ent-04\":{\"id\":\"req-req-ent-04\",\"kind\":\"requirement\",\"name\":\"Climate control\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ENT-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall control the air conditioner: AC on/off, auto mode, set temperature 16 to 28 °C in 0.5 °C steps, fan level 1 to 7, recirculation, defrost and air distribution, and shall show the climate status.\",\"version\":\"1.0\"},\"req-req-ent-05\":{\"id\":\"req-req-ent-05\",\"kind\":\"requirement\",\"name\":\"Vehicle settings\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-05\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall show and set the body functions (lights, doors, switches) handled by the ASAM.\",\"version\":\"1.0\"},\"req-req-ent-06\":{\"id\":\"req-req-ent-06\",\"kind\":\"requirement\",\"name\":\"Fault list\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ENT-06\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The entertainment screen shall show the active faults of every controller, read through the CGW.\",\"version\":\"1.0\"},\"req-req-ent-07\":{\"id\":\"req-req-ent-07\",\"kind\":\"requirement\",\"name\":\"Driver distraction lockout\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ENT-07\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Above 5 km/h the entertainment screen shall block video playback and text entry.\",\"version\":\"1.0\"},\"req-req-icuc-01\":{\"id\":\"req-req-icuc-01\",\"kind\":\"requirement\",\"name\":\"Driver information\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-ICUC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall display the vehicle speed, the engine speed, the engaged gear and the operating data it receives over the cabin CAN.\",\"version\":\"1.0\"},\"req-req-icuc-02\":{\"id\":\"req-req-icuc-02\",\"kind\":\"requirement\",\"name\":\"Warning indication\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-ICUC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The ICUC shall indicate the warnings and faults reported by the other controllers to the driver.\",\"version\":\"1.0\"},\"req-req-mcm-01\":{\"id\":\"req-req-mcm-01\",\"kind\":\"requirement\",\"name\":\"Engine torque control\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-MCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall control the engine so that it delivers the torque demanded by the CPC.\",\"version\":\"1.0\"},\"req-req-mcm-02\":{\"id\":\"req-req-mcm-02\",\"kind\":\"requirement\",\"name\":\"Engine status reporting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-MCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The MCM shall report the engine speed, the actual engine torque and the engine status on the drivetrain CAN.\",\"version\":\"1.0\"},\"req-req-net-01\":{\"id\":\"req-req-net-01\",\"kind\":\"requirement\",\"name\":\"Network segmentation\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The controllers shall communicate over three separated CAN segments: the drivetrain CAN (MCM, CPC, TCM), the frame CAN (CPC, EBS, CGW) and the cabin CAN (CGW, ASAM, ICUC, SRS).\",\"version\":\"1.0\"},\"req-req-net-02\":{\"id\":\"req-req-net-02\",\"kind\":\"requirement\",\"name\":\"Central gateway routing\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall route the messages needed by controllers of another segment between the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-net-03\":{\"id\":\"req-req-net-03\",\"kind\":\"requirement\",\"name\":\"Drivetrain gateway\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CPC shall be the only link between the drivetrain CAN and the frame CAN and shall route powertrain data between them.\",\"version\":\"1.0\"},\"req-req-net-04\":{\"id\":\"req-req-net-04\",\"kind\":\"requirement\",\"name\":\"Diagnostic access\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-NET-04\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The CGW shall give a diagnostic tester access to the fault memory of every controller on the frame CAN and the cabin CAN.\",\"version\":\"1.0\"},\"req-req-pt-01\":{\"id\":\"req-req-pt-01\",\"kind\":\"requirement\",\"name\":\"Power train composition\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-PT-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The power train shall consist of the engine control (MCM), the powertrain coordination (CPC) and the transmission control (TCM).\",\"version\":\"1.0\"},\"req-req-spc-01\":{\"id\":\"req-req-spc-01\",\"kind\":\"requirement\",\"name\":\"Counters screen specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Counters screen: 12.3 in, 1920 x 720 px, at least 1000 cd/m², contrast 1000:1, 60 Hz, -40 to +85 °C, telltales ASIL B (ISO 26262).\",\"version\":\"1.0\"},\"req-req-spc-02\":{\"id\":\"req-req-spc-02\",\"kind\":\"requirement\",\"name\":\"Entertainment screen specification\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Entertainment screen: 10.25 in, 1920 x 720 px, projected-capacitive multi-touch usable with gloves, at least 800 cd/m², touch response at most 100 ms, -30 to +85 °C, Bluetooth 5, Wi-Fi, 2 x USB-C, 4 x 25 W audio.\",\"version\":\"1.0\"},\"req-req-spc-03\":{\"id\":\"req-req-spc-03\",\"kind\":\"requirement\",\"name\":\"Display network interface\",\"namespace\":[],\"ownerId\":\"req-req-dsp-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-SPC-03\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The display system shall be connected to the cabin CAN at 500 kbit/s; the two screens shall be joined by a display link for shared content.\",\"version\":\"1.0\"},\"req-req-srs-01\":{\"id\":\"req-req-srs-01\",\"kind\":\"requirement\",\"name\":\"Restraint deployment\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"critical\",\"requirementId\":\"REQ-SRS-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall detect a crash and deploy the air bag.\",\"version\":\"1.0\"},\"req-req-srs-02\":{\"id\":\"req-req-srs-02\",\"kind\":\"requirement\",\"name\":\"Restraint system monitoring\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-SRS-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The SRS shall monitor its firing circuits and sensors and report a fault on the cabin CAN for indication by the ICUC.\",\"version\":\"1.0\"},\"req-req-tcm-01\":{\"id\":\"req-req-tcm-01\",\"kind\":\"requirement\",\"name\":\"Automated gear shifting\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-TCM-01\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall select the gear and execute the gear changes of the automated (PowerShift) transmission.\",\"version\":\"1.0\"},\"req-req-tcm-02\":{\"id\":\"req-req-tcm-02\",\"kind\":\"requirement\",\"name\":\"Shift torque intervention\",\"namespace\":[],\"ownerId\":\"req-req-trk-00\",\"priority\":\"medium\",\"requirementId\":\"REQ-TCM-02\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"The TCM shall request the engine torque and engine speed it needs during a gear change from the CPC.\",\"version\":\"1.0\"},\"req-req-trk-00\":{\"id\":\"req-req-trk-00\",\"kind\":\"requirement\",\"name\":\"Truck controller specification\",\"namespace\":[],\"ownerId\":\"pkg-truck-requirements\",\"priority\":\"high\",\"requirementId\":\"REQ-TRK-00\",\"risk\":\"low\",\"source\":\"Engineering proposal from the controller BDD - to be confirmed\",\"status\":\"draft\",\"text\":\"Specification of the main controllers of the truck: power train (MCM, CPC, TCM), EBS, CGW, ASAM, ICUC, SRS, the display system and the air conditioner.\",\"version\":\"1.0\"},\"req_REQ_ADC_12\":{\"id\":\"req_REQ_ADC_12\",\"kind\":\"requirement\",\"name\":\"AdcResolution\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-ADC-12\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"10-bit ADC on the 5 V reference: code = round(V / 5 x 1023). [require: adcBits == 10]\",\"version\":\"1.0\"},\"req_REQ_ADC_12_1\":{\"id\":\"req_REQ_ADC_12_1\",\"kind\":\"requirement\",\"name\":\"AdcChannels\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-ADC-12.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The SAK-C167CS-LM (U1, MQFP-144) shall convert 24 analogue inputs with 10 bits on the 5 V reference: AN0 boost, AN1 IAT, AN2 ECT, AN3 fuel, AN4 oil P, AN5 oil T, AN6 oil level; battery via 1.8 / 11.8 divider (24 V -> 749).\",\"version\":\"1.0\"},\"req_REQ_ADC_12_2\":{\"id\":\"req_REQ_ADC_12_2\",\"kind\":\"requirement\",\"name\":\"SensorChainBinding\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-ADC-12.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The sensor chain shall bind V_ref = 5.00 V, R_pull-up = 2490 Ohm and R_shunt = 0.033 Ohm to the NTC divider, boost transfer function and shunt-sense constraints.\",\"version\":\"1.0\"},\"req_REQ_AFT_18\":{\"id\":\"req_REQ_AFT_18\",\"kind\":\"requirement\",\"name\":\"AfterRunAndPowerLatch\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-AFT-18\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"After KL.15 off or the engine-block stop button the ECU shall keep its power latch, store DTCs and adaptation values in the EEPROM and only then release the latch and return to standby (ST_AFTERRUN).\",\"version\":\"1.0\"},\"req_REQ_AFT_18_1\":{\"id\":\"req_REQ_AFT_18_1\",\"kind\":\"requirement\",\"name\":\"AfterRunStorage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-AFT-18.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"In after-run the ECU shall write the fault memory and adaptation values to the 93C86 before it releases the power latch.\",\"version\":\"1.0\"},\"req_REQ_BOM_17\":{\"id\":\"req_REQ_BOM_17\",\"kind\":\"requirement\",\"name\":\"ComponentIdentification\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-BOM-17\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"Every electronic component shall be identified by reference designator, part number and package type (43 BOM groups, TEMIC PCB 287699.01 B).\",\"version\":\"1.0\"},\"req_REQ_BOM_17_1\":{\"id\":\"req_REQ_BOM_17_1\",\"kind\":\"requirement\",\"name\":\"SubsystemDrivers\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-BOM-17.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The valve and starter drivers shall provide one starter relay output and four proportional-valve outputs through Q_HS3..Q_HS5.\",\"version\":\"1.0\"},\"req_REQ_BRK_13\":{\"id\":\"req_REQ_BRK_13\",\"kind\":\"requirement\",\"name\":\"EngineBrake\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-BRK-13\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"With pedal 0 % and an engine-brake request from FR the ECU shall energise PV1 (constant throttle, X2-51) and PV2 (exhaust-brake flap, X2-50) and cut injection; on release it shall de-energise both and resume injection (ST_ENGINE_BRAKE).\",\"version\":\"1.0\"},\"req_REQ_BRK_13_1\":{\"id\":\"req_REQ_BRK_13_1\",\"kind\":\"requirement\",\"name\":\"EngineBrakeValves\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-BRK-13.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV1 decompression and PV2 exhaust-brake flap shall be energised together while ST_ENGINE_BRAKE is active.\",\"version\":\"1.0\"},\"req_REQ_COM_11\":{\"id\":\"req_REQ_COM_11\",\"kind\":\"requirement\",\"name\":\"CanCommunication\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-COM-11\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"IES-CAN at 250 kbit/s to FR; loss of torque request -> limp torque. [require: bitRate == 250000.0]\",\"version\":\"1.0\"},\"req_REQ_COM_11_1\":{\"id\":\"req_REQ_COM_11_1\",\"kind\":\"requirement\",\"name\":\"CanPhysicalLayer\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The CAN transceivers (PCA82C250 / B10011S class) shall run IES-CAN at 250 kbit/s on X1-1 / X1-2 with 120 Ohm termination per node end (about 60 Ohm on the complete harness).\",\"version\":\"1.0\"},\"req_REQ_COM_11_2\":{\"id\":\"req_REQ_COM_11_2\",\"kind\":\"requirement\",\"name\":\"KLineTransceiver\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The L9637D (U15) shall connect the C167 ASC0 to the K-line X1-13 for ISO 14230 diagnostics and BSL flashing.\",\"version\":\"1.0\"},\"req_REQ_COM_11_3\":{\"id\":\"req_REQ_COM_11_3\",\"kind\":\"requirement\",\"name\":\"CabTorqueRequest\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"FR shall send TorqueRequestFrame (pedal %) and engine-brake requests and receive EngineDataFrame (rpm, coolant, oil pressure) and fault records over IES-CAN.\",\"version\":\"1.0\"},\"req_REQ_COM_11_4\":{\"id\":\"req_REQ_COM_11_4\",\"kind\":\"requirement\",\"name\":\"WorkshopTester\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-COM-11.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The diagnostic tester (Star Diagnosis) shall reach the ECU over the K-line X1-13 using ISO 14230 (KWP2000).\",\"version\":\"1.0\"},\"req_REQ_CON_15\":{\"id\":\"req_REQ_CON_15\",\"kind\":\"requirement\",\"name\":\"ConnectorPinout\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-15\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"The ECU shall interface the vehicle through X1 (16-pin cab connector, 2 x 8) and the engine through X2 (55-pin engine connector, 18 + 19 + 18) with the pin functions and test values of the X1_CabConnector16 / X2_EngineConnector55 port definitions.\",\"version\":\"1.0\"},\"req_REQ_CON_15_1\":{\"id\":\"req_REQ_CON_15_1\",\"kind\":\"requirement\",\"name\":\"SystemHarness\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-CON-15.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The OM 501 LA engine harness shall wire 9 sensors, 6 unit pumps, 4 proportional valves and the starter relay to X2, and battery, FR and tester to X1, as in the system IBD.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07\":{\"id\":\"req_REQ_DIAG_07\",\"kind\":\"requirement\",\"name\":\"SensorDiagnosticWindow\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-DIAG-07\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Ratiometric sensors valid 0.25 .. 4.75 V, NTC inputs valid 0.18 .. 4.82 V; outside the window a DTC is stored and the substitute value is used. [require: (vPin < 0.25 or vPin > 4.75) implies faultStored]\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_1\":{\"id\":\"req_REQ_DIAG_07_1\",\"kind\":\"requirement\",\"name\":\"RatiometricBuffer\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2904D op-amps shall buffer the ratiometric inputs into the ADC; valid window 0.25..4.75 V.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_2\":{\"id\":\"req_REQ_DIAG_07_2\",\"kind\":\"requirement\",\"name\":\"NtcDividerNetwork\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each NTC input shall use a 2.49 kOhm 0.1 % pull-up to VAREF with RC low-pass: 2.50 V at 20 C, 0.57 V at 80 C; valid window 0.18..4.82 V.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_3\":{\"id\":\"req_REQ_DIAG_07_3\",\"kind\":\"requirement\",\"name\":\"NtcSensors\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B65 coolant (X2-34), B10 fuel (X2-36), B11 oil (X2-39) and B111-T charge-air (X2-48) temperature sensors shall be NTC 2.5 kOhm at 20 C, 322 Ohm at 80 C.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_4\":{\"id\":\"req_REQ_DIAG_07_4\",\"kind\":\"requirement\",\"name\":\"OilLevelSensor\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B14 thermal oil-level sensor (X2-33 / X2-49) shall be a 18..26 Ohm hot-wire element pulsed at initialisation; DTC 2515 / 2516.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_5\":{\"id\":\"req_REQ_DIAG_07_5\",\"kind\":\"requirement\",\"name\":\"FaultRecord\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Every stored fault shall carry its MR code, J1939 SPN / FMI and severity (CRITICAL, DERATE, WARNING, DRIFT) and be readable over the K-line (X1-13, ISO 14230 / KWP2000).\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_6\":{\"id\":\"req_REQ_DIAG_07_6\",\"kind\":\"requirement\",\"name\":\"SensorIdentification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.6\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Every engine sensor shall carry its reference designator (B15, B16, B65, B10, B11, B14, B110, B111-P, B111-T) and sensing principle.\",\"version\":\"1.0\"},\"req_REQ_DIAG_07_7\":{\"id\":\"req_REQ_DIAG_07_7\",\"kind\":\"requirement\",\"name\":\"FaultModeClassification\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-DIAG-07.7\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each sensor channel shall be classified NORMAL, OPEN, SCG, SCB or DRIFT and switch to its substitute value outside NORMAL (SensorFaultMode).\",\"version\":\"1.0\"},\"req_REQ_FIRE_10\":{\"id\":\"req_REQ_FIRE_10\",\"kind\":\"requirement\",\"name\":\"FiringSequence\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-FIRE-10\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Firing order 1-4-2-5-3-6, 120 deg crank interval. [require: firingIntervalDeg == 120.0]\",\"version\":\"1.0\"},\"req_REQ_FIRE_10_1\":{\"id\":\"req_REQ_FIRE_10_1\",\"kind\":\"requirement\",\"name\":\"CylinderOrder\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-FIRE-10.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Injection shall follow firing order 1-4-2-5-3-6 at 120 deg crank intervals: cylinders 1-3 on bank 1 (X2-16), 4-6 on bank 2 (X2-9).\",\"version\":\"1.0\"},\"req_REQ_FIRE_10_2\":{\"id\":\"req_REQ_FIRE_10_2\",\"kind\":\"requirement\",\"name\":\"ClockReference\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-FIRE-10.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Two 4 MHz crystals shall clock the MCU and the co-processor for the CAPCOM crank-angle timing.\",\"version\":\"1.0\"},\"req_REQ_INJ_03\":{\"id\":\"req_REQ_INJ_03\",\"kind\":\"requirement\",\"name\":\"PeakHoldCurrent\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-INJ-03\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Unit-pump coil current: pull-in 16 A (+-2 A), hold 8 A (+-0.5 A), measured on DALE R033F 0.033 Ohm shunts -> 528 mV / 264 mV. [require: iPeak >= 14.0 and iPeak <= 18.0 and iHold >= 7.5 and iHold <= 8.5]\",\"version\":\"1.0\"},\"req_REQ_INJ_03_1\":{\"id\":\"req_REQ_INJ_03_1\",\"kind\":\"requirement\",\"name\":\"GateSequencing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The PLD_C1.1 CPLD (U3) shall sequence bank high-side and cylinder low-side gates from the CAPCOM start-of-injection trigger and run the peak / BIP / hold / spill micro-cycle.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_2\":{\"id\":\"req_REQ_INJ_03_2\",\"kind\":\"requirement\",\"name\":\"BankHighSide\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The BUZ102SL high-side MOSFETs (D2PAK) shall switch the bank commons X2-16 (cyl 1-3, Q_HS1) and X2-9 (cyl 4-6, Q_HS2), the valve supply (Q_HS3), starter (Q_HS4) and aux (Q_HS5).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_3\":{\"id\":\"req_REQ_INJ_03_3\",\"kind\":\"requirement\",\"name\":\"CylinderLowSide\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Eight SUD25N06-45L low-side MOSFETs shall switch the unit-pump coils: Q_LS1..3 cyl 1-3 (X2-54 / 53 / 47), Q_LS5..7 cyl 4-6 (X2-45 / 44 / 38), Q_LS4 / Q_LS8 cyl 7 / 8 (V8 only).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_4\":{\"id\":\"req_REQ_INJ_03_4\",\"kind\":\"requirement\",\"name\":\"CurrentShunt\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each bank shall measure coil current on a Vishay DALE R033F 0.033 Ohm 1 % shunt: 16 A -> 528 mV, 8 A -> 264 mV, 25 A -> 825 mV.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_5\":{\"id\":\"req_REQ_INJ_03_5\",\"kind\":\"requirement\",\"name\":\"FastDeEnergise\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"At end of injection the freewheel / zener network (SMB + 0805) shall de-energise the coil fast so the valve opens and spills.\",\"version\":\"1.0\"},\"req_REQ_INJ_03_6\":{\"id\":\"req_REQ_INJ_03_6\",\"kind\":\"requirement\",\"name\":\"UnitPumpCoil\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.6\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each PLD unit pump shall have a 0.6 Ohm solenoid (0.4..0.9 Ohm to its bank common through the harness) and 0.30..0.45 mH inductance (TBV).\",\"version\":\"1.0\"},\"req_REQ_INJ_03_7\":{\"id\":\"req_REQ_INJ_03_7\",\"kind\":\"requirement\",\"name\":\"InjectionPowerStageUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-03.7\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The injection power stage shall group gate CPLD U3, 2 bank high-sides, 8 low-sides, 2 shunts, 3 LM2901D comparators and 8 freewheel networks.\",\"version\":\"1.0\"},\"req_REQ_INJ_04\":{\"id\":\"req_REQ_INJ_04\",\"kind\":\"requirement\",\"name\":\"SolenoidCircuitProtection\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-INJ-04\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Hardware cut-off above 24 A; open coil declared when peak current < 4 A. [require: iCoil > 24.0 implies not driverEnabled]\",\"version\":\"1.0\"},\"req_REQ_INJ_04_1\":{\"id\":\"req_REQ_INJ_04_1\",\"kind\":\"requirement\",\"name\":\"CurrentThresholds\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-04.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2901D comparators shall signal peak (16 A / 528 mV), hold (8 A / 264 mV), overcurrent (24 A / 792 mV) and open coil (< 4 A / 132 mV) to the CPLD.\",\"version\":\"1.0\"},\"req_REQ_INJ_04_2\":{\"id\":\"req_REQ_INJ_04_2\",\"kind\":\"requirement\",\"name\":\"CylinderCutOff\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-INJ-04.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On an overcurrent trip or open coil the CPLD shall disable the cylinder driver (CYL_CUTOFF) and a DTC 5Nxx shall be stored (bank 1 51xx..53xx, bank 2 54xx..56xx).\",\"version\":\"1.0\"},\"req_REQ_LIMP_09\":{\"id\":\"req_REQ_LIMP_09\",\"kind\":\"requirement\",\"name\":\"CkpLossLimpHome\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-LIMP-09\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"On CKP loss the engine runs on CMP with engine speed limited to 1800 rpm. [require: (not ckpValid) implies rpm <= 1800.0]\",\"version\":\"1.0\"},\"req_REQ_LIMP_09_1\":{\"id\":\"req_REQ_LIMP_09_1\",\"kind\":\"requirement\",\"name\":\"CmpOnlyTiming\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-LIMP-09.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On CKP loss the MCU shall time injection from the CMP 12 + 1 pattern, limit speed to 1800 rpm and torque to 65 %, report the DTC 0110 / 0111 / 0112 over CAN.\",\"version\":\"1.0\"},\"req_REQ_MEM_14\":{\"id\":\"req_REQ_MEM_14\",\"kind\":\"requirement\",\"name\":\"ProgramAndDataMemory\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"Program and calibration shall reside in a 512 KB bottom-boot flash mapped 0x00000-0x03FFF boot, 0x04000-0x5FFFF code, 0x60000-0x7FEFF data set, 0x7FF00-0x7FFFF checksums; pairing and adaptation data in a 2 KB Microwire EEPROM.\",\"version\":\"1.0\"},\"req_REQ_MEM_14_1\":{\"id\":\"req_REQ_MEM_14_1\",\"kind\":\"requirement\",\"name\":\"FlashMemory\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The AM29F400BB (U2, PSOP-44) shall provide 4 Mbit (512 KB) bottom-boot flash; BSL entry by DQ4 (pin 24) to GND via 1 kOhm at reset (TBV).\",\"version\":\"1.0\"},\"req_REQ_MEM_14_2\":{\"id\":\"req_REQ_MEM_14_2\",\"kind\":\"requirement\",\"name\":\"ComputeCoreUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-MEM-14.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The compute core shall group MCU U1, co-processor U4, flash U2, EEPROM U5 and two 4 MHz crystals on the external bus and Microwire.\",\"version\":\"1.0\"},\"req_REQ_PWR_01\":{\"id\":\"req_REQ_PWR_01\",\"kind\":\"requirement\",\"name\":\"SupplyRegulation\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-PWR-01\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"With KL.30 between 18 V and 32 V the 5 V reference (TLE4275) shall stay within 4.90 .. 5.10 V (TLE4275 datasheet tolerance +-2 %). [assume: vKl30 >= 18.0 and vKl30 <= 32.0; require: vRef >= 4.90 and vRef <= 5.10]\",\"version\":\"1.0\"},\"req_REQ_PWR_01_1\":{\"id\":\"req_REQ_PWR_01_1\",\"kind\":\"requirement\",\"name\":\"BatterySupplyKL30\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The vehicle battery shall supply KL.30 +24 V (24..28 V) on X1-5 (fuse F1) and X1-6 (fuse F2) and KL.31 ground on X1-9 and X1-11.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_2\":{\"id\":\"req_REQ_PWR_01_2\",\"kind\":\"requirement\",\"name\":\"ReferenceRegulator\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The TLE4275 LDO shall deliver 5.00 V +-2 % (4.90..5.10 V), up to 450 mA, with reset output, enabled by the KL.15 wake-up.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_3\":{\"id\":\"req_REQ_PWR_01_3\",\"kind\":\"requirement\",\"name\":\"SupplyFiltering\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The KL.30 input shall be filtered by the S+M 882590 EMI choke (L_FILT1) before the regulator.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_4\":{\"id\":\"req_REQ_PWR_01_4\",\"kind\":\"requirement\",\"name\":\"SensorSupply5V\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The ECU shall supply the ratiometric sensors B110 (X2-6) and B111-P (X2-7) with 5.00 V +-2 % from the reference rail.\",\"version\":\"1.0\"},\"req_REQ_PWR_01_5\":{\"id\":\"req_REQ_PWR_01_5\",\"kind\":\"requirement\",\"name\":\"PowerSupplyAndCommsUnit\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-PWR-01.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The power-supply and communication subsystem shall group regulator U16, choke L_FILT1, two CAN transceivers and the K-line transceiver U15.\",\"version\":\"1.0\"},\"req_REQ_SAF_05\":{\"id\":\"req_REQ_SAF_05\",\"kind\":\"requirement\",\"name\":\"SmokeLimitation\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SAF-05\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Injected quantity limited by boost (and baro / air temperature) map, absolute ceiling 185 mg/stroke. [require: qFuel <= qSmokeMax and qFuel <= 185.0]\",\"version\":\"1.0\"},\"req_REQ_SAF_05_1\":{\"id\":\"req_REQ_SAF_05_1\",\"kind\":\"requirement\",\"name\":\"QuantityComputation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The MCU shall compute q = min(22 + 1.6 pedal %, 55 + 65 (P_boost - 1)) x torqueLimit / 100 mg/stroke and SOI = 11.5 + 0.05 pedal % + cold advance deg BTDC (calibration TBV).\",\"version\":\"1.0\"},\"req_REQ_SAF_05_2\":{\"id\":\"req_REQ_SAF_05_2\",\"kind\":\"requirement\",\"name\":\"BoostPressureSensing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B111-P shall measure charge-air pressure 0.60..3.40 bar abs as 0.50..4.50 V on X2-29 (1.07 V at 1.0 bar, 4.21 V at 3.2 bar); B110 oil pressure 0..5 bar as 0.50..4.50 V on X2-32.\",\"version\":\"1.0\"},\"req_REQ_SAF_05_3\":{\"id\":\"req_REQ_SAF_05_3\",\"kind\":\"requirement\",\"name\":\"BarometricSensing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SAF-05.3\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The on-board MEMS baro sensor shall measure 0.50..1.15 bar abs as 0.5..4.5 V (3.66 V at 1.013 bar) for the altitude correction (TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06\":{\"id\":\"req_REQ_SEC_06\",\"kind\":\"requirement\",\"name\":\"ImmobilizerInterlock\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SEC-06\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Starter output (X2-18 / X1-12) and injection only after a valid drive-authorisation code from FR matches the 93C86 pairing data. [require: starterOut implies (immoValid and rpm < 300.0)]\",\"version\":\"1.0\"},\"req_REQ_SEC_06_1\":{\"id\":\"req_REQ_SEC_06_1\",\"kind\":\"requirement\",\"name\":\"PairingDataStorage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.1\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The 93C86 EEPROM (U5, 16 kbit) shall hold the immobiliser pairing data, the engine number 541.922-00-063818 and device codes 1061 1047 1034 1026 (storage format TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06_2\":{\"id\":\"req_REQ_SEC_06_2\",\"kind\":\"requirement\",\"name\":\"DriveAuthorisation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"FR shall read the transponder on the cab side and send the drive-authorisation code to the MR in an ImmoReleaseFrame over IES-CAN; KL.15 / KL.50 shall reach X1-15 / X1-8.\",\"version\":\"1.0\"},\"req_REQ_SEC_06_3\":{\"id\":\"req_REQ_SEC_06_3\",\"kind\":\"requirement\",\"name\":\"StarterOutput\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The starter relay output (X2-18, parallel X1-12, max 4 A) shall be energised only in ST_CRANK_SYNC, i.e. after authorisation and below 300 rpm.\",\"version\":\"1.0\"},\"req_REQ_SEC_06_4\":{\"id\":\"req_REQ_SEC_06_4\",\"kind\":\"requirement\",\"name\":\"InputSupervision\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.4\",\"risk\":\"medium\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The TEMIC 845AW co-processor (U4, PLCC-68) shall supervise six digital inputs (KL.15, KL.50, block start / stop) and act as watchdog of the MCU (function TBV).\",\"version\":\"1.0\"},\"req_REQ_SEC_06_5\":{\"id\":\"req_REQ_SEC_06_5\",\"kind\":\"requirement\",\"name\":\"EngineBlockButtons\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SEC-06.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The engine-block start (X2-25) and stop (X2-35) buttons, bridged to X2-30, shall start only from ST_READY below 300 rpm and stop the running engine.\",\"version\":\"1.0\"},\"req_REQ_SPEC_00\":{\"id\":\"req_REQ_SPEC_00\",\"kind\":\"requirement\",\"name\":\"mrPldSpecification\",\"namespace\":[\"Requirements\",\"Truck controller specification\"],\"ownerId\":\"req-req-trk-00\",\"priority\":\"high\",\"requirementId\":\"REQ-SPEC-00\",\"risk\":\"low\",\"status\":\"approved\",\"text\":\"Top-level specification grouping all ECU requirements (subject: MR_PLD_ECU).\",\"version\":\"1.0\"},\"req_REQ_SYNC_02\":{\"id\":\"req_REQ_SYNC_02\",\"kind\":\"requirement\",\"name\":\"DualSyncRedundancy\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-SYNC-02\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Injection shall continue on CKP (36 slots + ref) or on CMP (12+1) alone; injection is inhibited only when both are lost. [require: injectionEnabled == (ckpValid or cmpValid)]\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_1\":{\"id\":\"req_REQ_SYNC_02_1\",\"kind\":\"requirement\",\"name\":\"VrZeroCrossing\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The LM2903D comparators shall square the VR signals: CKP valid from 1.2 Vpp at cranking up to ~25 Vpp, CMP from 0.9 Vpp.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_2\":{\"id\":\"req_REQ_SYNC_02_2\",\"kind\":\"requirement\",\"name\":\"CrankCamPattern\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"B15 (crank, 36 slots + reference, X2-19 / X2-2) and B16 (cam, 12 + 1 teeth, X2-20 / X2-1) shall be inductive VR sensors of 1050..1350 Ohm; f_CKP = 0.6 n, f_CMP = 0.1 n.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_3\":{\"id\":\"req_REQ_SYNC_02_3\",\"kind\":\"requirement\",\"name\":\"CapcomSynchronisation\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.3\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The C167 CAPCOM (CC0 / CC1) shall synchronise on the CKP reference slot and the CMP sync tooth and keep injecting on either one alone (SyncMode BOTH / CMP_ONLY / CKP_ONLY / NONE).\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_4\":{\"id\":\"req_REQ_SYNC_02_4\",\"kind\":\"requirement\",\"name\":\"SensorFrontEnd\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.4\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"The analogue front-end shall contain 2 VR comparators, 2 ratiometric buffers, 4 NTC pull-up networks and the on-board baro sensor.\",\"version\":\"1.0\"},\"req_REQ_SYNC_02_5\":{\"id\":\"req_REQ_SYNC_02_5\",\"kind\":\"requirement\",\"name\":\"ScenarioCoverage\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-SYNC-02.5\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"Each simulation scenario shall state key state, pedal, coolant, boost, immobiliser, CKP, CMP, bank-1 short and CAN validity and the expected final operating state.\",\"version\":\"1.0\"},\"req_REQ_THM_08\":{\"id\":\"req_REQ_THM_08\",\"kind\":\"requirement\",\"name\":\"ThermalProtection\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"high\",\"requirementId\":\"REQ-THM-08\",\"risk\":\"high\",\"source\":\"MR_PLD_A5414465340.sysml\",\"status\":\"approved\",\"text\":\"Fan clutch PV3 PWM from 92 C, 100 % at 100 C; warning and derate from 103 C; hard derate 35 % from 110 C. [require: coolantC >= 110.0 implies torqueLimitPct <= 65.0]\",\"version\":\"1.0\"},\"req_REQ_THM_08_1\":{\"id\":\"req_REQ_THM_08_1\",\"kind\":\"requirement\",\"name\":\"FanClutchControl\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-THM-08.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV3 fan-clutch valve (X2-41 / X1-14) shall be driven by PWM from 92 C, reaching 100 % at 100 C; warning from 103 C.\",\"version\":\"1.0\"},\"req_REQ_THM_08_2\":{\"id\":\"req_REQ_THM_08_2\",\"kind\":\"requirement\",\"name\":\"ProportionalValveCoil\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-THM-08.2\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"PV1 (X2-51), PV2 (X2-50), PV3 (X2-41) and PV4 (X2-43) proportional valves shall have 30..50 Ohm coils supplied from X2-12 / X2-52.\",\"version\":\"1.0\"},\"req_REQ_VAR_16\":{\"id\":\"req_REQ_VAR_16\",\"kind\":\"requirement\",\"name\":\"EngineVariants\",\"namespace\":[\"Requirements\",\"Truck controller specification\",\"mrPldSpecification\"],\"ownerId\":\"req_REQ_SPEC_00\",\"priority\":\"medium\",\"requirementId\":\"REQ-VAR-16\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml part / state docs\",\"status\":\"approved\",\"text\":\"The same ECU hardware shall serve OM 501 LA V6 and OM 502 LA V8: 8 low-side drivers populated, cylinder 7 / 8 outputs (X2-46 / X2-37) wired on V8 only.\",\"version\":\"1.0\"},\"req_REQ_VAR_16_1\":{\"id\":\"req_REQ_VAR_16_1\",\"kind\":\"requirement\",\"name\":\"V8Outputs\",\"namespace\":[\"MercedesBenz_MR_PLD_A5414465340\",\"04_Requirements\"],\"ownerId\":\"pkg_Requirements\",\"priority\":\"medium\",\"requirementId\":\"REQ-VAR-16.1\",\"risk\":\"low\",\"source\":\"MR_PLD_A5414465340.sysml / mrpld_data.py\",\"status\":\"approved\",\"text\":\"On OM 502 V8 the harness shall add unit pumps G (cyl 7, X2-46) and H (cyl 8, X2-37); on V6 these pins stay unused.\",\"version\":\"1.0\"},\"rq-ar-01\":{\"id\":\"rq-ar-01\",\"kind\":\"requirement\",\"name\":\"No direct hardware access\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"AR-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Application modules shall not access registers or ports directly. They use the runtime interface only.\",\"version\":\"1.0\"},\"rq-ar-02\":{\"id\":\"rq-ar-02\",\"kind\":\"requirement\",\"name\":\"Layer calls\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"high\",\"requirementId\":\"AR-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"A layer may call only the layer directly below it, except the OS, which every layer may use.\",\"version\":\"1.0\"},\"rq-ar-03\":{\"id\":\"rq-ar-03\",\"kind\":\"requirement\",\"name\":\"Static memory\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"AR-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"No dynamic memory allocation and no recursion.\",\"version\":\"1.0\"},\"rq-ar-04\":{\"id\":\"rq-ar-04\",\"kind\":\"requirement\",\"name\":\"Redundant P1 data\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"AR-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"P1 data (injEnable, starter, sync mode, torque limit) shall be stored with a redundant inverse copy and checked before use.\",\"version\":\"1.0\"},\"rq-ar-05\":{\"id\":\"rq-ar-05\",\"kind\":\"requirement\",\"name\":\"Separate calibration data\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"high\",\"requirementId\":\"AR-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Calibration data shall live only in the data set (0x60000–0x7FEFF), separate from code, so it can be flashed independently.\",\"version\":\"1.0\"},\"rq-ar-06\":{\"id\":\"rq-ar-06\",\"kind\":\"requirement\",\"name\":\"CPLD versioned with SW\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"high\",\"requirementId\":\"AR-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CPLD logic (U3) shall be versioned together with the MCU software, and its version shall be readable over diagnostics.\",\"version\":\"1.0\"},\"rq-can-msg-01\":{\"id\":\"rq-can-msg-01\",\"kind\":\"requirement\",\"name\":\"TorqueRequestFrame (CPC → MCM)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-MSG-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x0CF00331, PGN 61443 (EEC2-like), DLC 8, cycle 20 ms, timeout 200 ms. Signals: PedalPosition (bit 8, 8 bit, 0.4 %/bit, substitute 0 %), EngineBrakeReq (bit 16, 2 bit), KickdownSwitch (bit 18, 2 bit), TorqueLimitReq (bit 24, 8 bit, 1 %/bit, substitute 100 %), AliveCounter (4 bit), CRC8. Error: 3 cycles (60 ms) missing or bad counter / CRC → CAN_MISSING, hold last pedal; 200 ms → CAN_TIMEOUT, ST_LIMP_DERATE, DTC 2001 / 2002.\",\"version\":\"1.0\"},\"rq-can-msg-02\":{\"id\":\"rq-can-msg-02\",\"kind\":\"requirement\",\"name\":\"ImmoReleaseFrame (CPC → MCM)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-MSG-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18EF0031, PGN 61184 PropA, DLC 8, on event with 100 ms repeat, timeout 2 s. Signals: AuthCode (32 bit), AuthCounter (8 bit), CRC8. Error: no frame within 2 s of KL.15 on → stay in ST_INIT_IMMO, no start, DTC 3001.\",\"version\":\"1.0\"},\"rq-can-msg-03\":{\"id\":\"rq-can-msg-03\",\"kind\":\"requirement\",\"name\":\"ImmoStatus (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-MSG-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18EF3100, PGN 61184 PropA, DLC 8, on event + every 1 s. Accepted / rejected, counter echo. (New: not in the model, proposed so the FR can show the immobiliser result.)\",\"version\":\"1.0\"},\"rq-can-msg-04\":{\"id\":\"rq-can-msg-04\",\"kind\":\"requirement\",\"name\":\"EEC1 engine speed (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-MSG-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x0CF00400, PGN 61444 EEC1, DLC 8, cycle 20 ms. ActualTorquePct (bit 16, 8 bit, 1 %/bit, −125 offset), EngineSpeed SPN 190 (bit 24, 16 bit, 0.125 rpm/bit). n/a = 0xFF / 0xFFFF.\",\"version\":\"1.0\"},\"rq-can-msg-05\":{\"id\":\"rq-can-msg-05\",\"kind\":\"requirement\",\"name\":\"ET1 temperatures (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-MSG-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18FEEE00, PGN 65262 ET1, DLC 8, cycle 1000 ms. CoolantTemp SPN 110 (1 °C/bit, −40), FuelTemp SPN 174 (1 °C/bit, −40), OilTemp SPN 175 (0.03125 °C/bit, −273).\",\"version\":\"1.0\"},\"rq-can-msg-06\":{\"id\":\"rq-can-msg-06\",\"kind\":\"requirement\",\"name\":\"EFL/P1 fluids (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-MSG-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18FEEF00, PGN 65263 EFL/P1, DLC 8, cycle 500 ms. OilLevel SPN 98 (0.4 %/bit), OilPressure SPN 100 (4 kPa/bit), boost (J1939 carries boost in IC1 PGN 65270 — deviation to document).\",\"version\":\"1.0\"},\"rq-can-msg-07\":{\"id\":\"rq-can-msg-07\",\"kind\":\"requirement\",\"name\":\"EngineStatus (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-MSG-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18FF0200, PGN 65282 PropB, DLC 8, cycle 100 ms. OperatingState (4 bit), SyncMode (2 bit: BOTH, CMP_ONLY, CKP_ONLY, NONE), TorqueLimitPct (8 bit), WarnLamp / SpeedLimited / StarterOn / Pv3Duty. (New, proposed.)\",\"version\":\"1.0\"},\"rq-can-msg-08\":{\"id\":\"rq-can-msg-08\",\"kind\":\"requirement\",\"name\":\"DM1 active DTCs (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-MSG-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18FECA00, PGN 65226 DM1, DLC 8 or transport protocol (BAM for more than one DTC), every 1000 ms and on change. Lamp status, SPN, FMI, occurrence count.\",\"version\":\"1.0\"},\"rq-can-msg-09\":{\"id\":\"rq-can-msg-09\",\"kind\":\"requirement\",\"name\":\"FaultRecord MR code (MCM → CPC)\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-MSG-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ID 0x18FF0100, PGN 65281 PropB, DLC 8, on event. MR fault code and severity.\",\"version\":\"1.0\"},\"rq-can-net-01\":{\"id\":\"rq-can-net-01\",\"kind\":\"requirement\",\"name\":\"IES-CAN network parameters\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-NET-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ISO 11898-2, 250 kbit/s, sample point 87.5 % ± 2 %, 120 Ω at each end, 29-bit J1939-21 identifiers, little-endian, MCM source address 0x00, CPC (FR) 0x31, bus load ≤ 40 %.\",\"version\":\"1.0\"},\"rq-can-net-02\":{\"id\":\"rq-can-net-02\",\"kind\":\"requirement\",\"name\":\"Bus-off recovery\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"high\",\"requirementId\":\"CAN-NET-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Bus-off recovers automatically after 128 × 11 recessive bits; 3 bus-offs within 10 s → DTC 2003 and CAN_TIMEOUT handling.\",\"version\":\"1.0\"},\"rq-can-net-03\":{\"id\":\"rq-can-net-03\",\"kind\":\"requirement\",\"name\":\"Reception supervision\",\"namespace\":[],\"ownerId\":\"rq-sw-can-00\",\"priority\":\"critical\",\"requirementId\":\"CAN-NET-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CAN_OK → CAN_MISSING (no valid TorqueRequestFrame for 3 cycles = 60 ms, or bad counter / CRC: hold last pedal) → CAN_TIMEOUT (200 ms: torque limit 65 %, pedal ramps to substitute, DTC). Recovery: 3 consecutive valid frames with sync and coolant OK → CanRestored → ST_RUN.\",\"version\":\"1.0\"},\"rq-dtc-00\":{\"id\":\"rq-dtc-00\",\"kind\":\"requirement\",\"name\":\"Fault memory\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"At least 20 DTC entries in EEPROM, each with status byte, occurrence counter (0–126), first / last occurrence engine hours and a freeze frame (rpm, coolant, boost, U_Bat, operating state). A DTC becomes inactive after 3 fault-free driving cycles and is deleted after 40 warm-up cycles (PROPOSED).\",\"version\":\"1.0\"},\"rq-dtc-0110\":{\"id\":\"rq-dtc-0110\",\"kind\":\"requirement\",\"name\":\"0110 CKP signal missing\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-0110\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 0110: CKP signal missing. SPN 636, FMI 8, severity DERATE. Detection (debounce): no tooth for 2 expected periods while CMP valid. Reaction: CMP-only timing, 1800 rpm, 65 %.\",\"version\":\"1.0\"},\"rq-dtc-0111\":{\"id\":\"rq-dtc-0111\",\"kind\":\"requirement\",\"name\":\"0111 CKP signal erratic\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-0111\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 0111: CKP signal erratic. SPN 636, FMI 2, severity DERATE. Detection (debounce): tooth-period jump > 50 % on 3 teeth in a row. Reaction: as 0110.\",\"version\":\"1.0\"},\"rq-dtc-0112\":{\"id\":\"rq-dtc-0112\",\"kind\":\"requirement\",\"name\":\"0112 CKP reference slot implausible\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-0112\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 0112: CKP reference slot implausible. SPN 636, FMI 7, severity DERATE. Detection (debounce): reference gap not every 36 teeth for 2 rev. Reaction: as 0110.\",\"version\":\"1.0\"},\"rq-dtc-0113\":{\"id\":\"rq-dtc-0113\",\"kind\":\"requirement\",\"name\":\"0113 CMP signal missing / implausible\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-0113\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 0113: CMP signal missing / implausible. SPN 723, FMI 8, severity DERATE. Detection (debounce): no sync tooth for 2 cam rev while CKP valid. Reaction: CKP-only, ST_LIMP_DERATE.\",\"version\":\"1.0\"},\"rq-dtc-0114\":{\"id\":\"rq-dtc-0114\",\"kind\":\"requirement\",\"name\":\"0114 CKP and CMP lost\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-0114\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 0114: CKP and CMP lost. SPN 636, FMI 31, severity CRITICAL. Detection (debounce): both invalid. Reaction: injection inhibited, ST_FAULT_SHUTDOWN.\",\"version\":\"1.0\"},\"rq-dtc-1021\":{\"id\":\"rq-dtc-1021\",\"kind\":\"requirement\",\"name\":\"1021 Coolant temperature B65\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1021\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1021: Coolant temperature B65. SPN 110, FMI 3/4/2, severity WARNING. Detection (debounce): outside 0.18–4.82 V for 500 ms. Reaction: substitute 90 °C, fan 100 %.\",\"version\":\"1.0\"},\"rq-dtc-1022\":{\"id\":\"rq-dtc-1022\",\"kind\":\"requirement\",\"name\":\"1022 Engine overheat ≥ 103 °C / ≥ 110 °C\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-1022\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1022: Engine overheat ≥ 103 °C / ≥ 110 °C. SPN 110, FMI 16 / 0, severity DERATE. Detection (debounce): coolant above threshold for 1 s. Reaction: warning lamp, 65 % / 35 % torque.\",\"version\":\"1.0\"},\"rq-dtc-1031\":{\"id\":\"rq-dtc-1031\",\"kind\":\"requirement\",\"name\":\"1031 Boost pressure B111-P\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-1031\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1031: Boost pressure B111-P. SPN 102, FMI 3/4/2, severity DERATE. Detection (debounce): outside 0.25–4.75 V for 500 ms. Reaction: substitute 1.0 bar → base smoke limit.\",\"version\":\"1.0\"},\"rq-dtc-1032\":{\"id\":\"rq-dtc-1032\",\"kind\":\"requirement\",\"name\":\"1032 Charge-air temperature B111-T\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1032\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1032: Charge-air temperature B111-T. SPN 105, FMI 3/4, severity WARNING. Detection (debounce): window 500 ms. Reaction: substitute 40 °C.\",\"version\":\"1.0\"},\"rq-dtc-1041\":{\"id\":\"rq-dtc-1041\",\"kind\":\"requirement\",\"name\":\"1041 Fuel temperature B10\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1041\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1041: Fuel temperature B10. SPN 174, FMI 3/4, severity WARNING. Detection (debounce): window 500 ms. Reaction: substitute 40 °C.\",\"version\":\"1.0\"},\"rq-dtc-1051\":{\"id\":\"rq-dtc-1051\",\"kind\":\"requirement\",\"name\":\"1051 Oil pressure sensor B110\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1051\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1051: Oil pressure sensor B110. SPN 100, FMI 3/4, severity WARNING. Detection (debounce): window 500 ms. Reaction: no oil-pressure warning possible, CAN n/a.\",\"version\":\"1.0\"},\"rq-dtc-1052\":{\"id\":\"rq-dtc-1052\",\"kind\":\"requirement\",\"name\":\"1052 Oil pressure low (engine running)\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1052\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1052: Oil pressure low (engine running). SPN 100, FMI 1, severity WARNING. Detection (debounce): below map for 2 s, rpm > 500. Reaction: warning lamp via CAN (TBV).\",\"version\":\"1.0\"},\"rq-dtc-1061\":{\"id\":\"rq-dtc-1061\",\"kind\":\"requirement\",\"name\":\"1061 Oil temperature B11\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1061\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1061: Oil temperature B11. SPN 175, FMI 3/4, severity WARNING. Detection (debounce): window 500 ms. Reaction: substitute = coolant.\",\"version\":\"1.0\"},\"rq-dtc-1071\":{\"id\":\"rq-dtc-1071\",\"kind\":\"requirement\",\"name\":\"1071 Barometric sensor\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1071\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1071: Barometric sensor. SPN 108, FMI 3/4, severity DRIFT. Detection (debounce): window 2 s. Reaction: substitute 1.013 bar.\",\"version\":\"1.0\"},\"rq-dtc-1081\":{\"id\":\"rq-dtc-1081\",\"kind\":\"requirement\",\"name\":\"1081 Battery voltage high / low\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-1081\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 1081: Battery voltage high / low. SPN 168, FMI 3/4, severity WARNING. Detection (debounce): > 32 V or < 16 V for 1 s. Reaction: power-stage compensation, DTC.\",\"version\":\"1.0\"},\"rq-dtc-2001\":{\"id\":\"rq-dtc-2001\",\"kind\":\"requirement\",\"name\":\"2001 Torque request timeout (CPC / FR)\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-2001\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 2001: Torque request timeout (CPC / FR). SPN 639, FMI 9, severity DERATE. Detection (debounce): no valid frame for 200 ms. Reaction: ST_LIMP_DERATE, limp torque.\",\"version\":\"1.0\"},\"rq-dtc-2002\":{\"id\":\"rq-dtc-2002\",\"kind\":\"requirement\",\"name\":\"2002 Torque request counter / CRC error\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-2002\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 2002: Torque request counter / CRC error. SPN 639, FMI 19, severity DERATE. Detection (debounce): 3 bad frames in 10. Reaction: as 2001.\",\"version\":\"1.0\"},\"rq-dtc-2003\":{\"id\":\"rq-dtc-2003\",\"kind\":\"requirement\",\"name\":\"2003 CAN bus-off\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-2003\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 2003: CAN bus-off. SPN 639, FMI 14, severity DERATE. Detection (debounce): 3 bus-off events in 10 s. Reaction: as 2001.\",\"version\":\"1.0\"},\"rq-dtc-2515\":{\"id\":\"rq-dtc-2515\",\"kind\":\"requirement\",\"name\":\"2515 Oil-level sensor B14 circuit\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-2515\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 2515: Oil-level sensor B14 circuit. SPN 98, FMI 3/4, severity WARNING. Detection (debounce): 18–26 Ω check at init. Reaction: level n/a.\",\"version\":\"1.0\"},\"rq-dtc-2516\":{\"id\":\"rq-dtc-2516\",\"kind\":\"requirement\",\"name\":\"2516 Oil level low (TBV)\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-2516\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 2516: Oil level low (TBV). SPN 98, FMI 1, severity WARNING. Detection (debounce): heat-pulse result at init. Reaction: warning lamp.\",\"version\":\"1.0\"},\"rq-dtc-3001\":{\"id\":\"rq-dtc-3001\",\"kind\":\"requirement\",\"name\":\"3001 Immobiliser code rejected / missing\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-3001\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 3001: Immobiliser code rejected / missing. SPN 520192, FMI 31, severity CRITICAL. Detection (debounce): code mismatch, or no frame for 2 s. Reaction: ST_IMMO_LOCKED, no start.\",\"version\":\"1.0\"},\"rq-dtc-3002\":{\"id\":\"rq-dtc-3002\",\"kind\":\"requirement\",\"name\":\"3002 EEPROM pairing block corrupt\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-3002\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 3002: EEPROM pairing block corrupt. SPN 520193, FMI 12, severity CRITICAL. Detection (debounce): CRC fail on both copies. Reaction: immobiliser locked.\",\"version\":\"1.0\"},\"rq-dtc-3003\":{\"id\":\"rq-dtc-3003\",\"kind\":\"requirement\",\"name\":\"3003 Program flash checksum error\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-3003\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 3003: Program flash checksum error. SPN 628, FMI 12, severity CRITICAL. Detection (debounce): start-up check. Reaction: stay in bootloader, no start.\",\"version\":\"1.0\"},\"rq-dtc-3004\":{\"id\":\"rq-dtc-3004\",\"kind\":\"requirement\",\"name\":\"3004 Watchdog / co-processor reset\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-3004\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 3004: Watchdog / co-processor reset. SPN 629, FMI 12, severity CRITICAL. Detection (debounce): U4 reset or link error 3 × in a row. Reaction: drivers tristated, restart.\",\"version\":\"1.0\"},\"rq-dtc-4001\":{\"id\":\"rq-dtc-4001\",\"kind\":\"requirement\",\"name\":\"4001 Starter relay output\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-4001\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 4001: Starter relay output. SPN 677, FMI 3/5/6, severity WARNING. Detection (debounce): driver diagnostics. Reaction: no start possible.\",\"version\":\"1.0\"},\"rq-dtc-4011\":{\"id\":\"rq-dtc-4011\",\"kind\":\"requirement\",\"name\":\"4011 PV1 decompression valve\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-4011\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 4011: PV1 decompression valve. SPN 1072, FMI 5/6, severity WARNING. Detection (debounce): open load / short. Reaction: engine brake inhibited.\",\"version\":\"1.0\"},\"rq-dtc-4012\":{\"id\":\"rq-dtc-4012\",\"kind\":\"requirement\",\"name\":\"4012 PV2 exhaust-brake flap valve\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-4012\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 4012: PV2 exhaust-brake flap valve. SPN 1074, FMI 5/6, severity WARNING. Detection (debounce): open load / short. Reaction: engine brake inhibited.\",\"version\":\"1.0\"},\"rq-dtc-4013\":{\"id\":\"rq-dtc-4013\",\"kind\":\"requirement\",\"name\":\"4013 PV3 fan-clutch valve\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-4013\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 4013: PV3 fan-clutch valve. SPN 647, FMI 5/6, severity WARNING. Detection (debounce): open load / short. Reaction: derate earlier (fan unavailable).\",\"version\":\"1.0\"},\"rq-dtc-4014\":{\"id\":\"rq-dtc-4014\",\"kind\":\"requirement\",\"name\":\"4014 PV4 auxiliary valve\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"high\",\"requirementId\":\"DTC-4014\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 4014: PV4 auxiliary valve. SPN 520194, FMI 5/6, severity WARNING. Detection (debounce): open load / short. Reaction: output off.\",\"version\":\"1.0\"},\"rq-dtc-51xx-53xx\":{\"id\":\"rq-dtc-51xx-53xx\",\"kind\":\"requirement\",\"name\":\"51xx–53xx Unit pump cyl 1–3 overcurrent / open coil\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-51xx-53xx\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 51xx–53xx: Unit pump cyl 1–3 overcurrent / open coil. SPN 651–653, FMI 6/5, severity DERATE. Detection (debounce): LM2901D OC (24 A) or peak < 4 A, 3 events. Reaction: cylinder cut off (CYL_CUTOFF), limp.\",\"version\":\"1.0\"},\"rq-dtc-54xx-56xx\":{\"id\":\"rq-dtc-54xx-56xx\",\"kind\":\"requirement\",\"name\":\"54xx–56xx Unit pump cyl 4–6 overcurrent / open coil\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-54xx-56xx\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 54xx–56xx: Unit pump cyl 4–6 overcurrent / open coil. SPN 654–656, FMI 6/5, severity DERATE. Detection (debounce): as above. Reaction: as above.\",\"version\":\"1.0\"},\"rq-dtc-57xx\":{\"id\":\"rq-dtc-57xx\",\"kind\":\"requirement\",\"name\":\"57xx Unit pump cyl 7 / 8 (V8)\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-57xx\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 57xx: Unit pump cyl 7 / 8 (V8). SPN 657–658, FMI 6/5, severity DERATE. Detection (debounce): as above. Reaction: as above.\",\"version\":\"1.0\"},\"rq-dtc-5801-5802\":{\"id\":\"rq-dtc-5801-5802\",\"kind\":\"requirement\",\"name\":\"5801 / 5802 Bank 1 / bank 2 common short\",\"namespace\":[],\"ownerId\":\"rq-sw-dtc-00\",\"priority\":\"critical\",\"requirementId\":\"DTC-5801-5802\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MR code 5801 / 5802: Bank 1 / bank 2 common short. SPN 2797 / 2798, FMI 6, severity DERATE. Detection (debounce): OC on first peak of every cylinder in the bank. Reaction: bank off, BankShortDetected → limp.\",\"version\":\"1.0\"},\"rq-hw-d01\":{\"id\":\"rq-hw-d01\",\"kind\":\"requirement\",\"name\":\"D01 U2 → U1 code fetch\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"16-bit demultiplexed EBC, A0–A18 / D0–D15, /CS /RD /WR; continuous, 70–90 ns flash; checksum 0x7FF00–7FFFF at start-up.\",\"version\":\"1.0\"},\"rq-hw-d02\":{\"id\":\"rq-hw-d02\",\"kind\":\"requirement\",\"name\":\"D02 U1 → U2 erase / program\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Same bus, JEDEC command sequences; flash session only; security access + verify.\",\"version\":\"1.0\"},\"rq-hw-d03\":{\"id\":\"rq-hw-d03\",\"kind\":\"requirement\",\"name\":\"D03 U1 ↔ U5 NvM\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Microwire CS, SK, DI, DO (SSC or port pins); full read ≈ 20 ms at 1 MHz, write ≤ 10 ms / word; CRC per block + redundant copy.\",\"version\":\"1.0\"},\"rq-hw-d04\":{\"id\":\"rq-hw-d04\",\"kind\":\"requirement\",\"name\":\"D04 U1 ↔ U4 watchdog link\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Serial (TBV), proposed SPI on SSC, 1 Mbit/s, 2 × 16-bit frames, U1 master, every 10 ms; sequence counter + CRC8; window watchdog (answer 8–12 ms after the previous one).\",\"version\":\"1.0\"},\"rq-hw-d05\":{\"id\":\"rq-hw-d05\",\"kind\":\"requirement\",\"name\":\"D05 U4 → U1 /RESET\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Discrete /RESET, open drain → RSTIN; on watchdog failure; independent of U1.\",\"version\":\"1.0\"},\"rq-hw-d06\":{\"id\":\"rq-hw-d06\",\"kind\":\"requirement\",\"name\":\"D06 U4 → U3, drivers DRV_DISABLE\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Discrete, fail-safe (low = disabled); ≤ 50 ms after fault (RT-12); independent shutdown path.\",\"version\":\"1.0\"},\"rq-hw-d07\":{\"id\":\"rq-hw-d07\",\"kind\":\"requirement\",\"name\":\"D07 U16 → U1, U4 reset\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"TLE4275 power-on / undervoltage reset and 5 V reference; power-up, brown-out.\",\"version\":\"1.0\"},\"rq-hw-d08\":{\"id\":\"rq-hw-d08\",\"kind\":\"requirement\",\"name\":\"D08 LM2903D → U1 crank / cam edges\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D08\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"CKP and CMP squared tooth edges, 0 / 5 V into CAPCOM CC0 / CC1; CKP ≤ 1.4 kHz, CMP ≤ 230 Hz at 2300 rpm; tooth-gap and pattern plausibility.\",\"version\":\"1.0\"},\"rq-hw-d09\":{\"id\":\"rq-hw-d09\",\"kind\":\"requirement\",\"name\":\"D09 AFE → U1 analogue\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D09\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Boost, oil pressure, 4 temperatures, oil level, baro, U_Bat: 0–5 V into ADC AN0–AN8, 10-bit; 10 ms / 100 ms / 1 s; window diagnostics.\",\"version\":\"1.0\"},\"rq-hw-d10\":{\"id\":\"rq-hw-d10\",\"kind\":\"requirement\",\"name\":\"D10 U1 → U3 SOI / EOI\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D10\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"SOI, EOI, CYL_SEL[2:0], INJ_EN: CAPCOM compare outputs + GPIO; per injection, ≤ 153 / s (V8, 2300 rpm); INJ_EN AND NOT DRV_DISABLE inside U3.\",\"version\":\"1.0\"},\"rq-hw-d11\":{\"id\":\"rq-hw-d11\",\"kind\":\"requirement\",\"name\":\"D11 U3 → U1 status\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D11\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"BIP_DET, CYL_CUTOFF, BANK_SHORT[1:2]: digital + external interrupt; per event / on fault; latched until U1 reads.\",\"version\":\"1.0\"},\"rq-hw-d12\":{\"id\":\"rq-hw-d12\",\"kind\":\"requirement\",\"name\":\"D12 LM2901D → U3 current thresholds\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D12\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"PEAK (16 A), HOLD (8 A), OC (24 A), OPEN × 2 banks: comparator outputs, open collector; continuous, < 1 µs; hardware only.\",\"version\":\"1.0\"},\"rq-hw-d13\":{\"id\":\"rq-hw-d13\",\"kind\":\"requirement\",\"name\":\"D13 U3 → injection drivers\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D13\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"G_HS1, G_HS2, G_LS1–8 gate logic, µs resolution, 20 kHz hold chop; gated by DRV_DISABLE.\",\"version\":\"1.0\"},\"rq-hw-d14\":{\"id\":\"rq-hw-d14\",\"kind\":\"requirement\",\"name\":\"D14 U1 → valve / starter drivers\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D14\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"EN_HS3–5, PV1–PV4, PWM_PV3, STARTER, LATCH: GPIO / PWM, 10 ms, PWM continuous; starter needs U4 permission.\",\"version\":\"1.0\"},\"rq-hw-d15\":{\"id\":\"rq-hw-d15\",\"kind\":\"requirement\",\"name\":\"D15 U1 ↔ CAN PHY 1 ↔ CPC\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D15\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"CAN TXD / RXD → ISO 11898-2, 250 kbit/s, 29-bit IDs; Rx torque + immo, Tx EEC1, ET1, EFL/P1, status, DM1, ImmoStatus; 20 ms – 1 s; alive counter + CRC8 on P1 frames.\",\"version\":\"1.0\"},\"rq-hw-d16\":{\"id\":\"rq-hw-d16\",\"kind\":\"requirement\",\"name\":\"D16 U1 ↔ CAN PHY 2\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"medium\",\"requirementId\":\"HW-D16\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Not assigned; proposed CCP / XCP or spare (open item S-12).\",\"version\":\"1.0\"},\"rq-hw-d17\":{\"id\":\"rq-hw-d17\",\"kind\":\"requirement\",\"name\":\"D17 U1 ↔ L9637D ↔ tester\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"high\",\"requirementId\":\"HW-D17\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"KWP2000 and bootstrap download: UART 8N1 (ASC0) → ISO 9141-2 K-line, 10.4 kbit/s; on request, P2 = 25–50 ms; checksum byte, security access.\",\"version\":\"1.0\"},\"rq-hw-d18\":{\"id\":\"rq-hw-d18\",\"kind\":\"requirement\",\"name\":\"D18 CPC (FR) → U4 (and U1) discrete inputs\",\"namespace\":[],\"ownerId\":\"rq-hw-obc-00\",\"priority\":\"critical\",\"requirementId\":\"HW-D18\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"KL.15, KL.50 (+ block start / stop): 24 V discrete, protected inputs; 10 ms poll, 30 ms debounce; U1 / U4 cross-check.\",\"version\":\"1.0\"},\"rq-hw-dev-00\":{\"id\":\"rq-hw-dev-00\",\"kind\":\"requirement\",\"name\":\"On-board devices U1–U5\",\"namespace\":[],\"ownerId\":\"rq-hw-req-00\",\"priority\":\"critical\",\"requirementId\":\"HW-DEV-00\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Requirements of the main MCU U1, the co-processor U4, the injection CPLD U3, the program flash U2 and the EEPROM U5 (SPEC §4–8).\",\"version\":\"1.0\"},\"rq-hw-io-00\":{\"id\":\"rq-hw-io-00\",\"kind\":\"requirement\",\"name\":\"Inputs and outputs\",\"namespace\":[],\"ownerId\":\"rq-hw-req-00\",\"priority\":\"critical\",\"requirementId\":\"HW-IO-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Every input and output of the MCM: harness pin, front-end / driver, MCU resource, sampling and fault detection (SWRS §10).\",\"version\":\"1.0\"},\"rq-hw-mcu-00\":{\"id\":\"rq-hw-mcu-00\",\"kind\":\"requirement\",\"name\":\"Main MCU selection\",\"namespace\":[],\"ownerId\":\"rq-hw-req-00\",\"priority\":\"critical\",\"requirementId\":\"HW-MCU-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Requirements the main MCU (U1) shall meet (SWRS §6.1).\",\"version\":\"1.0\"},\"rq-hw-obc-00\":{\"id\":\"rq-hw-obc-00\",\"kind\":\"requirement\",\"name\":\"On-board data transfers D01–D18\",\"namespace\":[],\"ownerId\":\"rq-hw-req-00\",\"priority\":\"critical\",\"requirementId\":\"HW-OBC-00\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Every on-board link of the MCM main PCB: data, physical layer, rate and integrity (SPEC §3).\",\"version\":\"1.0\"},\"rq-hw-req-00\":{\"id\":\"rq-hw-req-00\",\"kind\":\"requirement\",\"name\":\"MCM hardware specification\",\"namespace\":[],\"ownerId\":\"pkg-hw-req\",\"priority\":\"critical\",\"requirementId\":\"HW-REQ-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Hardware of the MCM (MR-PLD engine ECU, TEMIC PCB 287699.01 B): main MCU, on-board devices, on-board links, inputs and outputs, CAN and signal chain.\",\"version\":\"1.0\"},\"rq-hw-sig-00\":{\"id\":\"rq-hw-sig-00\",\"kind\":\"requirement\",\"name\":\"CAN physical layer and signals\",\"namespace\":[],\"ownerId\":\"rq-hw-req-00\",\"priority\":\"critical\",\"requirementId\":\"HW-SIG-00\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"CAN and signal accuracy, sampling and latency requirements (SPEC §10.7, §11.5).\",\"version\":\"1.0\"},\"rq-io-in-01\":{\"id\":\"rq-io-in-01\",\"kind\":\"requirement\",\"name\":\"n_Ckp crank speed\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-IN-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B15 VR, X2-19 / 2 → LM2903D → CAPCOM CC0 (edge); 36 slots + ref, n = f / 0.6 rpm; each tooth; missing ref / extra teeth → CkpLost.\",\"version\":\"1.0\"},\"rq-io-in-02\":{\"id\":\"rq-io-in-02\",\"kind\":\"requirement\",\"name\":\"n_Cmp cam phase\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-IN-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B16 VR, X2-20 / 1 → CC1 (edge); 12 + 1 teeth, n = f / 0.1 rpm; each tooth; missing sync tooth → CmpLost.\",\"version\":\"1.0\"},\"rq-io-in-03\":{\"id\":\"rq-io-in-03\",\"kind\":\"requirement\",\"name\":\"p_Boost\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-IN-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B111-P, X2-29 → AN0; p = 0.6 + 0.7 · (V − 0.5) bar abs; 10 ms, 4-sample mean; V < 0.25 or > 4.75 V.\",\"version\":\"1.0\"},\"rq-io-in-04\":{\"id\":\"rq-io-in-04\",\"kind\":\"requirement\",\"name\":\"T_Iat\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-IN-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B111-T, X2-48 → AN1; R = 2490 · V / (5 − V) Ω → NTC table; 100 ms, PT1 τ = 1 s; V < 0.18 or > 4.82 V.\",\"version\":\"1.0\"},\"rq-io-in-05\":{\"id\":\"rq-io-in-05\",\"kind\":\"requirement\",\"name\":\"T_Ect\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-IN-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B65, X2-34 → AN2; NTC (2.50 V @ 20 °C, 0.57 V @ 80 °C); 100 ms, PT1 τ = 1 s; OPEN / SCG / SCB / DRIFT.\",\"version\":\"1.0\"},\"rq-io-in-06\":{\"id\":\"rq-io-in-06\",\"kind\":\"requirement\",\"name\":\"T_Fuel\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-IN-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B10, X2-36 → AN3; NTC table; 100 ms, PT1 τ = 2 s; window 0.18–4.82 V.\",\"version\":\"1.0\"},\"rq-io-in-07\":{\"id\":\"rq-io-in-07\",\"kind\":\"requirement\",\"name\":\"p_Oil\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-IN-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B110, X2-32 → AN4; p = 1.25 · (V − 0.5) bar; 10 ms, 8-sample mean; window 0.25–4.75 V.\",\"version\":\"1.0\"},\"rq-io-in-08\":{\"id\":\"rq-io-in-08\",\"kind\":\"requirement\",\"name\":\"T_Oil\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-IN-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B11, X2-39 → AN5; NTC table; 100 ms, PT1 τ = 2 s; window 0.18–4.82 V.\",\"version\":\"1.0\"},\"rq-io-in-09\":{\"id\":\"rq-io-in-09\",\"kind\":\"requirement\",\"name\":\"L_Oil\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-IN-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B14, X2-33 / 49 → AN6; ΔV during heat pulse → level; at init; DTC 2515 / 2516.\",\"version\":\"1.0\"},\"rq-io-in-10\":{\"id\":\"rq-io-in-10\",\"kind\":\"requirement\",\"name\":\"p_Baro\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-IN-10\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"On-board sensor → AN7 (TBV); p = 0.5 + 0.1625 · (V − 0.5) bar; 1000 ms, PT1 τ = 5 s; window 0.25–4.75 V.\",\"version\":\"1.0\"},\"rq-io-in-11\":{\"id\":\"rq-io-in-11\",\"kind\":\"requirement\",\"name\":\"U_Bat\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-IN-11\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"KL.30 divider → AN8 (TBV); U = V · 11.8 / 1.8 (24 V → 749); 10 ms, 4-sample mean; < 16 V or > 32 V.\",\"version\":\"1.0\"},\"rq-io-in-12\":{\"id\":\"rq-io-in-12\",\"kind\":\"requirement\",\"name\":\"b_Kl15 / b_Kl50\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-IN-12\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"X1-15 / X1-8 via U4 + port pin; 10 ms, debounce 30 ms; U1 / U4 disagree, KL.50 stuck > 30 s.\",\"version\":\"1.0\"},\"rq-io-in-13\":{\"id\":\"rq-io-in-13\",\"kind\":\"requirement\",\"name\":\"b_BlkStart / b_BlkStop\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-IN-13\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"X2-25 / X2-35 (common X2-30) via U4; 10 ms, debounce 50 ms; both active → ignore start.\",\"version\":\"1.0\"},\"rq-io-in-14\":{\"id\":\"rq-io-in-14\",\"kind\":\"requirement\",\"name\":\"st_InjTrip[bank]\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-IN-14\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"U3 (from LM2901D) → port / external interrupt: PEAK, BIP, OC, OPEN per bank; interrupt; OvercurrentTrip → BankShortDetected.\",\"version\":\"1.0\"},\"rq-io-in-15\":{\"id\":\"rq-io-in-15\",\"kind\":\"requirement\",\"name\":\"rx_TorqueReq / rx_Immo\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-IN-15\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"IES-CAN (X1-1 / X1-2) → CAN module; 20 ms / event; counter + CRC; timeout 200 ms / 2 s.\",\"version\":\"1.0\"},\"rq-io-out-01\":{\"id\":\"rq-io-out-01\",\"kind\":\"requirement\",\"name\":\"soi_Cyl[1..8] / eoi_Cyl\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-OUT-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"U3 → Q_HS1/2, Q_LS1–8 → X2-54/53/47/45/44/38 (46/37 V8); CAPCOM compare out; SOI pulse + cylinder select, angle-based; safe state: no SOI, EOI forced.\",\"version\":\"1.0\"},\"rq-io-out-02\":{\"id\":\"rq-io-out-02\",\"kind\":\"requirement\",\"name\":\"injEnable / driversTristated\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-OUT-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"U3, gate drivers; port pin (+ U4); on state change; safe state tristated.\",\"version\":\"1.0\"},\"rq-io-out-03\":{\"id\":\"rq-io-out-03\",\"kind\":\"requirement\",\"name\":\"starter\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-OUT-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Q_HS4 → X2-18 ∥ X1-12; port pin with U4 interlock; 10 ms; safe state off.\",\"version\":\"1.0\"},\"rq-io-out-04\":{\"id\":\"rq-io-out-04\",\"kind\":\"requirement\",\"name\":\"pv1, pv2 (engine brake)\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-OUT-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"X2-51, X2-50; port pins on / off; 10 ms; safe state off.\",\"version\":\"1.0\"},\"rq-io-out-05\":{\"id\":\"rq-io-out-05\",\"kind\":\"requirement\",\"name\":\"pv3DutyPct (fan clutch)\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-OUT-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"X2-41 ∥ X1-14; PWM 0–100 % (frequency TBV); 100 ms; safe state 100 % (fan on).\",\"version\":\"1.0\"},\"rq-io-out-06\":{\"id\":\"rq-io-out-06\",\"kind\":\"requirement\",\"name\":\"pv4 (auxiliary)\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-OUT-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"X2-43 ∥ X1-16; port pin on / off; 10 ms; safe state off.\",\"version\":\"1.0\"},\"rq-io-out-07\":{\"id\":\"rq-io-out-07\",\"kind\":\"requirement\",\"name\":\"hsValveSupply\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-OUT-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Q_HS3 → X2-12 / 52; port pin; on state change; safe state off.\",\"version\":\"1.0\"},\"rq-io-out-08\":{\"id\":\"rq-io-out-08\",\"kind\":\"requirement\",\"name\":\"powerLatch\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"high\",\"requirementId\":\"IO-OUT-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"TLE4275 / latch circuit; port pin; held until after-run done.\",\"version\":\"1.0\"},\"rq-io-out-09\":{\"id\":\"rq-io-out-09\",\"kind\":\"requirement\",\"name\":\"wdTrigger\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"critical\",\"requirementId\":\"IO-OUT-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"U4; port pin / D04 link; window trigger every 10 ms (PROPOSED).\",\"version\":\"1.0\"},\"rq-io-out-10\":{\"id\":\"rq-io-out-10\",\"kind\":\"requirement\",\"name\":\"oilLvlPulse\",\"namespace\":[],\"ownerId\":\"rq-hw-io-00\",\"priority\":\"medium\",\"requirementId\":\"IO-OUT-10\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"B14 driver; port pin heat pulse at init; safe state off.\",\"version\":\"1.0\"},\"rq-iort-01\":{\"id\":\"rq-iort-01\",\"kind\":\"requirement\",\"name\":\"CKP / CMP edge capture\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Capture on every edge (CC0 / CC1); latency to use 20 µs; jitter ≤ 2 µs; timer resolution ≤ 0.4 µs (CAPCOM at 20 MHz / 8).\",\"version\":\"1.0\"},\"rq-iort-02\":{\"id\":\"rq-iort-02\",\"kind\":\"requirement\",\"name\":\"SOI / EOI compare\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Compare match with hardware output; jitter ≤ 1 µs; next compare programmed ≥ 100 µs before the event.\",\"version\":\"1.0\"},\"rq-iort-03\":{\"id\":\"rq-iort-03\",\"kind\":\"requirement\",\"name\":\"Injection trip flags\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"External interrupt; latency to use 100 µs (the hardware has already cut off the driver).\",\"version\":\"1.0\"},\"rq-iort-04\":{\"id\":\"rq-iort-04\",\"kind\":\"requirement\",\"name\":\"Boost, oil pressure, U_Bat\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"IORT-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ADC scan every 10 ms; latency to use 20 ms; jitter ≤ 1 ms; 10-bit conversion ≈ 10 µs per channel.\",\"version\":\"1.0\"},\"rq-iort-05\":{\"id\":\"rq-iort-05\",\"kind\":\"requirement\",\"name\":\"Temperatures, oil level, baro\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"medium\",\"requirementId\":\"IORT-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ADC scan every 100 ms / 1 s; latency to use 200 ms / 2 s; jitter ≤ 5 ms.\",\"version\":\"1.0\"},\"rq-iort-06\":{\"id\":\"rq-iort-06\",\"kind\":\"requirement\",\"name\":\"KL.15, KL.50, buttons\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"10 ms poll + debounce; latency to use 40–60 ms; jitter ≤ 10 ms; cross-checked with U4.\",\"version\":\"1.0\"},\"rq-iort-07\":{\"id\":\"rq-iort-07\",\"kind\":\"requirement\",\"name\":\"TorqueRequestFrame Rx\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Rx interrupt → buffer, processed in the 10 ms task; latency 10 ms; counter and CRC checked on receipt.\",\"version\":\"1.0\"},\"rq-iort-08\":{\"id\":\"rq-iort-08\",\"kind\":\"requirement\",\"name\":\"CAN Tx (EEC1, status)\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"IORT-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Cyclic 20 / 100 ms; period ± 10 %; jitter ≤ 2 ms (J1939 cyclic tolerance).\",\"version\":\"1.0\"},\"rq-iort-09\":{\"id\":\"rq-iort-09\",\"kind\":\"requirement\",\"name\":\"Starter, PV1 / PV2 / PV4 outputs\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"IORT-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Updated in the 10 ms task; latency 10 ms; driver delay ≤ 1 ms.\",\"version\":\"1.0\"},\"rq-iort-10\":{\"id\":\"rq-iort-10\",\"kind\":\"requirement\",\"name\":\"PV3 PWM duty\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"IORT-10\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Updated in the 100 ms task; duty = (T − 92) × 12.5 %.\",\"version\":\"1.0\"},\"rq-iort-11\":{\"id\":\"rq-iort-11\",\"kind\":\"requirement\",\"name\":\"EEPROM write\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"IORT-11\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Background, in after-run; ≤ 10 ms per word (M93C86 self-timed write).\",\"version\":\"1.0\"},\"rq-kwp-01\":{\"id\":\"rq-kwp-01\",\"kind\":\"requirement\",\"name\":\"Communication and sessions\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"high\",\"requirementId\":\"KWP-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"0x81 / 0x82 StartCommunication / StopCommunication (fast init 25 ms or 5-baud init), 0x10 StartDiagnosticSession (default, extended, programming), 0x3E TesterPresent, 0x11 EcuReset (extended / programming).\",\"version\":\"1.0\"},\"rq-kwp-02\":{\"id\":\"rq-kwp-02\",\"kind\":\"requirement\",\"name\":\"Identification and live data\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"high\",\"requirementId\":\"KWP-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"0x1A ReadEcuIdentification (part no., SW / HW version, engine no. 541.922-00-063818), 0x21 ReadDataByLocalIdentifier (rpm, sensors, sync mode, state).\",\"version\":\"1.0\"},\"rq-kwp-03\":{\"id\":\"rq-kwp-03\",\"kind\":\"requirement\",\"name\":\"Fault memory services\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"high\",\"requirementId\":\"KWP-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"0x18 ReadDiagnosticTroubleCodesByStatus (MR code, SPN / FMI, severity, status), 0x17 ReadStatusOfDiagnosticTroubleCodes (freeze frame), 0x14 ClearDiagnosticInformation (extended session).\",\"version\":\"1.0\"},\"rq-kwp-04\":{\"id\":\"rq-kwp-04\",\"kind\":\"requirement\",\"name\":\"Security, coding and actuator test\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"critical\",\"requirementId\":\"KWP-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"0x27 SecurityAccess (seed and key), 0x3B WriteDataByLocalIdentifier (V6 / V8 coding, immobiliser pairing, level 2), 0x30 InputOutputControlByLocalIdentifier (PV and cylinder cut-out test, level 1).\",\"version\":\"1.0\"},\"rq-kwp-05\":{\"id\":\"rq-kwp-05\",\"kind\":\"requirement\",\"name\":\"Reprogramming\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"critical\",\"requirementId\":\"KWP-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"0x31 / 0x33 StartRoutine / RequestRoutineResults, 0x34 / 0x36 / 0x37 RequestDownload / TransferData / RequestTransferExit for code 0x04000–5FFFF and data set 0x60000–7FEFF (programming session, level 3).\",\"version\":\"1.0\"},\"rq-kwp-06\":{\"id\":\"rq-kwp-06\",\"kind\":\"requirement\",\"name\":\"Diagnostic timing and restrictions\",\"namespace\":[],\"ownerId\":\"rq-sw-kwp-00\",\"priority\":\"high\",\"requirementId\":\"KWP-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"P2 (ECU response) 25–50 ms, P3 55 ms – 5 s, 10.4 kbit/s. With the engine running only read services; 0x30, 0x31 and 0x34 only at engine speed 0 in ST_READY.\",\"version\":\"1.0\"},\"rq-mcu-01\":{\"id\":\"rq-mcu-01\",\"kind\":\"requirement\",\"name\":\"Angle timer unit\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 2 capture + ≥ 18 compare channels (8 SOI, 8 EOI, 2 PWM); resolution ≤ 0.05° at 2300 rpm (≤ 3.6 µs); decodes 36 + ref and 12 + 1 patterns.\",\"version\":\"1.0\"},\"rq-mcu-02\":{\"id\":\"rq-mcu-02\",\"kind\":\"requirement\",\"name\":\"CPU throughput\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CPU load ≤ 70 % at 2300 rpm, 8 cylinders, for the task set.\",\"version\":\"1.0\"},\"rq-mcu-03\":{\"id\":\"rq-mcu-03\",\"kind\":\"requirement\",\"name\":\"ADC\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 12 channels, ≥ 10-bit (12-bit preferred), 5 V reference range, ≤ 10 µs per conversion.\",\"version\":\"1.0\"},\"rq-mcu-04\":{\"id\":\"rq-mcu-04\",\"kind\":\"requirement\",\"name\":\"CAN controllers\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 1 for IES-CAN (2 preferred: calibration / future), 29-bit IDs, ≥ 16 message objects.\",\"version\":\"1.0\"},\"rq-mcu-05\":{\"id\":\"rq-mcu-05\",\"kind\":\"requirement\",\"name\":\"Serial interfaces\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"1 UART (K-line), 1 SPI (EEPROM / co-processor).\",\"version\":\"1.0\"},\"rq-mcu-06\":{\"id\":\"rq-mcu-06\",\"kind\":\"requirement\",\"name\":\"Program memory\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 512 KB for the current function, ≥ 1 MB for a new design (100 % growth).\",\"version\":\"1.0\"},\"rq-mcu-07\":{\"id\":\"rq-mcu-07\",\"kind\":\"requirement\",\"name\":\"RAM\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"high\",\"requirementId\":\"MCU-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 32 KB (≥ 25 % free at release). Finding N-01: the C167CS has ≈ 11 KB; waiver with a measured budget or external SRAM.\",\"version\":\"1.0\"},\"rq-mcu-08\":{\"id\":\"rq-mcu-08\",\"kind\":\"requirement\",\"name\":\"Non-volatile data\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"External EEPROM or data-flash with EEPROM emulation, ≥ 2 KB, ≥ 10⁵ cycles.\",\"version\":\"1.0\"},\"rq-mcu-09\":{\"id\":\"rq-mcu-09\",\"kind\":\"requirement\",\"name\":\"Temperature and qualification\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"−40 to +125 °C ambient (AEC-Q100 Grade 1), engine-mounted ECU.\",\"version\":\"1.0\"},\"rq-mcu-10\":{\"id\":\"rq-mcu-10\",\"kind\":\"requirement\",\"name\":\"Functional-safety support\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-10\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ISO 26262 safety manual; ECC on flash and RAM; lockstep core or equivalent for ASIL B.\",\"version\":\"1.0\"},\"rq-mcu-11\":{\"id\":\"rq-mcu-11\",\"kind\":\"requirement\",\"name\":\"Security\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"high\",\"requirementId\":\"MCU-11\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Hardware security module (secure boot, key storage, MAC) for UN R155 / ISO/SAE 21434.\",\"version\":\"1.0\"},\"rq-mcu-12\":{\"id\":\"rq-mcu-12\",\"kind\":\"requirement\",\"name\":\"Independent watchdog\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-12\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Internal window watchdog plus an external watchdog / safety supervisor.\",\"version\":\"1.0\"},\"rq-mcu-13\":{\"id\":\"rq-mcu-13\",\"kind\":\"requirement\",\"name\":\"Supply longevity\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"critical\",\"requirementId\":\"MCU-13\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"≥ 15 years of production availability from selection.\",\"version\":\"1.0\"},\"rq-mcu-14\":{\"id\":\"rq-mcu-14\",\"kind\":\"requirement\",\"name\":\"Software ecosystem\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"high\",\"requirementId\":\"MCU-14\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Qualified C compiler (ISO 26262-8), MCAL (AUTOSAR or vendor HAL), Simulink Embedded Coder target support.\",\"version\":\"1.0\"},\"rq-mcu-15\":{\"id\":\"rq-mcu-15\",\"kind\":\"requirement\",\"name\":\"Floating point\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"high\",\"requirementId\":\"MCU-15\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"FPU preferred; without an FPU all generated code must be fixed point.\",\"version\":\"1.0\"},\"rq-mcu-16\":{\"id\":\"rq-mcu-16\",\"kind\":\"requirement\",\"name\":\"Debug and calibration access\",\"namespace\":[],\"ownerId\":\"rq-hw-mcu-00\",\"priority\":\"high\",\"requirementId\":\"MCU-16\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"On-chip debug (JTAG / DAP) and CCP / XCP support.\",\"version\":\"1.0\"},\"rq-rt-01\":{\"id\":\"rq-rt-01\",\"kind\":\"requirement\",\"name\":\"Crank angle → SOI\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Crank angle → start of injection: SOI accuracy ± 0.1° crank (± 7 µs at 2300 rpm); scheduling resolution ≤ 0.05°.\",\"version\":\"1.0\"},\"rq-rt-02\":{\"id\":\"rq-rt-02\",\"kind\":\"requirement\",\"name\":\"CKP / CMP edge → ISR\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CKP / CMP edge → ISR start ≤ 20 µs latency, ≤ 50 µs execution (0.72 ms slot at 2300 rpm).\",\"version\":\"1.0\"},\"rq-rt-03\":{\"id\":\"rq-rt-03\",\"kind\":\"requirement\",\"name\":\"Pedal → injection\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Pedal change (FR / CPC) → first injection with the new quantity ≤ 75 ms at idle, ≤ 60 ms at ≥ 1200 rpm (20 ms CAN + 10 ms calculation + one firing interval).\",\"version\":\"1.0\"},\"rq-rt-04\":{\"id\":\"rq-rt-04\",\"kind\":\"requirement\",\"name\":\"CKP lost → CMP timing\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CKP lost → injection timed from CMP within 1 crank revolution; at most 1 missed injection.\",\"version\":\"1.0\"},\"rq-rt-05\":{\"id\":\"rq-rt-05\",\"kind\":\"requirement\",\"name\":\"CKP + CMP lost → inhibit\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-05\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CKP and CMP lost → injection inhibited before the next SOI (≤ 1 firing interval).\",\"version\":\"1.0\"},\"rq-rt-06\":{\"id\":\"rq-rt-06\",\"kind\":\"requirement\",\"name\":\"Overcurrent → driver off\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-06\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Coil current > 24 A → driver off: HW ≤ 10 µs (U3, no SW). SW: BankShortDetected and DTC ≤ 10 ms; cylinder kept cut off.\",\"version\":\"1.0\"},\"rq-rt-07\":{\"id\":\"rq-rt-07\",\"kind\":\"requirement\",\"name\":\"KL.15 on → ST_READY\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-07\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"KL.15 on → ST_READY ≤ 500 ms, including self-test, EEPROM read and immobiliser check.\",\"version\":\"1.0\"},\"rq-rt-08\":{\"id\":\"rq-rt-08\",\"kind\":\"requirement\",\"name\":\"Start request → starter on\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-08\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"KL.50 or block start (in ST_READY) → starter on ≤ 50 ms.\",\"version\":\"1.0\"},\"rq-rt-09\":{\"id\":\"rq-rt-09\",\"kind\":\"requirement\",\"name\":\"n > 500 rpm → starter off\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-09\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Engine speed > 500 rpm → starter off ≤ 50 ms (ST_CRANK_SYNC exit).\",\"version\":\"1.0\"},\"rq-rt-10\":{\"id\":\"rq-rt-10\",\"kind\":\"requirement\",\"name\":\"Invalid immobiliser code\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-10\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Invalid immobiliser code → ST_IMMO_LOCKED ≤ 100 ms after the frame; starter and injection blocked.\",\"version\":\"1.0\"},\"rq-rt-11\":{\"id\":\"rq-rt-11\",\"kind\":\"requirement\",\"name\":\"Torque request lost → limp\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-11\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Torque request lost → ST_LIMP_DERATE: detection 200 ms; derate active ≤ 10 ms later.\",\"version\":\"1.0\"},\"rq-rt-12\":{\"id\":\"rq-rt-12\",\"kind\":\"requirement\",\"name\":\"Watchdog not served → safe state\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"critical\",\"requirementId\":\"RT-12\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Watchdog not served → drivers tristated and injection off ≤ 50 ms.\",\"version\":\"1.0\"},\"rq-rt-13\":{\"id\":\"rq-rt-13\",\"kind\":\"requirement\",\"name\":\"Engine-brake request\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"RT-13\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Engine-brake request → PV1 + PV2 on ≤ 50 ms; injection cut from the next SOI.\",\"version\":\"1.0\"},\"rq-rt-14\":{\"id\":\"rq-rt-14\",\"kind\":\"requirement\",\"name\":\"Coolant ≥ 103 °C → derate\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"RT-14\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Coolant ≥ 103 °C → warning and derate ≤ 1 s (100 ms sample + filter).\",\"version\":\"1.0\"},\"rq-rt-15\":{\"id\":\"rq-rt-15\",\"kind\":\"requirement\",\"name\":\"Sensor fault → substitute\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"RT-15\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Sensor out of window → substitute ≤ 100 ms; DTC confirmed after 500 ms debounce.\",\"version\":\"1.0\"},\"rq-rt-16\":{\"id\":\"rq-rt-16\",\"kind\":\"requirement\",\"name\":\"KL.15 off → latch released\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"RT-16\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"KL.15 off → after-run complete and power latch released ≤ 5 s (TBV); EEPROM write ≤ 10 ms per word.\",\"version\":\"1.0\"},\"rq-rt-17\":{\"id\":\"rq-rt-17\",\"kind\":\"requirement\",\"name\":\"Tester request → response\",\"namespace\":[],\"ownerId\":\"rq-sw-rt-00\",\"priority\":\"high\",\"requirementId\":\"RT-17\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Tester request → response P2 = 25–50 ms (ISO 14230-2).\",\"version\":\"1.0\"},\"rq-spec-can-01\":{\"id\":\"rq-spec-can-01\",\"kind\":\"requirement\",\"name\":\"Cyclic accuracy\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-CAN-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall transmit cyclic messages with period accuracy ± 10 % and jitter ≤ 2 ms (J1939 tolerance).\",\"version\":\"1.0\"},\"rq-spec-can-02\":{\"id\":\"rq-spec-can-02\",\"kind\":\"requirement\",\"name\":\"Alive counter and CRC\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-CAN-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Every P1 frame (torque request, immobiliser) shall carry a 4-bit alive counter and an 8-bit CRC that the receiver checks before using any signal (finding N-02: counter at bits 48–51, CRC8 in byte 7).\",\"version\":\"1.0\"},\"rq-spec-can-03\":{\"id\":\"rq-spec-can-03\",\"kind\":\"requirement\",\"name\":\"Torque request latency\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-CAN-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"A received TorqueRequestFrame shall be available to the application within 10 ms of reception.\",\"version\":\"1.0\"},\"rq-spec-can-04\":{\"id\":\"rq-spec-can-04\",\"kind\":\"requirement\",\"name\":\"Torque request loss (SPEC-CAN-04)\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-CAN-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Loss of the torque request for 200 ms shall put the engine into ST_LIMP_DERATE within a further 10 ms (RT-11).\",\"version\":\"1.0\"},\"rq-spec-can-05\":{\"id\":\"rq-spec-can-05\",\"kind\":\"requirement\",\"name\":\"Bus-off\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-CAN-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Bus-off shall recover automatically; 3 bus-offs within 10 s shall set DTC 2003 and keep CAN_TIMEOUT handling.\",\"version\":\"1.0\"},\"rq-spec-can-06\":{\"id\":\"rq-spec-can-06\",\"kind\":\"requirement\",\"name\":\"Bus load\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-CAN-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Bus load caused by the MCM shall stay ≤ 40 % in all modes, including DM1 with the full fault memory and CCP during development.\",\"version\":\"1.0\"},\"rq-spec-can-07\":{\"id\":\"rq-spec-can-07\",\"kind\":\"requirement\",\"name\":\"Authenticated immobiliser\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-CAN-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The immobiliser exchange shall be replaced by challenge–response with a rolling counter and a MAC before series release (S-06, UN R155).\",\"version\":\"1.0\"},\"rq-spec-can-08\":{\"id\":\"rq-spec-can-08\",\"kind\":\"requirement\",\"name\":\"Not-available values\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-CAN-08\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Signals marked not available shall be sent as 0xFF / 0xFFFF; received n/a values shall be treated as invalid.\",\"version\":\"1.0\"},\"rq-spec-can-09\":{\"id\":\"rq-spec-can-09\",\"kind\":\"requirement\",\"name\":\"Calibration protocol off in series\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-CAN-09\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The CCP / XCP calibration protocol shall be disabled in series software.\",\"version\":\"1.0\"},\"rq-spec-eep-01\":{\"id\":\"rq-spec-eep-01\",\"kind\":\"requirement\",\"name\":\"CRC and redundant copy\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-EEP-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Every NvM block shall carry a CRC; immobiliser, identification and adaptation blocks shall have a redundant copy.\",\"version\":\"1.0\"},\"rq-spec-eep-02\":{\"id\":\"rq-spec-eep-02\",\"kind\":\"requirement\",\"name\":\"Corrupt pairing block\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-EEP-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"A corrupt immobiliser block (both copies) shall lock the immobiliser and set DTC 3002.\",\"version\":\"1.0\"},\"rq-spec-eep-03\":{\"id\":\"rq-spec-eep-03\",\"kind\":\"requirement\",\"name\":\"Authenticated pairing write (SPEC-EEP-03)\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-EEP-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Writes to the pairing block shall be possible only in an authenticated session (0x27 level 2).\",\"version\":\"1.0\"},\"rq-spec-eep-04\":{\"id\":\"rq-spec-eep-04\",\"kind\":\"requirement\",\"name\":\"After-run completion\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-EEP-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"AfterrunComplete shall be raised only after the last write has been verified (nvmWriteDone).\",\"version\":\"1.0\"},\"rq-spec-eep-05\":{\"id\":\"rq-spec-eep-05\",\"kind\":\"requirement\",\"name\":\"Power latch hold\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-EEP-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The power latch shall be held until nvmWriteDone or a 5 s after-run timeout (RT-16, TBV), whichever comes first; a timeout shall be logged at the next start.\",\"version\":\"1.0\"},\"rq-spec-eep-06\":{\"id\":\"rq-spec-eep-06\",\"kind\":\"requirement\",\"name\":\"EEPROM use and endurance\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-EEP-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"EEPROM use ≤ 80 % and ≥ 10⁵ write cycles over life per cell with wear-levelling.\",\"version\":\"1.0\"},\"rq-spec-eep-07\":{\"id\":\"rq-spec-eep-07\",\"kind\":\"requirement\",\"name\":\"Write enable window\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-EEP-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"EWEN shall be issued immediately before each write and EWDS immediately after, to protect against spurious writes at power dips.\",\"version\":\"1.0\"},\"rq-spec-fls-01\":{\"id\":\"rq-spec-fls-01\",\"kind\":\"requirement\",\"name\":\"Flash wait states\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-FLS-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The EBC shall be configured with enough wait states that worst-case flash access time (90 ns + bus delays) is met over −40…+125 °C (TBV).\",\"version\":\"1.0\"},\"rq-spec-fls-02\":{\"id\":\"rq-spec-fls-02\",\"kind\":\"requirement\",\"name\":\"Segment-0 window\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-FLS-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The linker file shall keep code and constants out of the segment-0 address window covered by on-chip RAM and SFRs (finding N-06).\",\"version\":\"1.0\"},\"rq-spec-fls-03\":{\"id\":\"rq-spec-fls-03\",\"kind\":\"requirement\",\"name\":\"Protected bootloader\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-FLS-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The bootloader in SA0 shall never be erased by field reprogramming; only BSL in production may rewrite it.\",\"version\":\"1.0\"},\"rq-spec-fls-04\":{\"id\":\"rq-spec-fls-04\",\"kind\":\"requirement\",\"name\":\"Checksum after SA10 erase\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-FLS-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Every erase of SA10 shall be followed by rewriting the checksum block; an interrupted session shall leave the ECU in the bootloader (N-05).\",\"version\":\"1.0\"},\"rq-spec-fls-05\":{\"id\":\"rq-spec-fls-05\",\"kind\":\"requirement\",\"name\":\"Programming from RAM\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-FLS-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Flash programming routines shall execute from on-chip RAM.\",\"version\":\"1.0\"},\"rq-spec-fls-06\":{\"id\":\"rq-spec-fls-06\",\"kind\":\"requirement\",\"name\":\"Flashing conditions\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-FLS-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Flash erase / program shall be allowed only at engine speed 0 in ST_READY with security level 3.\",\"version\":\"1.0\"},\"rq-spec-fls-07\":{\"id\":\"rq-spec-fls-07\",\"kind\":\"requirement\",\"name\":\"Flash use\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-FLS-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Code area use ≤ 80 % and data-set use ≤ 80 % at release.\",\"version\":\"1.0\"},\"rq-spec-sig-01\":{\"id\":\"rq-spec-sig-01\",\"kind\":\"requirement\",\"name\":\"Engine speed\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-SIG-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Engine speed shall be computed from the CKP tooth period with ≤ 0.4 µs time base, accurate to ± 0.2 % from 60 to 2300 rpm (PROPOSED); decoding valid up to 8000 rpm.\",\"version\":\"1.0\"},\"rq-spec-sig-02\":{\"id\":\"rq-spec-sig-02\",\"kind\":\"requirement\",\"name\":\"SOI angle error budget\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-SIG-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The SOI angle error budget (quantisation + capture jitter + compare jitter + extrapolation) shall be ≤ 0.1° at 2300 rpm.\",\"version\":\"1.0\"},\"rq-spec-sig-03\":{\"id\":\"rq-spec-sig-03\",\"kind\":\"requirement\",\"name\":\"Boost pressure\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Boost pressure (B111-P, X2-29, AN0, 0.6–3.4 bar abs, ratiometric 0.5–4.5 V) sampled every 10 ms (mean of 4), accurate to ± 50 mbar (PROPOSED), available within 20 ms.\",\"version\":\"1.0\"},\"rq-spec-sig-04\":{\"id\":\"rq-spec-sig-04\",\"kind\":\"requirement\",\"name\":\"Coolant temperature\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Coolant temperature (B65 NTC, X2-34, AN2) accurate to ± 2 °C over 80–110 °C (PROPOSED); fault → 90 °C substitute and fan 100 %; warning at ≥ 103 °C within 1 s.\",\"version\":\"1.0\"},\"rq-spec-sig-05\":{\"id\":\"rq-spec-sig-05\",\"kind\":\"requirement\",\"name\":\"Oil pressure\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Oil pressure (B110, X2-32, AN4, 0–5 bar) sampled every 10 ms (mean of 8), accurate to ± 0.1 bar (PROPOSED); low oil pressure confirmed after 2 s below the map.\",\"version\":\"1.0\"},\"rq-spec-sig-06\":{\"id\":\"rq-spec-sig-06\",\"kind\":\"requirement\",\"name\":\"Air, fuel and oil temperatures\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"medium\",\"requirementId\":\"SPEC-SIG-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Intake-air (X2-48, AN1), fuel (X2-36, AN3) and oil (X2-39, AN5) temperatures sampled every 100 ms with ± 2 / ± 3 / ± 3 °C accuracy (PROPOSED); substitutes on fault.\",\"version\":\"1.0\"},\"rq-spec-sig-07\":{\"id\":\"rq-spec-sig-07\",\"kind\":\"requirement\",\"name\":\"Battery voltage\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Battery voltage (KL.30 divider 11.8 / 1.8, AN8) sampled every 10 ms with ± 0.3 V accuracy (PROPOSED); < 16 V or > 32 V for 1 s sets DTC 1081.\",\"version\":\"1.0\"},\"rq-spec-sig-08\":{\"id\":\"rq-spec-sig-08\",\"kind\":\"requirement\",\"name\":\"Barometric pressure\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"medium\",\"requirementId\":\"SPEC-SIG-08\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Barometric pressure (on-board sensor, AN7) sampled every 1 s with ± 15 mbar accuracy (PROPOSED); substitute 1.013 bar on fault.\",\"version\":\"1.0\"},\"rq-spec-sig-09\":{\"id\":\"rq-spec-sig-09\",\"kind\":\"requirement\",\"name\":\"Channel classification\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-09\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Every analogue channel shall be classified NORMAL / OPEN / SCG / SCB / DRIFT; the substitute shall apply ≤ 100 ms and the DTC be confirmed after 500 ms outside the window (RT-15).\",\"version\":\"1.0\"},\"rq-spec-sig-10\":{\"id\":\"rq-spec-sig-10\",\"kind\":\"requirement\",\"name\":\"Discrete inputs\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-SIG-10\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"KL.15 (X1-15) and KL.50 (X1-8) debounced 30 ms, block start / stop (X2-25 / X2-35) 50 ms; a debounced change reaches the mode manager ≤ 60 ms after the edge.\",\"version\":\"1.0\"},\"rq-spec-sig-11\":{\"id\":\"rq-spec-sig-11\",\"kind\":\"requirement\",\"name\":\"Starter output\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-SIG-11\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The starter (Q_HS4 → X2-18 ∥ X1-12) shall switch on ≤ 50 ms after a valid start request in ST_READY and off ≤ 50 ms after engine speed exceeds 500 rpm.\",\"version\":\"1.0\"},\"rq-spec-sig-12\":{\"id\":\"rq-spec-sig-12\",\"kind\":\"requirement\",\"name\":\"Engine-brake valves\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-12\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"An engine-brake request with pedal 0 % shall energise PV1 (X2-51) + PV2 (X2-50) ≤ 50 ms and cut injection from the next SOI.\",\"version\":\"1.0\"},\"rq-spec-sig-13\":{\"id\":\"rq-spec-sig-13\",\"kind\":\"requirement\",\"name\":\"Fan-clutch PWM\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-SIG-13\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"PV3 (X2-41 ∥ X1-14) shall be driven by PWM with ≤ 1 % duty resolution, duty = (T_coolant − 92 °C) × 12.5 %, updated every 100 ms.\",\"version\":\"1.0\"},\"rq-spec-sig-14\":{\"id\":\"rq-spec-sig-14\",\"kind\":\"requirement\",\"name\":\"Pedal to injection\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-SIG-14\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"A pedal change received on CAN shall reach the first changed injection ≤ 75 ms at idle and ≤ 60 ms at ≥ 1200 rpm.\",\"version\":\"1.0\"},\"rq-spec-sig-15\":{\"id\":\"rq-spec-sig-15\",\"kind\":\"requirement\",\"name\":\"V8 outputs\",\"namespace\":[],\"ownerId\":\"rq-hw-sig-00\",\"priority\":\"medium\",\"requirementId\":\"SPEC-SIG-15\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Cylinder 7 / 8 outputs shall be active only when the EEPROM variant coding is V8.\",\"version\":\"1.0\"},\"rq-spec-u1-01\":{\"id\":\"rq-spec-u1-01\",\"kind\":\"requirement\",\"name\":\"Edge time-stamping\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall time-stamp every CKP and CMP edge in hardware capture with a time base of ≤ 0.4 µs and start the corresponding ISR within 20 µs (RT-02).\",\"version\":\"1.0\"},\"rq-spec-u1-02\":{\"id\":\"rq-spec-u1-02\",\"kind\":\"requirement\",\"name\":\"SOI / EOI by compare match\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall generate SOI and EOI as CAPCOM compare-match pin events, never by software toggling, and program each compare ≥ 100 µs before the event.\",\"version\":\"1.0\"},\"rq-spec-u1-03\":{\"id\":\"rq-spec-u1-03\",\"kind\":\"requirement\",\"name\":\"Safe outputs from reset\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"All U1 outputs to U3 and to the valve / starter drivers shall be in their safe state (off, INJ_EN = 0) from reset until the start-up code sets them deliberately.\",\"version\":\"1.0\"},\"rq-spec-u1-04\":{\"id\":\"rq-spec-u1-04\",\"kind\":\"requirement\",\"name\":\"ADC scan plan\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-U1-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall scan AN0, AN4, AN8 every 10 ms and AN1–AN3, AN5 every 100 ms, AN7 every 1 s, AN6 at initialisation, and store raw codes with a validity flag.\",\"version\":\"1.0\"},\"rq-spec-u1-05\":{\"id\":\"rq-spec-u1-05\",\"kind\":\"requirement\",\"name\":\"Watchdog service from TASK_10ms\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall serve the U4 watchdog only from TASK_10ms and only after the deadline monitor confirms that all higher-rate work of the last window finished.\",\"version\":\"1.0\"},\"rq-spec-u1-06\":{\"id\":\"rq-spec-u1-06\",\"kind\":\"requirement\",\"name\":\"KL.15 cross-check\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall read KL.15 on its own port pin and compare it with the U4-reported state; a disagreement for > 50 ms shall set a DTC (PROPOSED).\",\"version\":\"1.0\"},\"rq-spec-u1-07\":{\"id\":\"rq-spec-u1-07\",\"kind\":\"requirement\",\"name\":\"Flash checksum at start\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U1 shall verify the flash checksum at every start before jumping from the bootloader to the application.\",\"version\":\"1.0\"},\"rq-spec-u1-08\":{\"id\":\"rq-spec-u1-08\",\"kind\":\"requirement\",\"name\":\"CPU load (SPEC-U1-08)\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-08\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"CPU load ≤ 70 % average and ≤ 85 % in any 10 ms window at 2300 rpm, 8 cylinders, shown by WCET analysis and measurement.\",\"version\":\"1.0\"},\"rq-spec-u1-09\":{\"id\":\"rq-spec-u1-09\",\"kind\":\"requirement\",\"name\":\"RAM and stack\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-09\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Internal RAM and stack shall keep ≥ 25 % free at release; stack overflow / underflow traps shall lead to ST_FAULT_SHUTDOWN.\",\"version\":\"1.0\"},\"rq-spec-u1-10\":{\"id\":\"rq-spec-u1-10\",\"kind\":\"requirement\",\"name\":\"Inverted copies of P1 data\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-10\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"P1 variables (injEnable, starter, syncMode, torqueLimitPct) shall be stored with an inverted copy and checked before use (AR-04).\",\"version\":\"1.0\"},\"rq-spec-u1-11\":{\"id\":\"rq-spec-u1-11\",\"kind\":\"requirement\",\"name\":\"Atomic 32-bit data\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-11\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"32-bit values shared between ISRs and tasks shall be read and written atomically using ATOMIC / EXTR sequences or a short interrupt lock.\",\"version\":\"1.0\"},\"rq-spec-u1-12\":{\"id\":\"rq-spec-u1-12\",\"kind\":\"requirement\",\"name\":\"Interrupt lock time\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U1-12\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"No code shall disable interrupts, or raise the CPU priority to ILVL 14 or higher, for more than 10 µs.\",\"version\":\"1.0\"},\"rq-spec-u1-13\":{\"id\":\"rq-spec-u1-13\",\"kind\":\"requirement\",\"name\":\"Backup internal WDT\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-U1-13\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The internal WDT shall be enabled as a backup with a period longer than the U4 window.\",\"version\":\"1.0\"},\"rq-spec-u3-01\":{\"id\":\"rq-spec-u3-01\",\"kind\":\"requirement\",\"name\":\"Injection gate\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U3-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U3 shall start an injection only when INJ_EN from U1 is set and DRV_DISABLE from U4 is inactive; either signal alone shall stop all gate drive.\",\"version\":\"1.0\"},\"rq-spec-u3-02\":{\"id\":\"rq-spec-u3-02\",\"kind\":\"requirement\",\"name\":\"Overcurrent cut-off ≤ 10 µs\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U3-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U3 shall switch off the affected driver within 10 µs of a coil current above 24 A, keep the cylinder cut off and signal CYL_CUTOFF / BANK_SHORT to U1.\",\"version\":\"1.0\"},\"rq-spec-u3-03\":{\"id\":\"rq-spec-u3-03\",\"kind\":\"requirement\",\"name\":\"Cylinder select latch\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U3-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U3 shall latch CYL_SEL[2:0] at SOI; U1 shall keep CYL_SEL stable from ≥ 10 µs before SOI until EOI (PROPOSED).\",\"version\":\"1.0\"},\"rq-spec-u3-04\":{\"id\":\"rq-spec-u3-04\",\"kind\":\"requirement\",\"name\":\"Logic version\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-U3-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The U3 logic version shall be readable by U1 and reported over diagnostics together with the U1 software version.\",\"version\":\"1.0\"},\"rq-spec-u3-05\":{\"id\":\"rq-spec-u3-05\",\"kind\":\"requirement\",\"name\":\"Timer units fixed\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-U3-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The units of the U3 internal timers (SPILL 1 ms, BIP_WAIT 2 ms, PEAK timeout 2 ms) shall be fixed in the HDL and in the model before release (S-05).\",\"version\":\"1.0\"},\"rq-spec-u4-01\":{\"id\":\"rq-spec-u4-01\",\"kind\":\"requirement\",\"name\":\"Drivers disabled until watchdog OK\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-01\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U4 shall keep DRV_DISABLE active from power-up until it has received at least two consecutive correct watchdog answers (PROPOSED).\",\"version\":\"1.0\"},\"rq-spec-u4-02\":{\"id\":\"rq-spec-u4-02\",\"kind\":\"requirement\",\"name\":\"Reset and driver disable ≤ 50 ms\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-02\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U4 shall assert /RESET and DRV_DISABLE within 50 ms after the first missed answer of a sequence of three (RT-12).\",\"version\":\"1.0\"},\"rq-spec-u4-03\":{\"id\":\"rq-spec-u4-03\",\"kind\":\"requirement\",\"name\":\"D04 link integrity\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-03\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The D04 link shall use a sequence counter and CRC8 (SAE J1850, 0x1D, init 0xFF) per transaction; three consecutive errors shall reset U1 and disable the drivers.\",\"version\":\"1.0\"},\"rq-spec-u4-04\":{\"id\":\"rq-spec-u4-04\",\"kind\":\"requirement\",\"name\":\"Input debounce\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-04\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U4 shall report KL.15, KL.50, block start and block stop debounced with 30 ms (KL) and 50 ms (buttons) (TBV whether U4 or U1 debounces).\",\"version\":\"1.0\"},\"rq-spec-u4-05\":{\"id\":\"rq-spec-u4-05\",\"kind\":\"requirement\",\"name\":\"Starter permission\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-05\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"The starter shall switch only if both the U1 command and the U4 permission are present.\",\"version\":\"1.0\"},\"rq-spec-u4-06\":{\"id\":\"rq-spec-u4-06\",\"kind\":\"requirement\",\"name\":\"Independent clock\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-06\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U4 shall be independent of U1's clock (own 4 MHz) so that a U1 clock failure is detected as missing answers.\",\"version\":\"1.0\"},\"rq-spec-u4-07\":{\"id\":\"rq-spec-u4-07\",\"kind\":\"requirement\",\"name\":\"Version readable\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"high\",\"requirementId\":\"SPEC-U4-07\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"U4 firmware or logic version shall be readable by U1 (CMD 0x4) and reported over diagnostics, together with the U3 version (PROPOSED).\",\"version\":\"1.0\"},\"rq-spec-u4-08\":{\"id\":\"rq-spec-u4-08\",\"kind\":\"requirement\",\"name\":\"Measure the real U4 interface\",\"namespace\":[],\"ownerId\":\"rq-hw-dev-00\",\"priority\":\"critical\",\"requirementId\":\"SPEC-U4-08\",\"risk\":\"low\",\"source\":\"MR-PLD U1-U4 Memory and CAN Specification\",\"status\":\"draft\",\"text\":\"Before any U4-dependent software is frozen, the real 845AW pin-out, link type, framing and window timing shall be measured on a powered board (S-03).\",\"version\":\"1.0\"},\"rq-sw-arc-00\":{\"id\":\"rq-sw-arc-00\",\"kind\":\"requirement\",\"name\":\"Architecture rules and resources\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-ARC-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Architecture rules, task schedule and resource budget of the MCM software (SWRS §12, §14.2).\",\"version\":\"1.0\"},\"rq-sw-can-00\":{\"id\":\"rq-sw-can-00\",\"kind\":\"requirement\",\"name\":\"CAN messages (IES-CAN)\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-CAN-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Messages, signals, cycle times, timeouts and reception supervision on the IES-CAN between the CPC (FR) and the MCM (SWRS §7).\",\"version\":\"1.0\"},\"rq-sw-dtc-00\":{\"id\":\"rq-sw-dtc-00\",\"kind\":\"requirement\",\"name\":\"Diagnostic trouble codes\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-DTC-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Every fault the MCM stores, with MR code, J1939 SPN / FMI, severity, detection and reaction (SWRS §9).\",\"version\":\"1.0\"},\"rq-sw-kwp-00\":{\"id\":\"rq-sw-kwp-00\",\"kind\":\"requirement\",\"name\":\"K-line diagnostic services\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-KWP-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"KWP2000 services of the MCM for the workshop tester (SWRS §8).\",\"version\":\"1.0\"},\"rq-sw-req-00\":{\"id\":\"rq-sw-req-00\",\"kind\":\"requirement\",\"name\":\"MCM software specification\",\"namespace\":[],\"ownerId\":\"pkg-sw-req\",\"priority\":\"critical\",\"requirementId\":\"SW-REQ-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Software of the MCM (MR-PLD engine ECU) on U1 SAK-C167CS-LM: what it shall do, how fast, which messages it exchanges and how it reacts to faults.\",\"version\":\"1.0\"},\"rq-sw-rt-00\":{\"id\":\"rq-sw-rt-00\",\"kind\":\"requirement\",\"name\":\"Response times\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-RT-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"System-level (RT-01 … RT-17) and I/O response times of the MCM software (SWRS §11).\",\"version\":\"1.0\"},\"rq-sw-swr-00\":{\"id\":\"rq-sw-swr-00\",\"kind\":\"requirement\",\"name\":\"Software requirements\",\"namespace\":[],\"ownerId\":\"rq-sw-req-00\",\"priority\":\"critical\",\"requirementId\":\"SW-SWR-00\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Functional, safety, platform and process requirements of the MCM software (SWRS §17).\",\"version\":\"1.0\"},\"rq-swr-brk-01\":{\"id\":\"rq-swr-brk-01\",\"kind\":\"requirement\",\"name\":\"Engine brake\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-BRK-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"With pedal at 0 % and an engine-brake request the SW shall energise PV1 + PV2 and cut injection; on release it shall de-energise both and resume injection.\",\"version\":\"1.0\"},\"rq-swr-com-01\":{\"id\":\"rq-swr-com-01\",\"kind\":\"requirement\",\"name\":\"Torque request loss\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-COM-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Loss of the torque request for 200 ms shall give limp torque (ST_LIMP_DERATE).\",\"version\":\"1.0\"},\"rq-swr-com-02\":{\"id\":\"rq-swr-com-02\",\"kind\":\"requirement\",\"name\":\"Engine data transmission\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-COM-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall send EngineDataFrame (rpm, coolant, oil pressure) and fault records over IES-CAN as in the CAN message catalogue.\",\"version\":\"1.0\"},\"rq-swr-diag-01\":{\"id\":\"rq-swr-diag-01\",\"kind\":\"requirement\",\"name\":\"Analogue channel classification\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-DIAG-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Each analogue channel shall be classified NORMAL, OPEN, SCG, SCB or DRIFT using its valid window, and use its substitute value outside NORMAL.\",\"version\":\"1.0\"},\"rq-swr-diag-02\":{\"id\":\"rq-swr-diag-02\",\"kind\":\"requirement\",\"name\":\"Fault record content\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-DIAG-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Every stored fault shall carry its MR code, J1939 SPN / FMI and severity (CRITICAL, DERATE, WARNING, DRIFT), readable over the K-line.\",\"version\":\"1.0\"},\"rq-swr-immo-01\":{\"id\":\"rq-swr-immo-01\",\"kind\":\"requirement\",\"name\":\"Immobiliser release\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-IMMO-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The starter and injection shall be enabled only after a valid authorisation code matches the 93C86 pairing data, and the starter only below 300 rpm.\",\"version\":\"1.0\"},\"rq-swr-immo-02\":{\"id\":\"rq-swr-immo-02\",\"kind\":\"requirement\",\"name\":\"Block start / stop buttons\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-IMMO-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The block start button shall start only from ST_READY below 300 rpm. The stop button shall stop the running engine.\",\"version\":\"1.0\"},\"rq-swr-immo-03\":{\"id\":\"rq-swr-immo-03\",\"kind\":\"requirement\",\"name\":\"Authenticated pairing write\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-IMMO-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Pairing data shall be written only in an authenticated diagnostic session (0x27 level 2).\",\"version\":\"1.0\"},\"rq-swr-inj-01\":{\"id\":\"rq-swr-inj-01\",\"kind\":\"requirement\",\"name\":\"Firing order\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-INJ-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall issue SOI in firing order 1-4-2-5-3-6 at 120° intervals (V8 order TBV).\",\"version\":\"1.0\"},\"rq-swr-inj-02\":{\"id\":\"rq-swr-inj-02\",\"kind\":\"requirement\",\"name\":\"SOI accuracy\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-INJ-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"SOI timing shall be accurate to ± 0.1° crank over 0–2300 rpm (RT-01).\",\"version\":\"1.0\"},\"rq-swr-inj-03\":{\"id\":\"rq-swr-inj-03\",\"kind\":\"requirement\",\"name\":\"Injection enable guard\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-INJ-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall issue SOI only when injEnable = 1 and driversTristated = 0.\",\"version\":\"1.0\"},\"rq-swr-inj-04\":{\"id\":\"rq-swr-inj-04\",\"kind\":\"requirement\",\"name\":\"Cylinder cut-off after a coil fault\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-INJ-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"After an overcurrent trip or open coil the SW shall keep the cylinder cut off, store DTC 51xx–53xx (bank 1) or 54xx–56xx (bank 2) and enter ST_LIMP_DERATE.\",\"version\":\"1.0\"},\"rq-swr-int-02\":{\"id\":\"rq-swr-int-02\",\"kind\":\"requirement\",\"name\":\"Response-time HIL tests\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-INT-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Every response-time item RT-01 to RT-17 shall have an automated HIL test.\",\"version\":\"1.0\"},\"rq-swr-mbd-01\":{\"id\":\"rq-swr-mbd-01\",\"kind\":\"requirement\",\"name\":\"Model-based application\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-MBD-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"All application components shall be developed as Simulink / Stateflow models and implemented by code generation only.\",\"version\":\"1.0\"},\"rq-swr-mbd-03\":{\"id\":\"rq-swr-mbd-03\",\"kind\":\"requirement\",\"name\":\"Model coverage\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-MBD-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"MIL coverage shall be 100 % decision / condition for P1 models and MC/DC for ASIL-rated parts; SIL results shall match MIL within the fixed-point tolerance.\",\"version\":\"1.0\"},\"rq-swr-mbd-04\":{\"id\":\"rq-swr-mbd-04\",\"kind\":\"requirement\",\"name\":\"Generated code contract\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-MBD-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Generated code shall follow the interface contract between generated code and the embedded platform and be MISRA C:2012 compliant.\",\"version\":\"1.0\"},\"rq-swr-mode-01\":{\"id\":\"rq-swr-mode-01\",\"kind\":\"requirement\",\"name\":\"Operating states\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-MODE-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall implement the 9 operating states and 31 transitions of MR_PLD_ECU_OperatingStates with the specified entry and exit actions.\",\"version\":\"1.0\"},\"rq-swr-nvm-01\":{\"id\":\"rq-swr-nvm-01\",\"kind\":\"requirement\",\"name\":\"After-run storage\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-NVM-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"In after-run the SW shall write DTCs and adaptation values to the EEPROM before releasing the power latch.\",\"version\":\"1.0\"},\"rq-swr-nvm-02\":{\"id\":\"rq-swr-nvm-02\",\"kind\":\"requirement\",\"name\":\"Protected EEPROM blocks\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-NVM-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"EEPROM blocks shall be protected by CRC with a redundant copy. A corrupt pairing block shall lock the immobiliser.\",\"version\":\"1.0\"},\"rq-swr-obc-01\":{\"id\":\"rq-swr-obc-01\",\"kind\":\"requirement\",\"name\":\"U1 ↔ U4 link integrity\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-OBC-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The U1 ↔ U4 link (D04) shall use a sequence counter and CRC8; 3 consecutive errors shall reset U1 and disable the drivers.\",\"version\":\"1.0\"},\"rq-swr-obc-02\":{\"id\":\"rq-swr-obc-02\",\"kind\":\"requirement\",\"name\":\"U3 injection gate\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-OBC-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"U3 shall only start an injection when INJ_EN is set by U1 and DRV_DISABLE from U4 is inactive.\",\"version\":\"1.0\"},\"rq-swr-plt-01\":{\"id\":\"rq-swr-plt-01\",\"kind\":\"requirement\",\"name\":\"MCU requirements\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-PLT-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The main MCU shall meet MCU-01 to MCU-16; the Track A / B decision shall be made at a documented gate.\",\"version\":\"1.0\"},\"rq-swr-plt-02\":{\"id\":\"rq-swr-plt-02\",\"kind\":\"requirement\",\"name\":\"MCU-independent application\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-PLT-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Application components shall be MCU-independent; only MCAL and ECU abstraction may change between Track A and Track B.\",\"version\":\"1.0\"},\"rq-swr-qty-01\":{\"id\":\"rq-swr-qty-01\",\"kind\":\"requirement\",\"name\":\"Smoke limit\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-QTY-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Injected quantity shall follow the smoke map and never exceed 185 mg/stroke.\",\"version\":\"1.0\"},\"rq-swr-res-01\":{\"id\":\"rq-swr-res-01\",\"kind\":\"requirement\",\"name\":\"Timing and resources\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-RES-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"All response times (RT-01 … RT-17) and the resource limits of the task schedule shall be met and shown by worst-case timing analysis.\",\"version\":\"1.0\"},\"rq-swr-saf-01\":{\"id\":\"rq-swr-saf-01\",\"kind\":\"requirement\",\"name\":\"Watchdog service\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SAF-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall serve the U4 window watchdog every 10 ms only after all task deadlines have been met.\",\"version\":\"1.0\"},\"rq-swr-saf-02\":{\"id\":\"rq-swr-saf-02\",\"kind\":\"requirement\",\"name\":\"Start-up self-test\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SAF-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"At startup the SW shall check the flash checksum (0x7FF00–7FFFF), RAM and the ADC reference before leaving ST_INIT_IMMO.\",\"version\":\"1.0\"},\"rq-swr-saf-03\":{\"id\":\"rq-swr-saf-03\",\"kind\":\"requirement\",\"name\":\"Torque plausibility\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SAF-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall check torque plausibility: injected quantity against pedal request and limit, with shutdown on persistent disagreement.\",\"version\":\"1.0\"},\"rq-swr-sm-01\":{\"id\":\"rq-swr-sm-01\",\"kind\":\"requirement\",\"name\":\"State machines as modelled\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SM-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Every state machine shall be implemented with the same states, transitions, guards and entry / during / exit actions as the model, with a deterministic transition priority.\",\"version\":\"1.0\"},\"rq-swr-sm-02\":{\"id\":\"rq-swr-sm-02\",\"kind\":\"requirement\",\"name\":\"State visible for diagnostics\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-SM-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Each state machine shall expose its current state for diagnostics (KWP2000 0x21) and calibration measurement.\",\"version\":\"1.0\"},\"rq-swr-sm-03\":{\"id\":\"rq-swr-sm-03\",\"kind\":\"requirement\",\"name\":\"Invalid state detection\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SM-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"State-machine code shall detect an invalid state value (memory corruption) and go to ST_FAULT_SHUTDOWN.\",\"version\":\"1.0\"},\"rq-swr-sync-01\":{\"id\":\"rq-swr-sync-01\",\"kind\":\"requirement\",\"name\":\"Synchronise on CKP and CMP\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SYNC-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall synchronise on the CKP reference slot and the CMP sync tooth, and keep injecting on either one alone.\",\"version\":\"1.0\"},\"rq-swr-sync-02\":{\"id\":\"rq-swr-sync-02\",\"kind\":\"requirement\",\"name\":\"Inhibit injection on total sync loss\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SYNC-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"The SW shall inhibit injection only when both CKP and CMP are invalid (injectionEnabled == ckpValid or cmpValid).\",\"version\":\"1.0\"},\"rq-swr-sync-03\":{\"id\":\"rq-swr-sync-03\",\"kind\":\"requirement\",\"name\":\"CKP loss limp-home\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"critical\",\"requirementId\":\"SWR-SYNC-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"On CKP loss the SW shall time injection from CMP, limit speed to 1800 rpm and torque to 65 %, and report DTC 0110 / 0111 / 0112 over CAN.\",\"version\":\"1.0\"},\"rq-swr-thm-01\":{\"id\":\"rq-swr-thm-01\",\"kind\":\"requirement\",\"name\":\"Thermal fan and derate\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"high\",\"requirementId\":\"SWR-THM-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"PV3 shall run PWM from 92 °C, reaching 100 % at 100 °C. A warning and derate shall apply from 103 °C and a hard derate from 110 °C.\",\"version\":\"1.0\"},\"rq-swr-var-01\":{\"id\":\"rq-swr-var-01\",\"kind\":\"requirement\",\"name\":\"V6 / V8 variant\",\"namespace\":[],\"ownerId\":\"rq-sw-swr-00\",\"priority\":\"medium\",\"requirementId\":\"SWR-VAR-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"One SW build shall serve the V6 and V8 variants, selected by EEPROM coding. Cylinder 7 / 8 outputs shall be active on V8 only.\",\"version\":\"1.0\"},\"rq-ts-01\":{\"id\":\"rq-ts-01\",\"kind\":\"requirement\",\"name\":\"Task schedule\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"TS-01\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"ISR_Trip (highest, 20 µs), ISR_CKP (2, 30 µs, 36 / rev), ISR_CMP (3, 20 µs), ISR_SOI / EOI (4, 15 µs), TASK_Segment every 120° (5, 400 µs), TASK_10ms (6, 1.5 ms), TASK_100ms (7, 3 ms), TASK_1s (8, 5 ms), TASK_Bg (idle: KWP2000, NvM, RAM / ROM checks).\",\"version\":\"1.0\"},\"rq-ts-02\":{\"id\":\"rq-ts-02\",\"kind\":\"requirement\",\"name\":\"CPU load\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"TS-02\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"CPU load at 2300 rpm (8-cylinder worst case) ≤ 70 % average, ≤ 85 % in any 10 ms window (SPEC-SW-01: TASK_100ms offset 5 ms, TASK_1s in ≥ 5 slices ≤ 1 ms).\",\"version\":\"1.0\"},\"rq-ts-03\":{\"id\":\"rq-ts-03\",\"kind\":\"requirement\",\"name\":\"Memory budget\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"high\",\"requirementId\":\"TS-03\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"Program flash 0x04000–0x5FFFF (368 KB) ≤ 80 %, data set 0x60000–0x7FEFF (128 KB) ≤ 80 %, RAM / stack ≥ 25 % free with fill-pattern monitoring, EEPROM 2 KB ≥ 20 % free.\",\"version\":\"1.0\"},\"rq-ts-04\":{\"id\":\"rq-ts-04\",\"kind\":\"requirement\",\"name\":\"Deadline monitoring\",\"namespace\":[],\"ownerId\":\"rq-sw-arc-00\",\"priority\":\"critical\",\"requirementId\":\"TS-04\",\"risk\":\"low\",\"source\":\"D-Motor-ECU-SWRS-001 v3.0\",\"status\":\"draft\",\"text\":\"A deadline monitor shall detect task overrun; an overrun in TASK_10ms or TASK_Segment shall withhold the watchdog answer so U4 reacts (SPEC-SW-03). Every task and ISR shall be measured on target at 2300 rpm, V8 (SPEC-SW-02).\",\"version\":\"1.0\"}},\"revision\":2537,\"schemaVersion\":5,\"subjects\":{},\"usages\":{},\"useCases\":{},\"verificationCases\":{}},\"schemaVersion\":5}","sysmlCoordinates":{},"diagramPresentations":{"adia-default-bdd":{"elementIds":["pkg-8dcd5e03"],"presentations":{"pkg-8dcd5e03":{"id":"presentation:adia-default-bdd:pkg-8dcd5e03","diagramId":"adia-default-bdd","semanticElementId":"pkg-8dcd5e03","bounds":{"x":283,"y":251,"width":220,"height":140}}}},"diag-61206b63":{"elementIds":["blk-5c43d9fb","2a74537e-740c-4dfb-9f54-8e348ff99e57","bf30ba36-c8f4-4406-8078-70b3da
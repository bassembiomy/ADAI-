oltage\",\"namespace\":[],\"ownerId\":\"pkg_AnalysisAndSimulation\",\"parameters\":[{\"id\":\"cb_BoostVoltage.pBar\",\"name\":\"pBar\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_BoostVoltage.v\",\"name\":\"v\",\"typeId\":\"vt_Real\"}]},\"cb_FuelDemand\":{\"constraints\":[\"qReq == 22.0 + 1.6 * pedalPct\"],\"id\":\"cb_FuelDemand\",\"kind\":\"constraintBlock\",\"name\":\"FuelDemand\",\"namespace\":[],\"ownerId\":\"pkg_Parametrics\",\"parameters\":[{\"id\":\"cb_FuelDemand.pedalPct\",\"name\":\"pedalPct\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_FuelDemand.qReq\",\"name\":\"qReq\",\"typeId\":\"vt_Real\"}]},\"cb_InjectedQuantity\":{\"constraints\":[\"q = min(22.0 + 1.6 * pedalPct, 55.0 + 65.0 * (pBoostBar - 1.0)) * torqueLimitPct / 100.0\"],\"id\":\"cb_InjectedQuantity\",\"kind\":\"constraintBlock\",\"name\":\"InjectedQuantity\",\"namespace\":[],\"ownerId\":\"pkg_AnalysisAndSimulation\",\"parameters\":[{\"id\":\"cb_InjectedQuantity.pedalPct\",\"name\":\"pedalPct\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_InjectedQuantity.pBoostBar\",\"name\":\"pBoostBar\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_InjectedQuantity.torqueLimitPct\",\"name\":\"torqueLimitPct\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_InjectedQuantity.q\",\"name\":\"q\",\"typeId\":\"vt_Real\"}]},\"cb_NtcDivider\":{\"constraints\":[\"vPin == vRef * rNtc / (rNtc + rPullUp)\"],\"id\":\"cb_NtcDivider\",\"kind\":\"constraintBlock\",\"name\":\"NtcDivider\",\"namespace\":[],\"ownerId\":\"pkg_Parametrics\",\"parameters\":[{\"id\":\"cb_NtcDivider.rNtc\",\"name\":\"rNtc\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_NtcDivider.rPullUp\",\"name\":\"rPullUp\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_NtcDivider.vRef\",\"name\":\"vRef\",\"typeId\":\"vt_Real\"},{\"id\":\"cb_NtcDivider.vPin\",\"name\":\"vPin\",\"typeId\":\"vt_Real\"}]},\"cb_NtcVoltage\":{\"constraints\":[\"v = 5.00 * tempOhm / (tempOhm + 2490.0)\"],\"id\":\"cb_NtcVoltage\",\"kind\":\"constraintBlock\",\"name\":\"NtcVoltage\",\"namespace\":[],\"ownerId\":\"pkg_AnalysisAndSimulation\",\"parame